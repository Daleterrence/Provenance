<Project>
  <!-- anything older than 10.0.14 lacks the Brotli fix for the mirror packs -->
  <PropertyGroup>
    <MinimumBundledRuntime>10.0.14</MinimumBundledRuntime>
  </PropertyGroup>
  <Target Name="RequirePatchedRuntime" BeforeTargets="Build;Publish">
    <Error Condition="$([System.Version]::Parse('$(BundledNETCoreAppPackageVersion.Split(`-`)[0])').CompareTo($([System.Version]::Parse('$(MinimumBundledRuntime)')))) &lt; 0"
           Text="This SDK ($(NETCoreSdkVersion)) bundles .NET $(BundledNETCoreAppPackageVersion), older than $(MinimumBundledRuntime). Install the current .NET 10 SDK before you build Provenance." />
  </Target>
</Project>
