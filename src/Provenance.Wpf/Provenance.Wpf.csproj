<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- the tray icon only (NotifyIcon, fully qualified) -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFO0003 wants the DPI setting out of app.manifest, but WPF wants it in there -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>Provenance.Wpf</RootNamespace>
    <AssemblyName>Provenance</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(ProvenanceAssetsDir)\app\provenance.ico</ApplicationIcon>
    <Product>Provenance</Product>
    <!-- Program.Main, so Velopack runs before WPF starts -->
    <StartupObject>Provenance.Wpf.Program</StartupObject>
    <!-- native\build-native.ps1 builds these, tools/pack-release.ps1 points this at its own fresh build -->
    <NativeToolsDir Condition="'$(NativeToolsDir)' == ''">..\..\native\bin</NativeToolsDir>
  </PropertyGroup>

  <Import Project="ReadyToRun.props" />

  <!-- so WinForms names never clash with WPF's (Application, MessageBox...) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- the images keep their /Assets/ pack paths, the installer's zone pictures go next to the exe -->
  <ItemGroup>
    <Resource Include="$(ProvenanceAssetsDir)\app\provenance.ico" Link="Assets\provenance.ico" />
    <Resource Include="$(ProvenanceAssetsDir)\app\provenance-256.png" Link="Assets\provenance-256.png" />
    <Resource Include="$(ProvenanceAssetsDir)\app\bg-logo.png" Link="Assets\bg-logo.png" />
    <Resource Include="$(ProvenanceAssetsDir)\app\no-image.jpg" Link="Assets\no-image.jpg" />
    <Resource Include="$(ProvenanceAssetsDir)\app\icons\*.svg" Link="Assets\icons\%(Filename)%(Extension)" />
    <None Include="$(ProvenanceAssetsDir)\installer\zones\*.jpg" Link="zones\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="..\Provenance.Launcher\CloseRequestName.cs" Link="Services\CloseRequestName.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MaterialDesignThemes" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="SharpVectors.Wpf" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Provenance.Common\Provenance.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="provenance-wpf-tests" />
    <InternalsVisibleTo Include="provenance-screens" />
  </ItemGroup>

  <!-- Provenance Watcher.exe injects pol_hook.dll, the app hands it the copy in native\ -->
  <ItemGroup>
    <NativeFile Include="$(NativeToolsDir)\pol_hook.dll" />
    <NativeFile Include="$(NativeToolsDir)\Provenance Watcher.exe" />
    <NativeFile Include="$(NativeToolsDir)\Provenance - PlayOnline Uninstall.exe" />
    <NativeFile Include="$(NativeToolsDir)\Provenance - FINAL FANTASY XI Uninstall.exe" />
    <None Include="@(NativeFile)" Link="native\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RequireAssets" BeforeTargets="BeforeBuild">
    <Error Condition="'$(ProvenanceAssetsDir)' == '' or !Exists('$(ProvenanceAssetsDir)\app\provenance.ico')"
           Text="Provenance's images aren't in this repo. Put the assets folder next to the repo, or set PROVENANCE_ASSETS to where it is." />
  </Target>

  <Target Name="RequireNatives" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <MissingNativeFile Include="@(NativeFile)" Condition="!Exists('%(NativeFile.FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(MissingNativeFile)' != ''"
           Text="Missing from $([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(NativeToolsDir)')): @(MissingNativeFile->'%(Filename)%(Extension)', ', '). Run native\build-native.ps1 first to build them." />
  </Target>

</Project>
