<Project>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- crossgen'd SharpVectors throws EntryPointNotFoundException from its own interface calls once warmed up (x86, .NET 10), so icons come out blank -->
  <ItemGroup>
    <PublishReadyToRunExclude Include="SharpVectors.Converters.Wpf.dll;SharpVectors.Core.dll;SharpVectors.Css.dll;SharpVectors.Dom.dll" />
    <PublishReadyToRunExclude Include="SharpVectors.Model.dll;SharpVectors.Rendering.Wpf.dll;SharpVectors.Runtime.Wpf.dll" />
  </ItemGroup>
</Project>
