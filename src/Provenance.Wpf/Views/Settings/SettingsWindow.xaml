<controls:AppWindow x:Class="Provenance.Wpf.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:local="clr-namespace:Provenance.Wpf.Views.Settings"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Provenance settings" Icon="/Assets/provenance.ico"
        Width="860" Height="680" MinWidth="800" MinHeight="540" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <!-- labels go beside or above, never a floating hint (it draws a dark chip on this background, and I've lost
             that fight before) -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}" />

        <Style x:Key="NavPage" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        </Style>

        <Style x:Key="ProfileTool" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="TitleCombo" TargetType="ComboBox" BasedOn="{StaticResource OutlinedCombo}">
            <Setter Property="Padding" Value="10,5,6,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <!-- a field pill on the dark title bar, the way POL draws its fields -->
            <Setter Property="Background" Value="{DynamicResource Title.Field}" />
            <Setter Property="Foreground" Value="{DynamicResource Title.FieldText}" />
        </Style>
        <!-- label and optional help (Tag) on the left, the control in a fixed column so they all line up -->
        <Style TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="behaviours:HeaderNames.NamesContent" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="96" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="Text" VerticalAlignment="Center">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.1}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <!-- usually plain text, the odd one with a bold bit is a TextBlock of its own -->
                                <ContentPresenter x:Name="HelpText" Margin="0,2,0,0" Content="{TemplateBinding Tag}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Style="{StaticResource Help}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="HelpText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="40,*">
        <!-- only the switcher's controls take clicks, the rest of the bar still drags the window. The dropdown gives up its
             width before the title does -->
        <controls:TitleBar Title="Settings">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="104" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="4*" MaxWidth="240" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding Hooks.ProfileSwitcherLabel}" FontSize="13" VerticalAlignment="Center" Margin="16,0,10,0"
                           Foreground="{DynamicResource Text.2}" Visibility="{Binding ShowProfileSwitcher, Converter={StaticResource BoolToVis}}" />
                <ComboBox x:Name="ProfileSwitcher" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource TitleCombo}" DisplayMemberPath="Display"
                          ItemsSource="{Binding Hooks.SwitcherProfiles}" SelectedItem="{Binding Hooks.SelectedProfile}"
                          Visibility="{Binding ShowProfileSwitcher, Converter={StaticResource BoolToVis}}"
                          AutomationProperties.Name="{Binding Hooks.ProfileSwitcherName}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,2,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowProfileTools, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding Hooks.AddProfileCommand}" IsEnabled="{Binding Hooks.CanManageProfiles}"
                            ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="{Binding Hooks.ProfileNoun, StringFormat='Add a {0}'}">
                        <controls:SvgIcon Glyph="add" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding Hooks.DuplicateProfileCommand}" IsEnabled="{Binding Hooks.CanCopyProfile}"
                            ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="{Binding Hooks.ProfileNoun, StringFormat='Duplicate this {0}'}">
                        <controls:SvgIcon Glyph="copy" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding Hooks.RenameProfileCommand}" IsEnabled="{Binding Hooks.CanChangeProfile}"
                            ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="{Binding Hooks.ProfileNoun, StringFormat='Rename this {0}'}">
                        <controls:SvgIcon Glyph="edit" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding Hooks.DeleteProfileCommand}" IsEnabled="{Binding Hooks.CanChangeProfile}"
                            ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}"
                            AutomationProperties.Name="{Binding Hooks.ProfileNoun, StringFormat='Delete this {0}'}">
                        <controls:SvgIcon Glyph="delete" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </controls:TitleBar>

        <Grid Grid.Row="1" ColumnDefinitions="210,*">
            <ListBox x:Name="Tabs" Background="{DynamicResource Surface.1}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border.Pane}" ItemContainerStyle="{StaticResource NavPage}"
                     Padding="0,6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <!-- small headings between the groups. They're not items, so Tab and the arrows only ever land on a page -->
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}"
                                           Margin="24,12,10,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.Resources>
                    <DataTemplate DataType="{x:Type local:GlyphIcon}">
                        <controls:SvgIcon Glyph="{Binding Glyph}" Flat="True" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type local:MaterialIcon}">
                        <materialDesign:PackIcon Kind="{Binding Kind}" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    </DataTemplate>
                    <!-- unsnapped, snapping moves the icons half a pixel on a scaled screen -->
                    <DataTemplate DataType="{x:Type local:SettingsPage}">
                        <StackPanel Orientation="Horizontal" SnapsToDevicePixels="False">
                            <ContentPresenter Content="{Binding Icon}" />
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.Resources>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource Bg.Base}">
                <ContentControl x:Name="PageHost" Focusable="False" IsTabStop="False" />
            </Border>
        </Grid>
    </Grid>
</controls:AppWindow>
