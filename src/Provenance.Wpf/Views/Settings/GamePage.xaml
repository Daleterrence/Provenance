<UserControl x:Class="Provenance.Wpf.Views.Settings.GamePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Settings">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,6">
                <Border Style="{StaticResource PlatformCard}" Tag="{Binding Platform}" Margin="0,0,0,12"
                        Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnDefinitions="Auto,*">
                        <controls:SvgIcon Glyph="plugin" Flat="True" Width="22" Height="22" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding ProfileHeading}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProfileShown}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource WarnText}" Text="{Binding ReadOnlyNote}" Margin="0,0,0,12"
                           Visibility="{Binding ReadOnlyNote, Converter={StaticResource NullToVisibilityConverter}}" />
                <TextBlock Style="{StaticResource IntroText}" Margin="0,0,0,16"
                           Text="{Binding IntroText}" />

                <!-- only the cards need the game's saved settings, a broken install may have none -->
                <TextBlock Text="Display" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                    <StackPanel>
                        <HeaderedContentControl Header="Resolution">
                            <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Window mode">
                            <ComboBox ItemsSource="{Binding WindowModes}" SelectedIndex="{Binding WindowModeIndex}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="UI size" Tag="Higher values make the menus bigger.">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,46">
                                    <Slider Minimum="1" Maximum="{Binding UiScaleMax}" Value="{Binding UiScale}"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25"
                                            VerticalAlignment="Center" AutomationProperties.Name="UI size" />
                                    <TextBlock Grid.Column="1" Text="{Binding UiScaleText}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                                </Grid>
                                <TextBlock Text="{Binding UiSizeText}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                            </StackPanel>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Brightness">
                            <Grid ColumnDefinitions="*,46">
                                <Slider Minimum="-1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                        Value="{Binding Brightness}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BrightnessText}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                            </Grid>
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Graphics" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                    <StackPanel>
                        <HeaderedContentControl Header="3D resolution" Tag="{x:Static vm:GameSettingsViewModel.RenderSizeText}">
                            <ComboBox ItemsSource="{Binding RenderSizes}" SelectedItem="{Binding RenderSize}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Textures" Tag="This only changes the quality of light flares and clouds.">
                            <ComboBox ItemsSource="{Binding Quality3}" SelectedIndex="{Binding Textures}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Fonts">
                            <ComboBox ItemsSource="{Binding Quality3}" SelectedIndex="{Binding Fonts}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Map quality">
                            <ComboBox ItemsSource="{Binding Quality2}" SelectedIndex="{Binding Maps2D}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Vegetation movement">
                            <ComboBox ItemsSource="{Binding VegetationLevels}" SelectedIndex="{Binding Vegetation}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Distant textures" Tag="When this is on, distant objects get full-size textures instead of lower-resolution ones.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DrawDistance}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Enhanced shading">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnhancedShading}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Sound" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                    <StackPanel>
                        <HeaderedContentControl Header="Sound">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Sound}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Simultaneous sound effects" IsEnabled="{Binding Sound}">
                            <Grid ColumnDefinitions="*,46">
                                <Slider Minimum="12" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Value="{Binding SoundEffects}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SoundEffects}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                            </Grid>
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Sound in the background" Tag="When this is on, the sound keeps playing when you switch to another window."
                                                IsEnabled="{Binding Sound}">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BackgroundSound}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Gamepad" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                    <StackPanel>
                        <HeaderedContentControl Header="Gamepad">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadEnabled}" />
                        </HeaderedContentControl>
                        <StackPanel Margin="20,0,0,0" IsEnabled="{Binding PadEnabled}">
                            <HeaderedContentControl Header="Force feedback">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadForceFeedback}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Analogue sliders">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadSlider}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Hat switches">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadHat}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Gamepad in the background" Tag="When this is on, the gamepad keeps working when you switch to another window.">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadBackground}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="XInput controller" Tag="Turn this on if you use an Xbox controller, or one that works like it.">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadXInput}" />
                            </HeaderedContentControl>
                        </StackPanel>
                        <HeaderedContentControl Header="Buttons" Tag="This opens the FINAL FANTASY XI gamepad tool, where you can choose what each button does.">
                            <Button Content="SET UP BUTTONS" Style="{StaticResource PolButton}" FontSize="12"
                                    Command="{Binding OpenPadConfigCommand}" />
                        </HeaderedContentControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="Screenshots" Style="{StaticResource Section}" />
                <!-- the card isn't switched off with the page, Open folder only opens Explorer -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <HeaderedContentControl Header="Full-size screenshots" Tag="When this is on, your screenshots are saved at your screen's resolution."
                                                IsEnabled="{Binding Editable}">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FullResScreenshots}" />
                        </HeaderedContentControl>
                        <StackPanel Margin="0,8,0,10">
                            <StackPanel Style="{StaticResource DimWhenOff}" IsEnabled="{Binding Editable}">
                                <TextBlock Text="Screenshots and settings folder" FontSize="13" Foreground="{DynamicResource Text.1}" />
                                <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                           Text="The game saves your screenshots and some of its settings in this folder." />
                                <Border Height="8" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Text="{Binding ScreenshotFolder}" Style="{StaticResource FieldText}" IsEnabled="{Binding Editable}"
                                         materialDesign:HintAssist.Hint="Documents\My Games\FINAL FANTASY XI" AutomationProperties.Name="Screenshots and settings folder" />
                                <Button Style="{StaticResource BrowseButton}" IsEnabled="{Binding Editable}"
                                        Command="{Binding BrowseScreenshotsCommand}" />
                                <Button Grid.Column="2" Margin="6,0,0,0" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                        DataContext="{Binding OpenScreenshotFolder}" Command="{Binding OpenCommand}" ToolTip="Open folder" AutomationProperties.Name="Open folder">
                                    <controls:SvgIcon Glyph="folder" Width="20" Height="20" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Other" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                    <StackPanel>
                        <HeaderedContentControl Header="Opening movie" Tag="When this is on, the game plays its opening movie each time it starts.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding OpeningMovie}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Hardware mouse cursor">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding HardwareMouse}" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Legacy settings" Tag="Turn this on to change Simple character creation and Graphics card fix. Turning it off clears them.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LegacySettings}" />
                        </HeaderedContentControl>
                        <StackPanel Margin="20,0,0,0">
                            <HeaderedContentControl Header="Simple character creation" IsEnabled="{Binding LegacySettings}" Tag="When this is on, character creation shows still pictures instead of 3D models.">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SimpleCharSelect}" />
                            </HeaderedContentControl>
                            <HeaderedContentControl Header="Graphics card fix" IsEnabled="{Binding LegacySettings}" Tag="This setting is also called Graphics Stabilization. It can help the game run properly on some graphics cards.">
                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GraphicsFix}" />
                            </HeaderedContentControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Connection" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="This applies straight away, to every profile." Style="{StaticResource Help}" Margin="0,10,0,2" />
                        <HeaderedContentControl Header="Auto-disconnect"
                                                Tag="After your set time period, you will automatically disconnect from FINAL FANTASY XI.">
                            <ComboBox ItemsSource="{Binding AutoDisconnectChoices}" SelectedIndex="{Binding AutoDisconnectIndex}"
                                      AutomationProperties.Name="Auto-disconnect" />
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding PolOptionsStatus}" behaviours:State.IsError="True" Style="{StaticResource ProfileStatusText}" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Memory" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Card}" DataContext="{Binding Settings}">
                    <StackPanel>
                        <TextBlock Text="This applies straight away, to every profile." Style="{StaticResource Help}" Margin="0,10,0,2" />
                        <HeaderedContentControl Header="Large Address Aware" IsEnabled="{Binding LargeAddressAwareEnabled}"
                                                Tag="When this is on, the game can use up to 4&#160;GB of memory instead of 2&#160;GB, which helps with HD texture mods.">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LargeAddressAwareOn}"
                                          AutomationProperties.Name="Large Address Aware" />
                        </HeaderedContentControl>
                        <TextBlock Text="{Binding LargeAddressAwareStatus}"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                    <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- padded like the page above it, the right side with the page's scrollbar (17) added -->
        <Border Grid.Row="1" Style="{StaticResource FooterBar}" Padding="28,10,45,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Status.Text}" behaviours:State.IsError="{Binding Status.IsError}"
                           Style="{StaticResource StatusText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="REVERT" MinWidth="100" Style="{StaticResource PolButton}" Command="{Binding RevertCommand}" IsEnabled="{Binding Editable}" />
                    <Button Content="SAVE" MinWidth="100" Margin="{StaticResource Footer.Gap}" Style="{StaticResource PolButton}"
                            Command="{Binding SaveCommand}" IsEnabled="{Binding Editable}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
