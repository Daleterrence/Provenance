<UserControl x:Class="Provenance.Wpf.Views.Settings.HandlesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:services="clr-namespace:Provenance.Wpf.Services">
    <UserControl.Resources>
        <DataTemplate x:Key="HandleCharacter">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" MinHeight="32">
                <Ellipse Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{x:Static services:SvgIcons.XiBadgeRound}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding ShowMoves, Converter={StaticResource BoolToVis}}">
                    <Button Width="30" Height="30" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                            IsEnabled="{Binding CanMoveUp}" ToolTip="Move up"
                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat=Move {0} up}">
                        <controls:SvgIcon Glyph="up" Width="20" Height="20" />
                    </Button>
                    <Button Width="30" Height="30" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                            IsEnabled="{Binding CanMoveDown}" ToolTip="Move down"
                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Label, StringFormat=Move {0} down}">
                        <controls:SvgIcon Glyph="down" Width="20" Height="20" />
                    </Button>
                </StackPanel>
                <Button Grid.Column="3" Content="LINK TO..." FontSize="12" Height="30" Padding="10,0" Margin="8,0,0,0"
                        Style="{StaticResource PolButton}" IsEnabled="{Binding CanLink}" Click="OnLinkCharacter"
                        AutomationProperties.Name="{Binding Label, StringFormat=Link {0} to a handle}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,22">
            <TextBlock Text="Handles" Style="{StaticResource Section}" />
            <TextBlock Style="{StaticResource IntroText}" Text="{Binding LoggedOutText}"
                       Visibility="{Binding LoggedIn, Converter={StaticResource InvertBoolToVis}}" />
            <StackPanel Visibility="{Binding LoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource WarnText}" Text="{Binding ReadOnlyText}" Margin="0,0,0,12"
                           Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Note.Text}" behaviours:State.IsError="{Binding Note.IsError}" Style="{StaticResource ProfileStatusText}" />
                <Border Style="{StaticResource Card}" Padding="16,10" Margin="0,0,0,12"
                        Visibility="{Binding Ordering, Converter={StaticResource BoolToVis}}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Text="{Binding OrderChangedText}" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" Content="CANCEL" FontSize="12" Margin="8,0,0,0" Style="{StaticResource RedButton}"
                                Command="{Binding CancelOrderCommand}" />
                        <Button Grid.Column="2" Content="SAVE ORDER" FontSize="12" Margin="4,0,0,0" Style="{StaticResource PolButton}"
                                Command="{Binding SaveOrderCommand}" />
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <controls:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                       Source="{Binding Picture}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                                                    Background="{DynamicResource Primary.Muted}"
                                                    Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="SWITCH" FontSize="12" VerticalAlignment="Center"
                                                Style="{StaticResource PolButton}" IsEnabled="{Binding CanSwitch}"
                                                Command="{Binding DataContext.SwitchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Make {0} your active handle}" />
                                        <Button Grid.Column="3" Content="DELETE" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"
                                                Style="{StaticResource PolButton}" IsEnabled="{Binding CanDelete}"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding DataContext.NoCharactersText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                               Style="{StaticResource Help}" Margin="52,8,0,0"
                                               Visibility="{Binding NoCharacters, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Characters}" Focusable="False" Margin="52,6,0,0"
                                                  ItemTemplate="{StaticResource HandleCharacter}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="CREATE NEW HANDLE" FontSize="12" HorizontalAlignment="Left" Margin="0,0,0,12"
                        Style="{StaticResource PolButton}" IsEnabled="{Binding CanCreate}" Command="{Binding CreateCommand}"
                        AutomationProperties.Name="Create a new handle" />
                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                        Visibility="{Binding HasUnlinked, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Unlinked" FontSize="15" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding Unlinked}" Focusable="False" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource HandleCharacter}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding AutoSwitchText}" Style="{StaticResource Help}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
