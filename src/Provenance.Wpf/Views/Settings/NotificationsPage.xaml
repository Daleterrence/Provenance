<UserControl x:Class="Provenance.Wpf.Views.Settings.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,22">
            <TextBlock Text="Notifications" Style="{StaticResource Section}" />
            <TextBlock Style="{StaticResource IntroText}" Margin="0,0,0,14"
                       Text="Choose which notices Provenance shows, and which ones flash its taskbar button." />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,6,0,0" ColumnDefinitions="*,80,80">
                        <TextBlock Grid.Column="1" Text="Notice" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Flash" Style="{StaticResource Label}" HorizontalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="48" Margin="0,2" ColumnDefinitions="*,80,80">
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.1}" />
                                        <TextBlock Text="{Binding Help}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" HorizontalAlignment="Center" IsChecked="{Binding Shows}"
                                                  AutomationProperties.Name="{Binding ShowsName}" />
                                    <ToggleButton Grid.Column="2" Style="{StaticResource Switch}" HorizontalAlignment="Center" IsChecked="{Binding Flashes}"
                                                  Visibility="{Binding HasFlash, Converter={StaticResource BoolToVis}}"
                                                  AutomationProperties.Name="{Binding FlashesName}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="In the game" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Message sound"
                                            Tag="Uses the game's own sound and settings.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GameSound}" AutomationProperties.Name="Message sound in the game" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Friends online and offline"
                                            Tag="Shown as a line in the chat log.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GameFriendLines}" AutomationProperties.Name="Friend online and offline lines in the game" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Friends playing FINAL FANTASY XI"
                                            Tag="A chat log line when they start or stop.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GamePlayingLines}" AutomationProperties.Name="Friend playing lines in the game" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
