<UserControl x:Class="Provenance.Wpf.Views.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,22">
            <TextBlock Text="Installation" Style="{StaticResource Section}" />
            <TextBlock Text="Region" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding RegionText}" Margin="0,0,0,10" />
            <TextBlock Text="PlayOnline Viewer folder" Style="{StaticResource Label}" />
            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ViewerFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Margin="8,0,0,0" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                        DataContext="{Binding OpenViewerFolder}" Command="{Binding OpenCommand}" ToolTip="Open folder" AutomationProperties.Name="Open the PlayOnline Viewer folder">
                    <controls:SvgIcon Glyph="folder" Width="20" Height="20" />
                </Button>
            </Grid>
            <TextBlock Text="FINAL FANTASY XI folder" Style="{StaticResource Label}" />
            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding FfxiFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Margin="8,0,0,0" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                        DataContext="{Binding OpenFfxiFolder}" Command="{Binding OpenCommand}" ToolTip="Open folder" AutomationProperties.Name="Open the FINAL FANTASY XI folder">
                    <controls:SvgIcon Glyph="folder" Width="20" Height="20" />
                </Button>
            </Grid>
            <HeaderedContentControl Header="News region" Margin="0,4,0,22" Tag="This is the PlayOnline site the news and server status come from.">
                <ComboBox ItemsSource="{Binding FeedRegionChoices}" SelectedIndex="{Binding FeedRegionIndex}" AutomationProperties.Name="News region" />
            </HeaderedContentControl>

            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <!-- the tiles split the row between them, and the margin on the end of the last one is taken back off the list -->
                    <ItemsControl x:Name="ThemeTiles" ItemsSource="{Binding ThemeTiles}" Focusable="False" IsTabStop="False" Margin="0,8,-12,10"
                                  KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Theme">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource ThemeTile}" GroupName="SettingsTheme" Tag="{Binding Image}" ToolTip="{Binding Title}"
                                             IsChecked="{Binding Picked, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HeaderedContentControl Header="Show timestamps" Tag="Shows the time next to messages, group chat lines and chat room lines.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ShowTimestamps}"
                                      AutomationProperties.Name="Show timestamps" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Text="App Behaviour" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Chat language filter"
                                            Tag="When this is on, offensive words are hidden in messages, comments and profiles from other PlayOnline members, and in FINAL FANTASY XI.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ChatLanguageFilter}"
                                      AutomationProperties.Name="Chat language filter" />
                    </HeaderedContentControl>
                    <TextBlock Text="{Binding PolOptionsStatus}" behaviours:State.IsError="True" Style="{StaticResource ProfileStatusText}" />
                    <HeaderedContentControl Header="Close Provenance when the game exits"
                                            Tag="On, closing FINAL FANTASY XI closes Provenance too. Off, Provenance comes back when the game closes, logged out.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ExitAfterGameExits}"
                                      AutomationProperties.Name="Close Provenance when the game exits" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Minimise to the tray"
                                            Tag="The minimise button hides Provenance in the tray, next to the clock, instead of on the taskbar. Provenance goes to the tray by itself when FINAL FANTASY XI starts, regardless of this setting.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}"
                                      AutomationProperties.Name="Minimise to the tray" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Keep me logged in to PlayOnline in the tray when I close the window"
                                            Tag="Your friends and messages stay up to date, and you won't need to log in again when you open Provenance. To log out, right-click the tray icon.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding KeepSignedInInTray}"
                                      AutomationProperties.Name="Keep me logged in to PlayOnline in the tray when I close the window" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding VersionText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
