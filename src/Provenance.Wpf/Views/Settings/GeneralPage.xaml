<UserControl x:Class="Provenance.Wpf.Views.Settings.GeneralPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,22">
            <TextBlock Text="Installation" Style="{StaticResource Section}" />
            <TextBlock Text="Region" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding RegionText}" Margin="0,0,0,10" />
            <TextBlock Text="PlayOnline Viewer folder" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding ViewerFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" Margin="0,0,0,10" />
            <TextBlock Text="FINAL FANTASY XI folder" Style="{StaticResource Label}" />
            <TextBlock Text="{Binding FfxiFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" Margin="0,0,0,18" />

            <TextBlock Text="Game memory" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Large Address Aware" IsEnabled="{Binding LargeAddressAwareEnabled}"
                                            Tag="When this is on, the game can use up to 4&#160;GB of memory instead of 2&#160;GB, which helps with HD texture mods. Provenance applies it every time the game starts, and it's the same setting as Windower's Large Address Aware.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LargeAddressAwareOn}"
                                      AutomationProperties.Name="Large Address Aware" />
                    </HeaderedContentControl>
                    <TextBlock Text="{Binding LargeAddressAwareStatus}"
                               TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                <Setter Property="Visibility" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Global settings" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Chat language filter"
                                            Tag="When this is on, offensive words are hidden in messages, comments and profiles from other PlayOnline members, and in FINAL FANTASY XI.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ChatLanguageFilter}"
                                      AutomationProperties.Name="Chat language filter" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Auto-disconnect"
                                            Tag="PlayOnline disconnects you after you've been idle this long in FINAL FANTASY XI.">
                        <ComboBox ItemsSource="{Binding AutoDisconnectChoices}" SelectedIndex="{Binding AutoDisconnectIndex}"
                                  AutomationProperties.Name="Auto-disconnect" />
                    </HeaderedContentControl>
                    <TextBlock Text="{Binding PolOptionsStatus}" behaviours:State.IsError="True" Style="{StaticResource ProfileStatusText}" />
                </StackPanel>
            </Border>

            <TextBlock Text="Backups" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" DataContext="{Binding Backups}">
                <StackPanel>
                    <HeaderedContentControl Header="Automatic backups"
                                            Tag="When this is on, Provenance backs up your characters' in-game settings and macros before the game starts, if they've changed. It keeps the newest 5.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BackupGameSettings}"
                                      AutomationProperties.Name="Automatic backups" />
                    </HeaderedContentControl>
                    <StackPanel Margin="0,8,0,10">
                        <TextBlock Text="Backups folder" FontSize="13" Foreground="{DynamicResource Text.1}" />
                        <Border Height="8" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=LostFocus}"
                                     materialDesign:HintAssist.Hint="%APPDATA%\Provenance\Backups" AutomationProperties.Name="Backups folder">
                                <TextBox.Style>
                                    <!-- the full default path, only while the box is empty and it's the one in use -->
                                    <Style TargetType="TextBox" BasedOn="{StaticResource FieldText}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="ToolTip" Value="{Binding DefaultBackupFolder}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Style="{StaticResource BrowseButton}"
                                    Command="{Binding BrowseBackupFolderCommand}" />
                            <Button Grid.Column="2" Margin="6,0,0,0" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                    Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                    Command="{Binding OpenBackupFolderCommand}" ToolTip="Open folder" AutomationProperties.Name="Open folder">
                                <controls:SvgIcon Glyph="folder" Width="20" Height="20" />
                            </Button>
                        </Grid>
                        <TextBlock Text="{Binding BackupStatus.Text}" behaviours:State.IsError="{Binding BackupStatus.IsError}" Style="{StaticResource ProfileStatusText}" Margin="0,8,0,0" />
                    </StackPanel>
                    <HeaderedContentControl Header="Restore a backup" Tag="Puts your game settings back from one of your backups.">
                        <Button Content="RESTORE" Style="{StaticResource PolButton}" FontSize="12"
                                Command="{Binding RestoreBackupCommand}" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <HeaderedContentControl Header="Theme">
                    <ComboBox ItemsSource="{Binding ThemeChoices}" SelectedIndex="{Binding ThemeIndex}" AutomationProperties.Name="Theme" />
                </HeaderedContentControl>
            </Border>

            <TextBlock Text="News and status" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <HeaderedContentControl Header="News region" Tag="This is the PlayOnline site the news and server status come from.">
                    <ComboBox ItemsSource="{Binding FeedRegionChoices}" SelectedIndex="{Binding FeedRegionIndex}" AutomationProperties.Name="News region" />
                </HeaderedContentControl>
            </Border>

            <TextBlock Text="Behaviour" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Close Provenance when the game exits"
                                            Tag="On, closing FINAL FANTASY XI closes Provenance too. Off, Provenance comes back when the game closes, logged out. Logins that use &quot;Start Game Automatically&quot; always close Provenance with the game. If the main window had to open first (for a game update or a PlayOnline notice, for example), this setting applies instead.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ExitAfterGameExits}"
                                      AutomationProperties.Name="Close Provenance when the game exits" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Minimise to the tray"
                                            Tag="The minimise button hides Provenance in the tray, next to the clock, instead of on the taskbar. Provenance goes to the tray by itself when FINAL FANTASY XI starts, whatever this is set to.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding MinimizeToTray}"
                                      AutomationProperties.Name="Minimise to the tray" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Keep me logged in to PlayOnline in the tray when I close the window"
                                            Tag="Your friends and messages stay up to date, and you won't need to log in again when you open Provenance. To log out, right-click the tray icon.">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding KeepSignedInInTray}"
                                      AutomationProperties.Name="Keep me logged in to PlayOnline in the tray when I close the window" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Tell me when a friend comes online">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding NotifyFriendsOnline}"
                                      AutomationProperties.Name="Tell me when a friend comes online" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Text="Group chat" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <HeaderedContentControl Header="Show a notice for new lines when the group chat isn't in front">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GroupChatNotice}"
                                      AutomationProperties.Name="Show a notice for new lines when the group chat isn't in front" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Flash the taskbar for new lines when the group chat isn't in front">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GroupChatFlash}"
                                      AutomationProperties.Name="Flash the taskbar for new lines when the group chat isn't in front" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Show the time on each group chat line">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GroupChatTimes}"
                                      AutomationProperties.Name="Show the time on each group chat line" />
                    </HeaderedContentControl>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding VersionText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
