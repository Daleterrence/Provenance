<UserControl x:Class="Provenance.Wpf.Views.Settings.MultiAccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        <StackPanel Margin="28,22">
            <TextBlock Text="Multi-account mode" Style="{StaticResource Section}" />
            <TextBlock Style="{StaticResource IntroText}" Margin="0,0,0,8"
                       Text="Press Start all accounts on the main window to log in to each account you turn on here and start FINAL FANTASY XI for it, one after another, in this order." />
            <TextBlock Style="{StaticResource Help}" Margin="0,0,0,14"
                       Text="Each account starts once the one before it is in the game. If an account uses a one-time password, Provenance asks for it when that account's turn comes." />
            <TextBlock Style="{StaticResource WarnText}" Margin="0,0,0,12"
                       Text="You must use either Windower or Ashita with Provenance to use multi-account login."
                       Visibility="{Binding MultiHasThirdPartyHook, Converter={StaticResource InvertBoolToVis}}" />
            <TextBlock Style="{StaticResource WarnText}" Margin="0,0,0,12"
                       Text="Provenance is starting your accounts. You can change these settings once it's finished."
                       Visibility="{Binding MultiRunGoing, Converter={StaticResource BoolToVis}}" />
            <StackPanel IsEnabled="{Binding MultiEditable}" Style="{StaticResource DimWhenOff}">
                <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding MultiContinueOnError}" Margin="0,0,0,4">
                    <TextBlock Text="Continue multi-account process on error" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Style="{StaticResource Help}" Margin="26,0,0,10"
                           Text="If one of the accounts fails to log in due to an incorrect password, no subscription, or other problem, carry on logging in the other accounts. Disabling this option will make Provenance stop if there's an error logging in to an account. Some problems, like a failed game update, always stop the run." />
                <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding MultiCloseWhenFinished}" Margin="0,0,0,4">
                    <TextBlock Text="Close Provenance when finished" TextWrapping="Wrap" />
                </CheckBox>
                <TextBlock Style="{StaticResource Help}" Margin="26,0,0,14"
                           Text="This will exit Provenance when all of your accounts are successfully logged in. If there is an error logging any account in, it will always stay open to tell you what went wrong and let you try again." />
                <TextBlock Text="You haven't added any accounts yet. Add one on the main window."
                           Style="{StaticResource ShowWhenZero}" behaviours:State.Count="{Binding MultiAccountRows.Count}" />
                <ItemsControl ItemsSource="{Binding MultiAccountRows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.1}"
                                    BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Problem, StringFormat=Turned off: {0}}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource State.Warn}"
                                                   Visibility="{Binding Problem, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding ProfileNeeded}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource State.Warn}"
                                                   Visibility="{Binding ProfileNeeded, Converter={StaticResource NullToVisibilityConverter}}" />
                                        <TextBlock Text="Edit this account's login details to turn it on again." FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource State.Warn}"
                                                   Visibility="{Binding CredentialsRefused, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Width="200" Margin="0" Padding="10,6"
                                              ItemsSource="{Binding DataContext.MultiProfileChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              SelectedItem="{Binding ThirdPartyHookProfile}" IsEnabled="{Binding Enabled}"
                                              ToolTip="{Binding DataContext.MultiProfileLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              Visibility="{Binding DataContext.MultiHasThirdPartyHook, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <Button Width="32" Height="32" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                                Command="{Binding DataContext.MoveMultiUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Start earlier" AutomationProperties.Name="Start earlier">
                                            <controls:SvgIcon Glyph="up" Width="20" Height="20" />
                                        </Button>
                                        <Button Width="32" Height="32" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                                Command="{Binding DataContext.MoveMultiDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" ToolTip="Start later" AutomationProperties.Name="Start later">
                                            <controls:SvgIcon Glyph="down" Width="20" Height="20" />
                                        </Button>
                                    </StackPanel>
                                    <CheckBox Grid.Column="3" Margin="8,0,0,0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              IsEnabled="{Binding CredentialsRefused, Converter={StaticResource InvertBool}}"
                                              ToolTip="Start this account when you press Start all accounts"
                                              AutomationProperties.Name="{Binding Name, StringFormat=Start {0} in multi-account mode}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
