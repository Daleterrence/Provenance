<controls:AppWindow x:Class="Provenance.Wpf.Views.Install.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        CloseOnEscape="False"
        Style="{StaticResource DialogCard}">

    <StackPanel Margin="22,20,22,16">
        <Grid ColumnDefinitions="Auto,*">
            <Image Source="/Assets/provenance-256.png" Width="28" Height="28" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="StageText" Grid.Column="1" Text="Checking for Provenance updates..." Margin="12,4,0,0"
                       FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        </Grid>

        <ProgressBar x:Name="Bar" Margin="0,18,0,0" Height="6" Minimum="0" Maximum="100" IsIndeterminate="True"
                     Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}" />

        <TextBlock x:Name="DetailText" Margin="0,8,0,0" MinHeight="36" FontSize="12" Foreground="{DynamicResource Text.3}"
                   TextWrapping="Wrap" />

        <StackPanel x:Name="Choices" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" Visibility="Collapsed">
            <Button x:Name="TryAgainButton" Style="{StaticResource PolButton}" Content="TRY AGAIN" Margin="0,0,8,0" Click="OnTryAgain" IsDefault="True" />
            <Button x:Name="CloseButton" Style="{StaticResource PolButton}" Content="CLOSE" Click="OnClose" />
        </StackPanel>
    </StackPanel>
</controls:AppWindow>
