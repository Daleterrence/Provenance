<Window x:Class="Provenance.Wpf.Views.ProfilePicturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Provenance.Wpf.Views"
        Title="Choose your profile picture" Icon="/Assets/provenance.ico"
        Width="760" Height="560" WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Base}" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*,Auto">
        <Grid Background="{DynamicResource Surface.1}">
            <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Text="Choose your profile picture" />
            <Button HorizontalAlignment="Right" Width="44" Height="40" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCancel" ToolTip="Close" AutomationProperties.Name="Close">
                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <ListBox x:Name="Categories" Background="{DynamicResource Surface.1}" BorderThickness="0"
                     DisplayMemberPath="Name" SelectionChanged="OnCategoryChanged" Padding="0,6" />
            <!-- a list so the arrow keys move between pics, and Enter uses the picked one -->
            <ListBox x:Name="Pics" Grid.Column="1" Padding="12" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnProfilePictureSelected"
                     MouseDoubleClick="OnProfilePictureDoubleClick" KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell" Margin="6" Padding="6" CornerRadius="10" Cursor="Hand" Background="Transparent"
                                BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding Tip}">
                            <local:ProfilePictureCircle Diameter="64" Source="{Binding Image}" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Surface.2}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary.Muted}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Padding="14,10" Background="{DynamicResource Surface.1}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="Chosen" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.2}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCEL" Click="OnCancel" Margin="0,0,8,0" />
                    <Button x:Name="UseButton" Style="{StaticResource AccentRaisedButton}" Content="USE THIS PICTURE"
                            IsEnabled="False" Click="OnUse" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
