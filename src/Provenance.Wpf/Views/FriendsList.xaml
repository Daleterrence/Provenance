<UserControl x:Class="Provenance.Wpf.Views.FriendsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
             xmlns:local="clr-namespace:Provenance.Wpf.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="FriendRow" DataType="{x:Type vm:FriendItem}">
            <Grid Margin="6,4" Background="Transparent" ColumnDefinitions="Auto,*,Auto">
                <local:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                            Source="{Binding Avatar}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                        <TextBlock.ToolTip>
                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Character, Mode=OneWay}" /></TextBlock>
                        </TextBlock.ToolTip>
                        <Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource Text.1}" FontWeight="Medium" /><Run Text="   " /><Run Text="{Binding Character, Mode=OneWay}" Foreground="{DynamicResource Text.3}" FontSize="12" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <local:StatusMark Status="{Binding StatusLabel}" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.3}">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"><Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="{Binding Comment, Mode=OneWay, StringFormat={}   {0}}" /></TextBlock>
                            </TextBlock.ToolTip>
                            <Run Text="{Binding StatusLabel, Mode=OneWay}" Foreground="{DynamicResource Text.2}" /><Run Text="{Binding Comment, Mode=OneWay, StringFormat={}   {0}}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="2" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0" Margin="8,0,0,0"
                        Background="{DynamicResource Primary}" VerticalAlignment="Center"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" ToolTip="New messages">
                    <TextBlock Text="{Binding Unread}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Text.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="List" ItemsSource="{Binding FriendsView}" SelectedItem="{Binding SelectedFriend}"
                 IsSynchronizedWithCurrentItem="False"
                 ItemTemplate="{StaticResource FriendRow}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" ContextMenuOpening="OnContextMenuOpening">
            <ListBox.Style>
                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FriendsUnavailable}" Value="True">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ContextMenu>
                <ContextMenu />
            </ListBox.ContextMenu>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="12,10,0,2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run
                                     Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>

        <StackPanel Margin="16,20" VerticalAlignment="Top"
                    Visibility="{Binding NoFriends, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap"
                       Text="You don't have any friends on this PlayOnline account yet." />
            <Button Margin="0,6,0,0" Padding="0" HorizontalAlignment="Left" Style="{StaticResource AccentFlatButton}"
                    FontSize="12" IsEnabled="{Binding CanEdit}" Click="OnAddFriend"
                    ToolTip="Search PlayOnline and send a friend request" AutomationProperties.Name="Search PlayOnline and send a friend request" Content="ADD A FRIEND" />
        </StackPanel>

        <Border VerticalAlignment="Bottom" Margin="10" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1"
                Visibility="{Binding EditStatusShown, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Value="0"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Visibility="{Binding Saving, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="260" Text="{Binding EditStatus}" />
                <!-- only success notes go by themselves -->
                <Button Width="22" Height="22" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top"
                        Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource Text.3}"
                        Command="{Binding DismissEditNoteCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss"
                        Visibility="{Binding EditNoteShown, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="Close" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Border>

        <Border VerticalAlignment="Center" Margin="16" Padding="16,12" CornerRadius="10"
                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1"
                Visibility="{Binding FriendsUnavailable, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Provenance couldn't get your friend list from PlayOnline." FontSize="13" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
