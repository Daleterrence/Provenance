<Window x:Class="Provenance.Wpf.Views.OtpDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="One-time password" Icon="/Assets/provenance.ico" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        MouseLeftButtonDown="OnDrag">

    <Border Margin="14" CornerRadius="{StaticResource Radius.Dialog}" Background="{DynamicResource Surface.2}"
            BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
        <Border.Effect>
            <DynamicResource ResourceKey="Shadow.Dialog" />
        </Border.Effect>
        <StackPanel Margin="22,20,22,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <materialDesign:PackIcon Kind="KeyVariant" Width="22" Height="22"
                                         Foreground="{DynamicResource Primary}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           Text="Enter your one-time password" />
            </StackPanel>

            <TextBlock FontSize="13" LineHeight="19" Foreground="{DynamicResource Text.2}"
                       TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="Type the 6-digit code from your Square Enix authenticator. It's only used for this login and isn't kept." />

            <StackPanel x:Name="SourcePanel" Visibility="Collapsed" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar x:Name="SourceSpinner" Width="16" Height="16" IsIndeterminate="True" Value="0" VerticalAlignment="Top"
                                 Margin="0,1,8,0" Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock x:Name="SourceText" FontSize="12" TextWrapping="Wrap" MaxWidth="290" Foreground="{DynamicResource Text.2}" />
                </StackPanel>
                <Grid x:Name="MasterPanel" Visibility="Collapsed" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                    <PasswordBox x:Name="MasterBox" Style="{DynamicResource DialogPasswordBox}" Padding="10,6"
                                 materialDesign:HintAssist.Hint="Bitwarden master password" KeyDown="OnMasterKey" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="UNLOCK" Style="{StaticResource PolButton}" Click="OnUnlock" />
                </Grid>
                <Button x:Name="RetryButton" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0"
                        Style="{StaticResource PolButton}" Click="OnRetry" />
            </StackPanel>

            <!-- the six digit boxes get made in code -->
            <UniformGrid x:Name="Digits" Rows="1" Columns="6" HorizontalAlignment="Center"
                         AutomationProperties.Name="One-time password, 6 digits" />

            <TextBlock x:Name="ErrorText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource State.Down}"
                       Visibility="Collapsed" Text="Enter all 6 digits." />
            <TextBlock x:Name="BusyText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Text.2}"
                       Visibility="Collapsed" Text="Checking the code..." />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource PolButton}" Content="PASTE"
                        Margin="0,0,8,0" Click="OnPaste" />
                <Button Style="{StaticResource RedButton}" Content="CANCEL"
                        Margin="0,0,8,0" IsCancel="True" Click="OnCancel" />
                <Button x:Name="OkButton" Content="OK" MinWidth="72" IsDefault="True" Click="OnOk"
                        Style="{StaticResource PolButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
