<Window x:Class="Provenance.Wpf.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        MouseLeftButtonDown="OnDrag">

    <Border Margin="14" CornerRadius="8" Background="{DynamicResource Surface.2}"
            BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="22,20,22,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <materialDesign:PackIcon Kind="PencilOutline" Width="22" Height="22"
                                         Foreground="{DynamicResource Primary}" VerticalAlignment="Center" />
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="340"
                           Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>

            <TextBlock x:Name="PromptText" FontSize="13" LineHeight="19" Foreground="{DynamicResource Text.2}"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <TextBox x:Name="InputBox" Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.IsFloating="False"
                     FontSize="13" Padding="12,8" MinHeight="42" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown" />
            <!-- a password: dots, with the same show button as the account's -->
            <PasswordBox x:Name="SecretBox" Style="{StaticResource DialogRevealPasswordBox}" Visibility="Collapsed"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                         FontSize="13" Padding="12,8" MinHeight="42" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown" />

            <TextBlock x:Name="ErrorText" Margin="2,6,0,0" FontSize="12" Foreground="{DynamicResource State.Down}"
                       TextWrapping="Wrap" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCEL" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                <Button Content="OK" MinWidth="72" IsDefault="True" Click="OnOk"
                        Style="{StaticResource AccentRaisedButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
