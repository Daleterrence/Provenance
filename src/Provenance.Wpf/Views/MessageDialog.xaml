<Window x:Class="Provenance.Wpf.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        MouseLeftButtonDown="OnDrag">

    <Border Margin="14" CornerRadius="8" Background="{DynamicResource Surface.2}"
            BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="22,20,22,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <materialDesign:PackIcon x:Name="KindIcon" Kind="AlertCircleOutline" Width="24" Height="24"
                                         Foreground="{DynamicResource State.Down}" VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" Margin="10,0,0,0" VerticalAlignment="Center"
                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>

            <TextBox x:Name="BodyText" Style="{x:Null}" FontSize="13" TextBlock.LineHeight="19" TextWrapping="Wrap"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0"
                     Foreground="{DynamicResource Text.2}" CaretBrush="Transparent" Cursor="IBeam"
                     SelectionBrush="{DynamicResource Primary}" />

            <StackPanel x:Name="Choices" Margin="0,14,0,0" Visibility="Collapsed">
                <RadioButton x:Name="ChoiceA" GroupName="Choice" IsChecked="True" Margin="0,0,0,8"
                             Foreground="{DynamicResource Text.1}" />
                <RadioButton x:Name="ChoiceB" GroupName="Choice" Foreground="{DynamicResource Text.1}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="LogsButton" Style="{StaticResource MaterialDesignFlatButton}"
                        Content="OPEN LOGS" Margin="0,0,8,0" Click="OnOpenLogs" />
                <Button x:Name="CancelButton" Style="{StaticResource MaterialDesignFlatButton}"
                        Content="CANCEL" Margin="0,0,8,0" Visibility="Collapsed" Click="OnCancel" />
                <Button x:Name="OkButton" Content="OK" MinWidth="72" IsDefault="True" IsCancel="True" Click="OnOk"
                        Style="{StaticResource AccentRaisedButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
