<Window x:Class="Provenance.Wpf.Views.AgreementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PlayOnline Member Agreement" Icon="/Assets/provenance.ico"
        Width="720" Height="620" WindowStyle="None" ResizeMode="CanResize" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=BodyText}"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,*,Auto">
        <Grid Background="{DynamicResource Surface.1}">
            <TextBlock x:Name="TitleText" Margin="14,0" VerticalAlignment="Center" FontSize="14" />
        </Grid>

        <TextBlock x:Name="IntroText" Grid.Row="1" Margin="18,14,18,8" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.2}" />

        <Border Grid.Row="2" Margin="18,0,18,0" CornerRadius="8" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
            <!-- read-only so it can be copied, and it scrolls itself, an outer ScrollViewer fights it for the wheel -->
            <TextBox x:Name="BodyText" Style="{x:Null}" FontSize="12.5" TextWrapping="Wrap" TextBlock.LineHeight="18"
                     IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="14,10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Foreground="{DynamicResource Text.1}" CaretBrush="Transparent" Cursor="IBeam"
                     SelectionBrush="{DynamicResource Primary}" PreviewKeyDown="OnBodyKey" />
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="18,10" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="I DO NOT ACCEPT" Margin="0,0,8,0"
                        IsCancel="True" Click="OnDecline" />
                <Button Style="{StaticResource AccentRaisedButton}" Content="I ACCEPT" Click="OnAccept" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
