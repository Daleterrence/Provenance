<Window x:Class="Provenance.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        xmlns:local="clr-namespace:Provenance.Wpf.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="1000" Height="640"
        WindowStyle="None" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- decoded once near the size shown, the source PNGs are 1026x907 and 256x256 -->
        <BitmapImage x:Key="BgLogo" UriSource="/Assets/bg-logo.png" DecodePixelHeight="680" />
        <BitmapImage x:Key="TitleIcon" UriSource="/Assets/provenance-256.png" DecodePixelWidth="64" />
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <!-- Enter opens the link instead of falling through to sign in or play -->
            <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- only on the signed-out cards, a signed-in pol.exe keeps the files a repair replaces open -->
        <Style x:Key="RepairButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
            <Setter Property="Command" Value="{Binding RepairGameFilesCommand}" />
            <Setter Property="Visibility" Value="{Binding RepairAvailable, Converter={StaticResource BoolToVis}}" />
            <Setter Property="ToolTip" Value="{Binding RepairTooltip}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="Repair game files" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="WrenchOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="Repair game files" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RepairReason" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Text" Value="{Binding RepairBlockedReason}" />
            <Setter Property="Visibility" Value="{Binding RepairBlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="34,*,Auto">
        <Border Grid.Row="1" VerticalAlignment="Top" Height="160" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#2F5ACF" Offset="0" />
                    <GradientStop Color="#000A0E14" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <Grid Background="{DynamicResource Surface.1}" ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                <Image Source="{StaticResource TitleIcon}" Width="20" Height="20" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource Text.2}"
                           Text="PROVENANCE" />
            </StackPanel>
            <ToggleButton x:Name="WorldsChip" Grid.Column="1" Style="{x:Null}" VerticalAlignment="Center"
                          Margin="0,0,6,0" Cursor="Hand" Padding="0" KeyboardNavigation.AcceptsReturn="True"
                          shell:WindowChrome.IsHitTestVisibleInChrome="True"
                          PreviewMouseLeftButtonDown="OnWorldsChipMouseDown"
                          ToolTip="FINAL FANTASY XI world status (PlayOnline Server Status)"
                          AutomationProperties.Name="FINAL FANTASY XI world status (PlayOnline Server Status)">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border CornerRadius="11" Padding="10,3" Background="{DynamicResource Surface.2}"
                                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </ToggleButton.Template>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource Text.3}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WorldsState}" Value="up">
                                        <Setter Property="Fill" Value="{DynamicResource State.Online}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WorldsState}" Value="maintenance">
                                        <Setter Property="Fill" Value="{DynamicResource Accent.Gold}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WorldsState}" Value="down">
                                        <Setter Property="Fill" Value="{DynamicResource State.Down}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding WorldsSummary}" FontSize="12" Foreground="{DynamicResource Text.2}" VerticalAlignment="Center" />
                    <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" Margin="6,0,0,0"
                                             VerticalAlignment="Center" Foreground="{DynamicResource Text.3}" />
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="WorldsPopup" IsOpen="{Binding IsChecked, ElementName=WorldsChip}" StaysOpen="False"
                   Closed="OnWorldsPopupClosed" PlacementTarget="{Binding ElementName=WorldsChip}"
                   Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Fade">
                <Border CornerRadius="10" Padding="14,10" Background="{DynamicResource Surface.2}" MinWidth="240"
                        BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="World status" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Worlds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,16,2" ToolTip="{Binding Label}">
                                        <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource State.Down}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="up">
                                                            <Setter Property="Fill" Value="{DynamicResource State.Online}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="maintenance">
                                                            <Setter Property="Fill" Value="{DynamicResource Accent.Gold}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="partial-maintenance">
                                                            <Setter Property="Fill" Value="{DynamicResource Accent.Gold}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding WorldsCheckedText}"
                                   Visibility="{Binding WorldsCheckedText, Converter={StaticResource NullToVisibilityConverter}}" />
                        <Button Margin="0,6,0,0" FontSize="12" Style="{StaticResource LinkButton}"
                                Command="{Binding OpenServerStatusCommand}" AutomationProperties.Name="Open PlayOnline Server Status">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Open PlayOnline Server Status" VerticalAlignment="Center" />
                                <materialDesign:PackIcon Kind="ChevronRight" Width="14" Height="14" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
            <Button Grid.Column="2" Width="38" Height="34" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
                <materialDesign:PackIcon Kind="Cog" Width="17" Height="17" />
            </Button>
            <Button Grid.Column="3" Width="38" Height="34" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnMinimize" ToolTip="Minimise" AutomationProperties.Name="Minimise">
                <materialDesign:PackIcon Kind="WindowMinimize" Width="17" Height="17" />
            </Button>
            <Button Grid.Column="4" Width="38" Height="34" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Click="OnClose" ToolTip="{Binding CloseTooltip}">
                <materialDesign:PackIcon Kind="WindowClose" Width="17" Height="17" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="1.5*,400">
            <Grid Margin="24" RowDefinitions="3*,Auto,1.1*">
                <!-- laid out like POL's own topic cards: the 415x100 banner, then title, local date and summary -->
                <Border CornerRadius="12" Padding="16,16,16,10" Background="{DynamicResource Surface.2}"
                        BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="#000000" />
                    </Border.Effect>
                    <Grid ClipToBounds="True" Background="Transparent" MouseEnter="OnNewsHover" MouseLeave="OnNewsLeave"
                          IsKeyboardFocusWithinChanged="OnNewsFocus" RowDefinitions="Auto,Auto,Auto,*,Auto">
                        <Grid x:Name="NewsContent" Grid.RowSpan="4" RowDefinitions="Auto,Auto,Auto,*">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>

                        <Grid Cursor="Hand">
                            <Grid.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCurrentNewsCommand}" />
                            </Grid.InputBindings>
                            <!-- invisible sizer, a Border won't size to its ImageBrush (hacky, but round corners) -->
                            <Image Source="{Binding CurrentNews.ImageUrl}" Stretch="Uniform" Opacity="0" ImageFailed="OnBannerFailed" />
                            <Border CornerRadius="8">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentNews.ImageUrl}" Stretch="Fill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="8" Height="110"
                                    Visibility="{Binding CurrentNews.ImageUrl, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#16303F" Offset="0" />
                                        <GradientStop Color="#0E5A64" Offset="0.55" />
                                        <GradientStop Color="#102A3A" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <materialDesign:PackIcon Kind="SwordCross" Width="56" Height="56"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Opacity="0.3" Foreground="{DynamicResource Primary.Glow}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="2,14,2,0" Cursor="Hand" ToolTip="{Binding CurrentNews.Title}"
                                   Text="{Binding CurrentNews.Title, Converter={StaticResource ArticleTimesConverter}}"
                                   Foreground="{DynamicResource Text.1}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis">
                            <TextBlock.InputBindings>
                                <MouseBinding Gesture="LeftClick" Command="{Binding OpenCurrentNewsCommand}" />
                            </TextBlock.InputBindings>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Margin="2,4,2,0" FontSize="12" Foreground="{DynamicResource Primary}"
                                   Visibility="{Binding CurrentNews.Date, Converter={StaticResource NullToVisibilityConverter}}">
                            <Run Text="Posted" Foreground="{DynamicResource Text.3}" /><Run Text=" " /><Run Text="{Binding CurrentNews.Date, Mode=OneWay, Converter={StaticResource LocalTimeConverter}}" />
                        </TextBlock>

                        <TextBlock Grid.Row="3" Margin="2,10,2,0" FontSize="13" LineHeight="19"
                                   Foreground="{DynamicResource Text.2}" TextWrapping="Wrap" TextTrimming="WordEllipsis"
                                   Text="{Binding CurrentNews.Summary,
                                                  Converter={StaticResource ArticleTimesConverter}}" />
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,8,0,0" ColumnDefinitions="*,Auto,Auto,Auto"
                              Visibility="{Binding CurrentNews, Converter={StaticResource NullToVisibilityConverter}}">
                            <Button VerticalAlignment="Center" Margin="2,0,0,0" FontSize="13"
                                    Style="{StaticResource LinkButton}" Command="{Binding OpenCurrentNewsCommand}"
                                    AutomationProperties.Name="Read on PlayOnline">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Read on PlayOnline" VerticalAlignment="Center" />
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Width="28" Height="28" Padding="0"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="{DynamicResource Text.2}" ToolTip="Previous" AutomationProperties.Name="Previous"
                                    Command="{Binding PrevNewsCommand}">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20" />
                            </Button>
                            <ListBox Grid.Column="2" VerticalAlignment="Center" Margin="2,0"
                                     ItemsSource="{Binding NewsItems}"
                                     SelectedIndex="{Binding CurrentNewsIndex, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="Transparent" Padding="3,8">
                                                        <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4"
                                                                Background="{DynamicResource Text.3}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Text.2}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Primary}" />
                                                            <Setter TargetName="Dot" Property="Width" Value="20" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="{DynamicResource Text.2}" ToolTip="Next" AutomationProperties.Name="Next"
                                    Command="{Binding NextNewsCommand}">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" />
                            </Button>
                        </Grid>

                        <StackPanel Grid.RowSpan="5" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowLoadingHint, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FeedsHint}" Foreground="{DynamicResource Text.3}" FontSize="13"
                                       HorizontalAlignment="Center" />
                            <Button Content="TRY AGAIN" Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                                    Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding RetryFeedsCommand}"
                                    Visibility="{Binding FeedsFailed, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="2,12">
                    <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Accent.Gold}" Opacity="0.4" />
                    <Rectangle Width="7" Height="7" HorizontalAlignment="Center" Fill="{DynamicResource Accent.Gold}"
                               Opacity="0.75" RenderTransformOrigin="0.5,0.5">
                        <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <ItemsControl Grid.Row="2" ItemsSource="{Binding StatusItems}" ClipToBounds="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Url}" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" BorderThickness="0" Padding="6,8"
                                    Background="Transparent" Foreground="{DynamicResource Text.1}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- the post's category on POL's Information page, or a dot when there's none -->
                                    <Ellipse Width="7" Height="7" Margin="0,0,10,0"
                                             VerticalAlignment="Center" Fill="{DynamicResource Text.3}"
                                             Visibility="{Binding HasCategory, Converter={StaticResource InvertBoolToVis}}" />
                                    <Border CornerRadius="4" Padding="6,1" Margin="0,0,10,0" VerticalAlignment="Center"
                                            MinWidth="76" Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding BadgeLabel}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Badge.Neutral}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Category}" Value="Important">
                                                        <Setter Property="Background" Value="{DynamicResource Badge.Alert}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Maintenance">
                                                        <Setter Property="Background" Value="{DynamicResource Badge.Maintenance}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Events">
                                                        <Setter Property="Background" Value="{DynamicResource Badge.Event}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Category}" Value="Updates">
                                                        <Setter Property="Background" Value="{DynamicResource Badge.Update}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Badge}" Value="Outage">
                                                        <Setter Property="Background" Value="{DynamicResource Badge.Alert}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="10.5" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" Foreground="{DynamicResource Text.1}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Title, Converter={StaticResource ArticleTimesConverter}}" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Text.1}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding Date, Converter={StaticResource LocalTimeConverter}}"
                                               Foreground="{DynamicResource Text.3}" FontSize="11" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <Grid Grid.Column="1" Margin="0,24,24,24">
                <!-- the shadow's on its own empty Border, so the blur isn't redrawn every frame of the spinner -->
                <Border CornerRadius="16" Background="{DynamicResource Surface.2}" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.6" Color="#000000" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="16" Background="{DynamicResource Surface.2}"
                        BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                    <Grid>
                        <Grid Margin="28,22" VerticalAlignment="Center"
                              Visibility="{Binding ShowInstallCard, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="DownloadOutline" Width="46" Height="46"
                                                         HorizontalAlignment="Center" Foreground="{DynamicResource Primary}" />
                                <TextBlock Text="FINAL FANTASY XI isn't installed" FontSize="17" FontWeight="SemiBold"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,4" />
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Text.2}"
                                           Text="Provenance can download and install the game for you, or use an install you already have." />
                                <Button Margin="0,22,0,0" Height="48" FontSize="15" Command="{Binding DownloadInstallCommand}"
                                        Style="{StaticResource AccentRaisedButton}" Content="DOWNLOAD AND INSTALL" />
                                <Button Margin="0,10,0,0" Height="42" FontSize="14" Command="{Binding LocateInstallCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Content="LOCATE EXISTING INSTALL" />
                                <Button Margin="0,14,0,0" Style="{StaticResource RepairButton}" />
                                <TextBlock Style="{StaticResource RepairReason}" />
                            </StackPanel>
                        </Grid>

                        <!-- no ID or password fields here, the IDs stay off screen -->
                        <Grid Margin="28,22,28,14" RowDefinitions="*,Auto,Auto"
                              Visibility="{Binding ShowSignInCard, Converter={StaticResource BoolToVis}}">
                            <Image Source="{StaticResource BgLogo}" MaxHeight="340" Margin="0,0,0,10"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />

                            <StackPanel Grid.Row="1"
                                        Visibility="{Binding HasProfile, Converter={StaticResource InvertBoolToVis}}">
                                <TextBlock Text="Welcome" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,6,0,18" TextAlignment="Center" TextWrapping="Wrap" FontSize="13"
                                           Foreground="{DynamicResource Text.2}"
                                           Text="Add your PlayOnline account to get started. Your login details stay in Windows Credential Manager." />
                                <Button Height="46" FontSize="15" Command="{Binding AddAccountCommand}"
                                        Style="{StaticResource AccentRaisedButton}" Content="ADD ACCOUNT" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,6" ColumnDefinitions="Auto,*">
                                    <local:ProfilePictureCircle Diameter="52" Margin="0,0,12,0"
                                                                VerticalAlignment="Center"
                                                                Source="{Binding ProfilePicture}" />
                                    <!-- a floating hint draws a grey strip MaterialDesign 5 won't recolour -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Account" FontSize="11.5" Margin="2,0,0,4" Foreground="{DynamicResource Text.3}" />
                                        <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" FontSize="16"
                                                  Padding="14,10,10,10" materialDesign:HintAssist.IsFloating="False"
                                                  ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName"
                                                  SelectedItem="{Binding SelectedProfile}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                                    <Button Style="{StaticResource AccentFlatButton}" Padding="6,0" Height="26" FontSize="12"
                                            Command="{Binding EditAccountCommand}" Content="Edit account" />
                                    <Button Style="{StaticResource AccentFlatButton}" Padding="6,0" Height="26" FontSize="12"
                                            Command="{Binding AddAccountCommand}" Content="Add account" />
                                    <Button Padding="6,0" Height="26" FontSize="12"
                                            Command="{Binding RemoveAccountCommand}" Content="Remove"
                                            ToolTip="Remove this account and its saved passwords from this PC"
                                            AutomationProperties.Name="Remove this account and its saved passwords from this PC">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource State.Down}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>

                                <CheckBox Content="This account uses a one-time password" FontSize="13" Margin="0,0,0,10"
                                          Foreground="{DynamicResource Text.2}" IsChecked="{Binding UseOtp}"
                                          ToolTip="Provenance asks for the code from your authenticator each time you log in to this account." />
                                <TextBlock Text="All accounts" FontSize="11.5" Foreground="{DynamicResource Text.3}" Margin="0,0,0,4" />
                                <CheckBox Content="Log in automatically" FontSize="13" Margin="0,0,0,6"
                                          Foreground="{DynamicResource Text.2}" IsChecked="{Binding AutoLogin}"
                                          ToolTip="When Provenance opens, it logs in to the selected account. Hold Shift while it opens to skip this once." />
                                <CheckBox Content="Start game after logging in" FontSize="13"
                                          Foreground="{DynamicResource Text.2}" IsChecked="{Binding StartGameImmediately}" />

                                <Button Margin="0,18,0,0" Height="48" FontSize="16" Command="{Binding SignInCommand}"
                                        Style="{StaticResource AccentRaisedButton}" Content="LOG IN" IsDefault="True" />
                                <Button Margin="0,8,0,0" Height="36" Style="{StaticResource AccentFlatButton}"
                                        Command="{Binding StartAllAccountsCommand}" Content="{Binding StartAllText}"
                                        Visibility="{Binding HasMultiAccounts, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Logs in and starts the game for each account you've turned on in Settings, under Multi-account, one after another." />
                                <TextBlock HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap"
                                           TextAlignment="Center" Text="{Binding MultiStatus}"
                                           Visibility="{Binding MultiStatus, Converter={StaticResource NullToVisibilityConverter}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource RepairButton}" />
                                <TextBlock Style="{StaticResource RepairReason}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="14,14,14,18" RowDefinitions="Auto,*,Auto"
                              Visibility="{Binding ShowFriendsCard, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="8,0,4,6">
                                <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <Run Text="Friends" /><Run Text="   " /><Run Text="{Binding Social.Summary, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Text.3}" />
                                </TextBlock>
                                <Button HorizontalAlignment="Right" Style="{StaticResource AccentFlatButton}" Padding="8,0" Height="30"
                                        FontSize="12" Command="{Binding OpenSocialCommand}"
                                        ToolTip="Open friends and messages" AutomationProperties.Name="Open friends and messages">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MessageTextOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="MESSAGES" />
                                        <Border Margin="6,0,0,0" MinWidth="18" Height="18" CornerRadius="9" Padding="5,0"
                                                Background="{DynamicResource Primary}"
                                                Visibility="{Binding Social.NeedsAttention, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Unread messages, plus friend requests and group invitations waiting for an answer">
                                            <TextBlock Text="{Binding Social.AttentionCount}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Text.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <local:FriendsList Grid.Row="1" DataContext="{Binding Social}" FriendActivated="OnFriendActivated" />
                            <StackPanel Grid.Row="2" Margin="8,10,8,0">
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource State.Down}" Text="{Binding Social.PlayBlockedReason}"
                                           Visibility="{Binding Social.PlayBlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource Text.2}" Text="{Binding Social.AccountNotice}"
                                           Visibility="{Binding Social.AccountNotice, Converter={StaticResource NullToVisibilityConverter}}" />
                                <Button Height="48" FontSize="16" Command="{Binding PlayCommand}"
                                        IsEnabled="{Binding Social.CanPlay}"
                                        Style="{StaticResource AccentRaisedButton}" IsDefault="True" AutomationProperties.Name="Play">
                                    <StackPanel>
                                        <TextBlock Text="PLAY" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding PlaySubtitle}" FontSize="11" FontWeight="Normal" Opacity="0.7" HorizontalAlignment="Center"
                                                   Visibility="{Binding PlaySubtitle, Converter={StaticResource NullToVisibilityConverter}}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="28,24" VerticalAlignment="Center" Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Image Source="{StaticResource BgLogo}" Height="120" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding ProgressTitle}"
                                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                <TextBlock Margin="0,18,0,8" FontSize="14" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap"
                                           TextAlignment="Center" Text="{Binding ProgressText}" MinHeight="40" />
                                <ProgressBar Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                             Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}"
                                             materialDesign:TransitionAssist.DisableTransitions="False" />
                                <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                                    <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding TimeLeftText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                                               Foreground="{DynamicResource Text.3}" Text="{Binding ElapsedText}" />
                                </Grid>
                                <Button Margin="0,22,0,0" Height="40" FontSize="14" Command="{Binding CancelLaunchCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Content="CANCEL" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="1" Panel.ZIndex="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="24,0,0,18"
                MaxWidth="560" Padding="14,10" CornerRadius="10"
                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Primary}" BorderThickness="1"
                Visibility="{Binding Notice, Converter={StaticResource NullToVisibilityConverter}}"
                MouseLeftButtonUp="OnOpenNotice" MouseEnter="OnNoticeHover" MouseLeave="OnNoticeLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeOpens}" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000" />
            </Border.Effect>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <materialDesign:PackIcon Kind="{Binding NoticeIcon}" Width="20" Height="20" Margin="0,0,10,0"
                                         VerticalAlignment="Center" Foreground="{DynamicResource Primary}" />
                <!-- the text's a button too, so Tab and Enter can open the notice -->
                <Button Grid.Column="1" Style="{x:Null}" Click="OnOpenNotice" VerticalAlignment="Center"
                        Cursor="{Binding Cursor, RelativeSource={RelativeSource AncestorType=Border}}"
                        KeyboardNavigation.AcceptsReturn="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Label" Text="{Binding Notice}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.1}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Width="26" Height="26" Padding="0" Margin="10,0,0,0"
                        Style="{StaticResource MaterialDesignIconButton}" Foreground="{DynamicResource Text.3}"
                        Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss">
                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Height="44"
                Background="{DynamicResource Surface.1}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0"
                Visibility="{Binding SocialConnected, Converter={StaticResource BoolToVis}}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <local:ProfilePictureCircle Diameter="32" Margin="0,0,10,0" Source="{Binding Social.Avatar}"
                                                Cursor="Hand" ToolTip="Change your profile picture"
                                                MouseLeftButtonUp="OnAvatarClick" />
                    <TextBlock Text="{Binding Social.AccountName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Margin="4,0,0,0" Width="26" Height="24" Padding="0" VerticalAlignment="Center"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.3}"
                            ToolTip="Edit your PlayOnline profile" AutomationProperties.Name="Edit your PlayOnline profile" Click="OnEditProfile">
                        <materialDesign:PackIcon Kind="AccountEditOutline" Width="16" Height="16" />
                    </Button>
                    <!-- locked with a spinner until POL confirms -->
                    <ComboBox Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPicker}"
                              IsEnabled="{Binding Social.StatusEditable}"
                              ItemsSource="{Binding Social.StatusLabels}" SelectedIndex="{Binding Social.MyStatusIndex}" />
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5" MaxWidth="320"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource State.Warn}"
                               Text="{Binding Social.StatusNote}" ToolTip="{Binding Social.StatusNote}"
                               Visibility="{Binding Social.StatusNote, Converter={StaticResource NullToVisibilityConverter}}" />
                    <ProgressBar Width="14" Height="14" Margin="8,0,0,0" IsIndeterminate="True"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 ToolTip="Waiting for PlayOnline to confirm"
                                 Visibility="{Binding Social.StatusPending, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0" Height="30" FontSize="12"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="{DynamicResource Text.2}" Command="{Binding SignOutCommand}" Content="LOG OUT" />
            </Grid>
        </Border>
    </Grid>
</Window>
