<Window x:Class="Provenance.Wpf.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:InstallViewModel}"
        Title="Install FINAL FANTASY XI" Icon="/Assets/provenance.ico"
        Width="640" Height="560" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        MouseLeftButtonDown="OnDrag">

    <Border Margin="12" CornerRadius="8" Background="{DynamicResource Surface.2}"
            BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="28,22" RowDefinitions="Auto,Auto,*,Auto">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/provenance-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Install FINAL FANTASY XI" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16" />
                </Button>
            </Grid>

            <!-- before a run, and after a stop or a failure so the folders can change -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0" Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="This downloads the official game (about " Foreground="{DynamicResource Text.2}" FontSize="13">
                    <Run Text="{Binding TotalGib, Mode=OneWay}" /><Run Text=") and installs it the way Square Enix's own installer does." />
                </TextBlock>

                <StackPanel x:Name="RegionChoice" Visibility="{Binding ShowRegionChoice, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Region" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,14,0,2" />
                    <ComboBox Width="260" HorizontalAlignment="Left" Padding="12,8,8,8" FontSize="13"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" AutomationProperties.Name="Region"
                              ItemsSource="{Binding RegionChoices}" SelectedIndex="{Binding RegionIndex}" IsEnabled="{Binding CanChooseRegion}" />
                </StackPanel>

                <TextBlock Text="Install to" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,14,0,2" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding InstallFolder}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding BrowseInstallCommand}" />
                </Grid>
                <TextBlock Text="{Binding GameFolderText}" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="2,4,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding FreeSpaceText}" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap"
                           Tag="{Binding EnoughSpace, Converter={StaticResource InvertBool}}"
                           Style="{StaticResource DimStatusText}" />

                <TextBlock Text="Download the installer to" FontSize="11" Foreground="{DynamicResource Text.3}" Margin="0,12,0,2" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Text="{Binding DownloadFolder}" Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding BrowseDownloadCommand}" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding StepText}" FontSize="12" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Center"
                           Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Stage}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="{DynamicResource Text.2}"
                           HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                <ProgressBar Margin="0,24,0,4" Height="10" Minimum="0" Maximum="1" Value="{Binding DownloadFraction}" IsIndeterminate="{Binding StageIndeterminate}"
                             Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}"
                             Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding DownloadText}" FontSize="13" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Center"
                           Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding TimeLeftText}" FontSize="13" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Center"
                           Margin="0,2,0,0" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <!-- here rather than with the folders, so it can show mid-run once SE's parts are what's coming down -->
                <CheckBox Margin="0,16,0,0" HorizontalAlignment="Center" IsChecked="{Binding KeepInstaller}" FontSize="12"
                          Content="Keep the downloaded installer after the install (7.2 GiB)"
                          Visibility="{Binding ShowKeepInstaller, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Grid Grid.Row="3">
                <Button HorizontalAlignment="Left" Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource Text.2}" Command="{Binding CancelCommand}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <Button HorizontalAlignment="Right" MinWidth="180" Padding="20,0" Height="46" FontSize="15" Content="{Binding StartLabel}"
                        Style="{StaticResource AccentRaisedButton}" Command="{Binding StartCommand}"
                        Visibility="{Binding CanStart, Converter={StaticResource BoolToVis}}" />
                <Button HorizontalAlignment="Right" Width="120" Height="46" FontSize="15" Content="DONE"
                        Style="{StaticResource AccentRaisedButton}"
                        Click="OnClose" Visibility="{Binding Done, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
