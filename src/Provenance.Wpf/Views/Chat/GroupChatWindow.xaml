<Window x:Class="Provenance.Wpf.Views.Chat.GroupChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Chat"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:GroupChatViewModel}"
        Title="Group Chat" Icon="/Assets/provenance.ico"
        Width="760" Height="560" MinWidth="560" MinHeight="380" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MaxButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="ToolTip" Value="Maximise" />
            <Setter Property="Tag" Value="{x:Static materialDesign:PackIconKind.WindowMaximize}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="ToolTip" Value="Restore down" />
                    <Setter Property="Tag" Value="{x:Static materialDesign:PackIconKind.WindowRestore}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="GroupLine" DataType="{x:Type vm:GroupChatLineItem}">
            <Grid Margin="0,1" ColumnDefinitions="Auto,*">
                <TextBlock x:Name="Time" Margin="0,1,10,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding TimeText}"
                           Visibility="{Binding DataContext.ShowTimes, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="Body" Grid.Column="1" Style="{x:Null}" Text="{Binding Display, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                         IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0"
                         Foreground="{DynamicResource Text.1}" CaretBrush="Transparent" Cursor="IBeam"
                         SelectionBrush="{DynamicResource Primary}" ContextMenuOpening="OnLineMenu" Tag="{Binding}">
                    <TextBox.ContextMenu>
                        <ContextMenu />
                    </TextBox.ContextMenu>
                </TextBox>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Me}" Value="True">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Primary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="40,Auto,*,Auto">
        <Grid Background="{DynamicResource Title.Bg}" TextElement.Foreground="{DynamicResource Text.1}">
            <Grid.Resources>
                <ResourceDictionary Source="/Provenance;component/Themes/TitleBar.xaml" />
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Forum" Width="18" Height="18" Foreground="{DynamicResource Primary}" />
                <TextBlock Text="Group Chat" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MaximizeButton" Width="44" Height="40" Padding="0" Foreground="{DynamicResource Text.2}"
                        Style="{StaticResource MaxButton}" Click="OnMaximize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Width="18" Height="18" Kind="{Binding Tag, ElementName=MaximizeButton}" />
                </Button>
                <Button Width="44" Height="40" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnHide"
                        ToolTip="Close the group chat screen, and return to the previous page. The group chat screen will be hidden, but not terminated."
                        AutomationProperties.Name="Close">
                    <controls:SvgIcon Glyph="close" Flat="True" Width="18" Height="18" />
                </Button>
            </StackPanel>
            <Border Style="{StaticResource TitleEdge}" />
        </Grid>

        <Border Grid.Row="1" Padding="16,10" BorderBrush="{DynamicResource Border.Pane}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface.1}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="15" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding GroupName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding Count, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Text.3}" />
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding MyHandle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MoreButton" Width="32" Height="32" Padding="0" Style="{StaticResource IconButton}"
                            Foreground="{DynamicResource Text.3}" ToolTip="More" AutomationProperties.Name="More" Click="OnMore">
                        <controls:SvgIcon Glyph="more" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource PolButton}" FontSize="12" Content="CLOSE" Click="OnHide"
                            ToolTip="Close the group chat screen, and return to the previous page. The group chat screen will be hidden, but not terminated." />
                    <Button Style="{StaticResource RedButton}" FontSize="12" Content="EXIT" Click="OnExit" ToolTip="Exiting group chat." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="200" MinWidth="140" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="LineScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                <ItemsControl x:Name="LineList" ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource GroupLine}" />
            </ScrollViewer>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Joining, Converter={StaticResource BoolToVis}}">
                <ProgressBar Width="28" Height="28" IsIndeterminate="True" Value="0" Style="{StaticResource MaterialDesignCircularProgressBar}" />
            </StackPanel>
            <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" HorizontalContentAlignment="Right" />
            <ScrollViewer Grid.Column="2" Background="{DynamicResource Surface.1}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Members}" Margin="0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupChatMemberItem}">
                            <Grid Margin="14,3" ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Note}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.3}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBox x:Name="ComposeBox" MinHeight="40" FontSize="13" Text="{Binding Compose, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap" MaxLength="174" Style="{StaticResource OutlinedField}" Padding="10,8"
                         materialDesign:HintAssist.Hint="Say something to the group (Enter sends)" materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed" IsEnabled="{Binding InChat}"
                         PreviewKeyDown="OnComposeKey" PreviewTextInput="OnComposeInput" DataObject.Pasting="OnComposePaste" />
                <Button Grid.Column="1" Margin="{StaticResource Footer.Gap}" Height="40" VerticalAlignment="Bottom" Style="{StaticResource PolButton}"
                        Command="{Binding SendCommand}" Content="SEND" ToolTip="Send the message entered into the text area." />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource State.Warn}"
                           Text="{Binding ComposeNote}" Visibility="{Binding ComposeNote, Converter={StaticResource NullToVisibilityConverter}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
