<Window x:Class="Provenance.Wpf.Views.RepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RepairViewModel}"
        Title="Repair game files" Icon="/Assets/provenance.ico"
        Width="560" SizeToContent="Height" MinHeight="300" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}"
        MouseLeftButtonDown="OnDrag">

    <Border Margin="12" CornerRadius="8" Background="{DynamicResource Surface.2}"
            BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="28,22" RowDefinitions="Auto,*,Auto">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/provenance-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Repair game files" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0"
                        Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                    <materialDesign:PackIcon Kind="WindowClose" Width="16" Height="16" />
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,20">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="44" Height="44" Margin="0,0,0,14" HorizontalAlignment="Center"
                                         Foreground="{DynamicResource Primary}"
                                         Visibility="{Binding Succeeded, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Stage}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap"
                           Visibility="{Binding Stage, Converter={StaticResource NullToVisibilityConverter}}" />
                <!-- a result with no heading reads as the main line -->
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Tag="{Binding Failed}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Margin" Value="0,8,0,0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Succeeded}" Value="True">
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="Margin" Value="12,0" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Margin="0,20,0,4" Height="8" Minimum="0" Maximum="1" Value="{Binding Fraction}" IsIndeterminate="{Binding Indeterminate}"
                             Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}"
                             Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Amount}" FontSize="12" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Center"
                           Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding TimeLeft}" FontSize="12" Foreground="{DynamicResource Text.3}" HorizontalAlignment="Center"
                           Margin="0,2,0,0" Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Grid Grid.Row="2">
                <Button HorizontalAlignment="Left" Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{DynamicResource Text.2}" Command="{Binding CancelCommand}"
                        Visibility="{Binding Running, Converter={StaticResource BoolToVis}}" />
                <Button HorizontalAlignment="Right" Width="120" Height="40" Content="CLOSE"
                        Style="{StaticResource AccentRaisedButton}" Click="OnClose"
                        Visibility="{Binding Finished, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Border>
</Window>
