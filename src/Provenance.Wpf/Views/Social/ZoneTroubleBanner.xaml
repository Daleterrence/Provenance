<UserControl x:Class="Provenance.Wpf.Views.Social.ZoneTroubleBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
             Focusable="False" IsTabStop="False" Visibility="Collapsed">
    <Border Padding="12,8" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Pop.Info.Fill}"
            BorderBrush="{DynamicResource Pop.Info.Border}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
            <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Pop.Info.Icon}" />
            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Pop.Info.Text}"
                       Text="{x:Static vm:SocialViewModel.ZoneTroubleText}" AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </Border>
</UserControl>
