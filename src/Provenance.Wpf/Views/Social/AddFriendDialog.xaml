<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.AddFriendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}"
        Title="Add a friend" Icon="/Assets/provenance.ico"
        Width="460" Height="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow.Fixed}"
        CloseOnEscape="False">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,*,Auto">
        <controls:TitleBar />

        <StackPanel Grid.Row="1" Margin="16,8,16,6">
            <StackPanel Orientation="Horizontal" Margin="-10,0,0,8" IsEnabled="{Binding SearchBusy, Converter={StaticResource InvertBool}}">
                <RadioButton Style="{StaticResource UnderlineTab}" Tag="{Binding SearchByHandle}" GroupName="SearchKind" Content="Handle"
                             IsChecked="{Binding SearchByHandle}" Checked="OnKindPicked" />
                <RadioButton Style="{StaticResource UnderlineTab}" Tag="{Binding SearchByHid}" GroupName="SearchKind" Content="H-ID"
                             IsChecked="{Binding SearchByHid}" Checked="OnKindPicked" />
                <RadioButton Style="{StaticResource UnderlineTab}" Tag="{Binding SearchByCharacter}" GroupName="SearchKind" Content="Character"
                             IsChecked="{Binding SearchByCharacter}" Checked="OnKindPicked" />
            </StackPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap" Text="{Binding SearchIntro}" />
            <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <TextBox x:Name="NameBox" FontSize="13" Height="40" Padding="10,6" MaxLength="{Binding SearchMaxLength}"
                         Style="{StaticResource OutlinedField}"
                         materialDesign:HintAssist.Hint="{Binding SearchHint}" materialDesign:HintAssist.IsFloating="False"
                         AutomationProperties.Name="{Binding SearchHint}" KeyDown="OnNameKey" />
                <Button Grid.Column="1" Margin="10,0,0,0" Height="40" Content="SEARCH" Click="OnSearch"
                        Style="{StaticResource PolButton}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                             Style="{StaticResource Spinner}"
                             Visibility="{Binding SearchBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="400" Text="{Binding SearchNote}"
                           Tag="{Binding SearchNoteIsError}" Style="{StaticResource DimStatusText}" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="Hits" Grid.Row="2" Margin="10,4" ItemsSource="{Binding SearchHits}"
                 HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource RowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3" ColumnDefinitions="Auto,*">
                        <controls:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" Source="{Binding Avatar}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource Text.3}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PolButton}" Content="CLOSE" Click="OnClose" />
                <Button x:Name="SendButton" Content="SEND FRIEND REQUEST" Click="OnSend" Margin="{StaticResource Footer.Gap}"
                        Style="{StaticResource PolButton}" />
            </StackPanel>
        </Border>
    </Grid>
</controls:AppWindow>
