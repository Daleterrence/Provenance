<UserControl x:Class="Provenance.Wpf.Views.Social.FeedFaultBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
             Focusable="False" IsTabStop="False">
    <Border Padding="12,8" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Pop.Error.Fill}"
            BorderBrush="{DynamicResource Pop.Error.Border}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
            <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Pop.Error.Icon}" />
            <TextBlock Grid.Column="1" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Pop.Error.Text}"
                       behaviours:Announce.WhenShown="True" Text="{x:Static vm:SocialViewModel.GameFeedFaultText}" />
        </Grid>
    </Border>
</UserControl>
