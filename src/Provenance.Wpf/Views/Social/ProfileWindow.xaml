<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
        xmlns:services="clr-namespace:Provenance.Wpf.Services"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:FriendProfileViewModel}"
        Title="PlayOnline profile" Icon="/Assets/provenance.ico"
        Width="440" Height="600" ResizeMode="CanResize" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}">

    <!-- POL's View Profile: pic, name, H-ID, mail, last update, privacy, its rows in POL's order and the away message.
         Each FFXI character gets a tab that swaps in its page -->
    <Grid x:Name="Root" Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,Auto,*,Auto">
        <controls:TitleBar>
            <controls:TitleBar.IconContent>
                <controls:SvgIcon Glyph="card" Width="22" Height="22" Margin="0,0,8,0" />
            </controls:TitleBar.IconContent>
        </controls:TitleBar>

        <ItemsControl Grid.Row="1" Margin="18,8,12,0" ItemsSource="{Binding Tabs}"
                      Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button behaviours:State.IsCurrent="{Binding IsSelected}"
                            Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Label}">
                        <!-- the tooltip still shows on a tab that can't be clicked, it just doesn't light up -->
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RoundTab}">
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Clickable}" Value="False" />
                                            <Condition Binding="{Binding Path=(behaviours:State.IsCurrent), RelativeSource={RelativeSource Self}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hair}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.TabsClickable, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="False" />
                                            <Condition Binding="{Binding Path=(behaviours:State.IsCurrent), RelativeSource={RelativeSource Self}}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Border.Hair}" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="34" Height="34">
                            <controls:ProfilePictureCircle Diameter="34" Source="{Binding Picture}"
                                                           Visibility="{Binding IsHandle, Converter={StaticResource BoolToVis}}" />
                            <Ellipse Visibility="{Binding IsHandle, Converter={StaticResource InvertBoolToVis}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Static services:SvgIcons.XiBadgeRound}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2" Margin="18,16,18,8" ColumnDefinitions="Auto,*">
            <controls:ProfilePictureCircle x:Name="Picture" Diameter="72" Source="{Binding Picture}" VerticalAlignment="Top" Margin="0,0,14,0"
                                           Visibility="{Binding ShowsPicture, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Hid, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                         Foreground="{DynamicResource Text.3}" />
                <TextBox Style="{StaticResource SelectableText}" Text="{Binding Mail, Mode=OneWay}" FontSize="12" Margin="0,2,0,0"
                         Foreground="{DynamicResource Text.2}"
                         Visibility="{Binding Mail, Converter={StaticResource NullToVisibilityConverter}}" />
                <WrapPanel Margin="0,2,0,0" TextElement.FontSize="11.5" TextElement.Foreground="{DynamicResource Text.3}">
                    <TextBlock Text="{Binding GameLine, Mode=OneWay}"
                               Visibility="{Binding GameLine, Converter={StaticResource NullToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Updated, Mode=OneWay}" Margin="0,0,12,0" />
                    <TextBlock Visibility="{Binding Privacy, Converter={StaticResource NullToVisibilityConverter}}">
                        <Run Text="Privacy: " /><Run Text="{Binding Privacy, Mode=OneWay}" />
                    </TextBlock>
                </WrapPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="18,4,18,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,8"
                            Visibility="{Binding Note.Text, Converter={StaticResource NullToVisibilityConverter}}">
                    <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                                 Style="{StaticResource Spinner}"
                                 Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Note.Text}" FontSize="12" TextWrapping="Wrap"
                               behaviours:State.IsError="{Binding Note.IsError}" Style="{StaticResource DimStatusText}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5" ColumnDefinitions="120,*">
                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap" />
                                <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Value, Mode=OneWay}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0,14,0,0" Padding="12,10" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.1}"
                        BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1"
                        Visibility="{Binding Away, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AwayFrom}" FontSize="11.5" Foreground="{DynamicResource Text.3}" />
                        <TextBlock Text="{Binding Away}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Style="{StaticResource FooterBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CLOSE" Style="{StaticResource PolButton}" Click="OnClose" />
                <Button x:Name="SendButton" Content="SEND MESSAGE" Margin="{StaticResource Footer.Gap}" Style="{StaticResource PolButton}" Click="OnSendMessage" />
            </StackPanel>
        </Border>
    </Grid>
</controls:AppWindow>
