<UserControl x:Class="Provenance.Wpf.Views.Social.FriendsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
             xmlns:local="clr-namespace:Provenance.Wpf.Views.Social"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}">

    <UserControl.Resources>
        <Style x:Key="FriendRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
            <Setter Property="AutomationProperties.Name">
                <Setter.Value>
                    <MultiBinding StringFormat="{}{0}, {1}">
                        <Binding Path="Name" />
                        <Binding Path="StatusLabel" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FriendListBox" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding FriendsUnavailable}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- only built for a friend with a party icon, so the others carry nothing and leave no gap -->
        <DataTemplate DataType="{x:Type vm:PartyIconView}">
            <controls:SvgIcon IconFile="{Binding File}" Foreground="{DynamicResource Primary}" Width="NaN" Height="14" Margin="12,0,-6,2"
                              Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}" />
        </DataTemplate>
        <DataTemplate x:Key="FriendRow" DataType="{x:Type vm:FriendItem}">
            <Grid Margin="6,4" Background="Transparent" ColumnDefinitions="Auto,*,Auto">
                <controls:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                               Source="{Binding Avatar}" InGame="{Binding InGame}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- docked, the name's measured against the whole width so it still trims, and the Playing line gets what's left -->
                    <DockPanel Background="Transparent" behaviours:TrimTip.OnlyWhenCut="True">
                        <DockPanel.ToolTip>
                            <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Playing, Mode=OneWay}" /><Run Text="{Binding PartyTip, Mode=OneWay, StringFormat={}   {0}}" /></TextBlock>
                        </DockPanel.ToolTip>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                   Foreground="{DynamicResource Text.1}" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                        <ContentControl x:Name="PartyIconSlot" DockPanel.Dock="Left" Content="{Binding PartyIcon}" VerticalAlignment="Bottom"
                                        Focusable="False" IsTabStop="False" />
                        <controls:FitText Long="{Binding Playing}" Short="{Binding PlayingShort}" FontSize="12"
                                          Foreground="{DynamicResource Text.3}" Margin="12,0,0,1" VerticalAlignment="Bottom" />
                    </DockPanel>
                    <!-- docked, so a long comment trims to the row instead of running off it -->
                    <DockPanel Margin="0,2,0,0">
                        <controls:StatusMark DockPanel.Dock="Left" Status="{Binding Status}" Online="{Binding Online}" Shown="{Binding HasStatus}" Margin="0,0,6,0" />
                        <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.3}" behaviours:TrimTip.OnlyWhenCut="True">
                            <TextBlock.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"><Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="{Binding Comment, Mode=OneWay, StringFormat={}   {0}}" /></TextBlock>
                            </TextBlock.ToolTip>
                            <Run Text="{Binding StatusLabel, Mode=OneWay}" Foreground="{DynamicResource Text.2}" /><Run Text="{Binding Comment, Mode=OneWay, StringFormat={}   {0}}" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource CountBadge}"
                        Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding Unread}" Style="{StaticResource CountBadgeText}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ListBox x:Name="List" ItemsSource="{Binding FriendsView}" SelectedItem="{Binding SelectedFriend}"
                 IsSynchronizedWithCurrentItem="False" Style="{StaticResource FriendListBox}"
                 ItemTemplate="{StaticResource FriendRow}" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource FriendRowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent"
                 MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown" ContextMenuOpening="OnContextMenuOpening">
            <ListBox.ContextMenu>
                <ContextMenu />
            </ListBox.ContextMenu>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Margin="12,10,0,2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}">
                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run
                                     Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>

        <local:OnlineFailedCard Margin="10,12" VerticalAlignment="Top"
                                Visibility="{Binding FriendsUnavailable, Converter={StaticResource BoolToVis}}" />

        <StackPanel Margin="16,20" VerticalAlignment="Top"
                    Visibility="{Binding NoFriendsInList, Converter={StaticResource BoolToVis}}">
            <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap"
                       Text="You don't have any friends on this PlayOnline account yet." />
            <Button Margin="0,8,0,0" Padding="6,0,10,0" Height="28" HorizontalAlignment="Left" Style="{StaticResource PolButton}"
                    FontSize="12" IsEnabled="{Binding CanEdit}" Click="OnAddFriend"
                    AutomationProperties.Name="Search PlayOnline and send a friend request">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Glyph="search" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="ADD A FRIEND" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border VerticalAlignment="Bottom" Margin="10" Padding="12,8" CornerRadius="{StaticResource Radius.Panel}"
                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1"
                Visibility="{Binding EditStatusShown, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                             Style="{StaticResource Spinner}"
                             Visibility="{Binding Saving, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="260" Text="{Binding EditStatus}" />
                <!-- only success notes go by themselves -->
                <Button Width="22" Height="22" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.3}"
                        Command="{Binding DismissEditNoteCommand}" AutomationProperties.Name="Dismiss"
                        Visibility="{Binding EditNoteShown, Converter={StaticResource BoolToVis}}">
                    <controls:SvgIcon Glyph="dismiss" Width="12" Height="12" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
