<UserControl x:Class="Provenance.Wpf.Views.Social.ConversationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:social="clr-namespace:Provenance.Common.Social;assembly=Provenance.Common"
             xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
             xmlns:local="clr-namespace:Provenance.Wpf.Views.Social"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialMessages}">

    <UserControl.Resources>
        <!-- no BasedOn keeps MaterialDesign's look off -->
        <Style x:Key="LineLink" TargetType="Button">
            <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Label" Background="Transparent"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                            <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ChatLine">
            <StackPanel>
                <TextBlock Text="{Binding DayBreak}" HorizontalAlignment="Center" Margin="0,12,0,2" FontSize="11"
                           Foreground="{DynamicResource Text.3}"
                           Visibility="{Binding DayBreak, Converter={StaticResource NullToVisibilityConverter}}" />
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:ProfilePictureCircle x:Name="TheirProfilePicture" Diameter="30" Margin="0,6,8,0"
                                                   VerticalAlignment="Top"
                                                   Source="{Binding DataContext.Friend.Avatar, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   InGame="{Binding DataContext.Friend.InGame, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    <controls:ProfilePictureCircle x:Name="MyProfilePicture" Grid.Column="2" Diameter="30" Margin="8,6,0,0"
                                                   VerticalAlignment="Top" Visibility="Collapsed"
                                                   Source="{Binding DataContext.Social.Avatar, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                    <StackPanel x:Name="Line" Grid.Column="1" Margin="0,4" HorizontalAlignment="Left">
                        <Border x:Name="Bubble" MaxWidth="420" HorizontalAlignment="Left" Padding="12,8" CornerRadius="{StaticResource Radius.Panel}"
                                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                            <TextBox x:Name="Body" Style="{StaticResource SelectableText}" Text="{Binding Display, Mode=OneWay}" FontSize="13" IsTabStop="False" ContextMenuOpening="OnLineMenu">
                                <TextBox.ContextMenu>
                                    <ContextMenu />
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Border>
                        <TextBlock x:Name="Meta" FontSize="10.5" Margin="6,2,6,0" Foreground="{DynamicResource Text.3}"
                                   Text="{Binding TimeText}"
                                   Visibility="{Binding DataContext.Social.ShowTimes, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                        <StackPanel x:Name="SendState" Orientation="Horizontal" Margin="6,0" HorizontalAlignment="Right"
                                    Visibility="Collapsed">
                            <TextBlock x:Name="SendStateText" FontSize="10.5" Foreground="{DynamicResource Text.3}" Text="{Binding StateText}" />
                            <Button x:Name="Retry" Style="{StaticResource LineLink}" Foreground="{DynamicResource Primary}"
                                    Content="Send again" Visibility="Collapsed" Click="OnResend" />
                            <Button x:Name="RemoveLine" Style="{StaticResource LineLink}" Foreground="{DynamicResource Text.3}"
                                    Content="Remove" Visibility="Collapsed" Click="OnRemoveFailed" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Outgoing}" Value="True">
                    <Setter TargetName="Line" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="TheirProfilePicture" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MyProfilePicture" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Primary.Muted}" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Meta" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="SendState" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Failed}" Value="True">
                    <Setter TargetName="SendStateText" Property="Foreground" Value="{DynamicResource State.Warn}" />
                    <Setter TargetName="Retry" Property="Visibility" Value="Visible" />
                    <Setter TargetName="RemoveLine" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="notice">
                    <Setter TargetName="Line" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="TheirProfilePicture" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="MyProfilePicture" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="Meta" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="SendState" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Body" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Text.3}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PartyIconView}">
            <controls:SvgIcon IconFile="{Binding File}" Foreground="{DynamicResource Primary}" Width="NaN" Height="14" Margin="0,0,6,0"
                              Background="Transparent" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Tip}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Style="{StaticResource PaneHeader}">
            <Grid ColumnDefinitions="*,Auto">
                <Grid ColumnDefinitions="Auto,*">
                    <controls:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                                   Source="{Binding Friend.Avatar}" InGame="{Binding Friend.InGame}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Friend.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <DockPanel Margin="0,2,0,0" Background="Transparent" behaviours:TrimTip.OnlyWhenCut="True"
                                   Visibility="{Binding Friend.Playing, Converter={StaticResource NullToVisibilityConverter}}">
                            <DockPanel.ToolTip>
                                <TextBlock MaxWidth="320" TextWrapping="Wrap"><Run Text="{Binding Friend.Playing, Mode=OneWay}" /><Run Text="{Binding Friend.PartyTip, Mode=OneWay, StringFormat={}   {0}}" /></TextBlock>
                            </DockPanel.ToolTip>
                            <ContentControl DockPanel.Dock="Left" Content="{Binding Friend.PartyIcon}" VerticalAlignment="Center"
                                            Focusable="False" IsTabStop="False" />
                            <TextBlock Text="{Binding Friend.Playing}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Text.3}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,2,0,0" Background="Transparent">
                            <controls:StatusMark DockPanel.Dock="Left" Status="{Binding Friend.Status}" Online="{Binding Friend.Online}"
                                                 Shown="{Binding Friend.HasStatus, FallbackValue=False}" Margin="0,0,6,0" />
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Text.3}"
                                       behaviours:TrimTip.OnlyWhenCut="True" VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap"><Run Text="{Binding Friend.StatusLabel, Mode=OneWay}" /><Run Text="{Binding Friend.Comment, Mode=OneWay, StringFormat={}   {0}}" /></TextBlock>
                                </TextBlock.ToolTip>
                                <Run Text="{Binding Friend.StatusLabel, Mode=OneWay}" Foreground="{DynamicResource Text.2}" /><Run Text="{Binding Friend.Comment, Mode=OneWay, StringFormat={}   {0}}" />
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                    <Button x:Name="PopOutButton" Width="32" Height="32" Padding="0" Foreground="{DynamicResource Text.3}" Click="OnPopOut"
                            ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="AutomationProperties.Name" Value="Pop out this conversation" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Popped, RelativeSource={RelativeSource AncestorType=local:ConversationView}}" Value="True">
                                        <Setter Property="AutomationProperties.Name" Value="Put this conversation back in the Friends window" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.3}"
                            AutomationProperties.Name="Actions for this person" Click="OnConversationMenu">
                        <controls:SvgIcon Glyph="more" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ItemsControl Grid.Row="1" x:Name="ChatLines" ItemsSource="{Binding Conversation}" ItemTemplate="{StaticResource ChatLine}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="PART_ChatScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" FontSize="12"
                   Foreground="{DynamicResource Text.3}" TextWrapping="Wrap" TextAlignment="Center"
                   Style="{StaticResource ShowWhenZero}" behaviours:State.Count="{Binding Conversation.Count}">
            <Run Text="No messages with " /><Run Text="{Binding Friend.Name, Mode=OneWay}" /><Run Text=" yet." />
        </TextBlock>
        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <!-- MaxLength's only a backstop, the real limit's 300 bytes -->
                <TextBox AutomationProperties.Name="Message" x:Name="ComposeBox" MinHeight="40" MaxHeight="120" FontSize="13"
                         Text="{Binding Compose, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="{x:Static social:PolMessage.MaxTextBytes}"
                         Style="{StaticResource OutlinedField}" Padding="10,8"
                         materialDesign:HintAssist.Hint="Write a message (Enter sends, Shift+Enter adds a line)"
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                         IsEnabled="{Binding CanCompose}"
                         behaviours:ComposeBox.Send="{Binding SendCommand}" behaviours:ComposeBox.Rules="{Binding ComposeRules}" />
                <Button Grid.Column="1" Margin="{StaticResource Footer.Gap}" Height="40" VerticalAlignment="Bottom"
                        Style="{StaticResource PolButton}" Command="{Binding SendCommand}" Content="SEND" />
                <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" FontSize="11" Foreground="{DynamicResource Text.3}"
                               Text="{Binding ComposeCount}"
                               Visibility="{Binding ComposeCountShown, Converter={StaticResource BoolToVis}}" />
                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.3}"
                               Text="{Binding ComposeNote}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
