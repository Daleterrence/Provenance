<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.ProfilePicturePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Choose your profile picture" Icon="/Assets/provenance.ico"
        Width="760" Height="560" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow.Fixed}"
        CloseOnEscape="False">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*,Auto">
        <controls:TitleBar />

        <Grid Grid.Row="1" ColumnDefinitions="220,*">
            <ListBox x:Name="Categories" Background="{DynamicResource Surface.1}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Border.Pane}"
                     DisplayMemberPath="Name" SelectionChanged="OnCategoryChanged" Padding="0,8"
                     ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <!-- a list so the arrow keys move between pics, and Enter uses the picked one -->
            <ListBox x:Name="Pics" Grid.Column="1" Padding="12" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnProfilePictureSelected"
                     MouseDoubleClick="OnProfilePictureDoubleClick" KeyboardNavigation.DirectionalNavigation="Cycle">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Cell" Margin="6" Padding="6" CornerRadius="{StaticResource Radius.Panel}" Cursor="Hand" Background="Transparent"
                                BorderThickness="2" BorderBrush="Transparent" ToolTip="{Binding Tip}">
                            <controls:ProfilePictureCircle Diameter="64" Source="{Binding Image}" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource Surface.2}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter TargetName="Cell" Property="BorderBrush" Value="{DynamicResource Primary.Muted}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <Grid>
                <TextBlock x:Name="Chosen" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.2}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource RedButton}" Content="CANCEL" Click="OnCancel" />
                    <Button x:Name="UseButton" Style="{StaticResource PolButton}" Content="USE THIS PICTURE" Margin="{StaticResource Footer.Gap}"
                            IsEnabled="False" Click="OnUse" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:AppWindow>
