<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:social="clr-namespace:Provenance.Common.Social;assembly=Provenance.Common"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
        xmlns:services="clr-namespace:Provenance.Wpf.Services"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditProfileViewModel}"
        Title="Edit your PlayOnline profile" Icon="/Assets/provenance.ico"
        Width="560" Height="780" MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow}"
        CloseOnEscape="False">

    <Window.Resources>
        <Style x:Key="ProfileLabel" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style x:Key="ProfileSection" TargetType="TextBlock" BasedOn="{StaticResource Section}">
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
        <Style x:Key="ProfileHelp" TargetType="TextBlock" BasedOn="{StaticResource Help}">
            <Setter Property="Margin" Value="2,6,0,0" />
        </Style>
        <!-- labels above, never a floating hint (it draws an ugly chip behind itself on this background) -->
        <Style x:Key="ProfileCombo" TargetType="ComboBox" BasedOn="{StaticResource FieldCombo}">
            <Setter Property="MaxDropDownHeight" Value="360" />
        </Style>
        <!-- the privacy choices as pills, with no ScrollViewer in the list. Its clip sits right on the first row's
             top line and eats it on a scaled screen -->
        <Style x:Key="Pills" TargetType="ListBox">
            <Setter Property="SelectedValuePath" Value="Code" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter Margin="2" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="SnapsToDevicePixels" Value="True" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Pill" Margin="0,0,8,6" Padding="16,7" CornerRadius="16" Cursor="Hand"
                                            BorderThickness="1" BorderBrush="{DynamicResource Border.Hair}"
                                            Background="{DynamicResource Surface.1}">
                                        <TextBlock x:Name="Txt" Text="{Binding Text}" FontSize="12.5"
                                                   Foreground="{DynamicResource Text.2}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Primary.Muted}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Primary.Muted}" />
                                            <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Text.1}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Pill" Property="Cursor" Value="Arrow" />
                                            <Setter TargetName="Pill" Property="Opacity" Value="0.75" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,*,Auto">
        <controls:TitleBar />

        <!-- the cards stay put while the form scrolls. A wheel over them scrolls them sideways -->
        <Border Grid.Row="1" Padding="20,16,20,4">
            <ScrollViewer x:Name="CardStrip" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="OnCardsWheel" Focusable="False">
                <ItemsControl ItemsSource="{Binding Cards}" Focusable="False" Margin="0,3,0,3" IsEnabled="{Binding CanSelectCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Margin="3,0" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileCard}">
                            <Button Style="{StaticResource RoundTab}" behaviours:State.IsCurrent="{Binding IsSelected}"
                                    Command="{Binding DataContext.SelectCardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Summary}"
                                    ToolTip="{Binding Summary}" ToolTipService.ShowOnDisabled="True">
                                <Grid Width="40" Height="40">
                                    <controls:ProfilePictureCircle Diameter="40" Source="{Binding Picture}"
                                                                   Visibility="{Binding IsHandle, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Visibility="{Binding IsHandle, Converter={StaticResource InvertBoolToVis}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{x:Static services:SvgIcons.XiBadgeRound}" Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Ellipse Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                                             Fill="{DynamicResource Primary}" Stroke="{DynamicResource Bg.Base}" StrokeThickness="2"
                                             ToolTip="Not saved yet" Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20,12,20,18"
                      IsEnabled="{Binding LoadingProfile, Converter={StaticResource InvertBool}}">
            <Grid>
            <StackPanel Visibility="{Binding IsXiCard, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding SelectedCard.Title}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SelectedCard.Subtitle}" FontSize="12.5" Foreground="{DynamicResource Text.3}" Margin="0,2,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,4"
                            Visibility="{Binding CardNote.Text, Converter={StaticResource NullToVisibilityConverter}}">
                    <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                                 Style="{StaticResource Spinner}"
                                 Visibility="{Binding CardLoading, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding CardNote.Text}" FontSize="12" TextWrapping="Wrap"
                               behaviours:State.IsError="{Binding CardNote.IsError}" Style="{StaticResource DimStatusText}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding SelectedCard.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5" ColumnDefinitions="120,*">
                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap" />
                                <TextBox Grid.Column="1" Style="{StaticResource SelectableText}" Text="{Binding Value, Mode=OneWay}" FontSize="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource ProfileHelp}" Margin="0,14,0,0"
                           Text="A character profile is visible unless that character is set as anonymous (/anon) within FINAL FANTASY XI." />
            </StackPanel>
            <StackPanel IsEnabled="{Binding CanEditFields}" Visibility="{Binding IsHandleCard, Converter={StaticResource BoolToVis}}">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- a button so the keyboard can reach it, drawn as just the picture -->
                    <Button VerticalAlignment="Top" Cursor="Hand" ToolTip="Change your profile picture" AutomationProperties.Name="Change your profile picture"
                            Command="{Binding ChangeProfilePictureCommand}" Foreground="{DynamicResource Text.1}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <!-- a ring for keyboard focus only, a click shows none -->
                                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingRound}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <controls:ProfilePictureCircle Diameter="76" Source="{Binding Avatar}" />
                            <ProgressBar Width="76" Height="76" IsHitTestVisible="False"
                                         Style="{StaticResource Spinner}"
                                         Visibility="{Binding ProfilePictureSaving, Converter={StaticResource BoolToVis}}" />
                            <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Surface.3}" BorderBrush="{DynamicResource Bg.Base}" BorderThickness="2">
                                <controls:SvgIcon Glyph="edit" Flat="True" Width="12" Height="12" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" Foreground="{DynamicResource Text.1}" />
                            </Border>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Handle name" Style="{StaticResource ProfileLabel}" />
                        <TextBox Style="{StaticResource FieldText}" MaxLength="{x:Static social:PolLimits.HandleName}"
                                 Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource ProfileHelp}"
                                   Text="This is the name your friends see, up to 15 English letters, numbers and symbols. They'll see a new name the next time their friend list loads." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Who can see your profile" Style="{StaticResource ProfileSection}" />
                <ListBox Style="{StaticResource Pills}" ItemsSource="{Binding VisibilityChoices}" SelectedValue="{Binding Level}"
                         AutomationProperties.Name="Who can see your profile" />
                <TextBlock Style="{StaticResource ProfileHelp}" Margin="0,0,0,0"
                           Text="{Binding VisibilityHelp}" />

                <TextBlock Text="About you" Style="{StaticResource ProfileSection}" />
                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel>
                        <TextBlock Text="Age" Style="{StaticResource ProfileLabel}" />
                        <TextBox Style="{StaticResource FieldText}" MaxLength="3" materialDesign:HintAssist.Hint="{Binding NotSet}"
                                 Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnDigitsOnly" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <CheckBox Content="Show an approximate age" Foreground="{DynamicResource Text.2}"
                                  IsChecked="{Binding ApproximateAge}"
                                  ToolTip="Others see your age group instead of your exact age." />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,14,*">
                    <StackPanel>
                        <TextBlock Text="Sex" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding SexChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Sex}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Job" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding JobChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Job1}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mail address" Style="{StaticResource ProfileLabel}" Margin="0,12,0,4" />
                <TextBox Style="{StaticResource FieldText}" MaxLength="319" materialDesign:HintAssist.Hint="No mail address"
                         Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource ProfileHelp}" Text="Leave it empty if you don't want to show a mail address." />

                <TextBlock Text="Location" Style="{StaticResource ProfileSection}" />
                <Grid DataContext="{Binding Location}" ColumnDefinitions="*,10,*,10,*">
                    <StackPanel>
                        <TextBlock Text="Region" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding Tops}" SelectedItem="{Binding Top}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Country" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding Mids}" SelectedItem="{Binding Mid}"
                                  IsEnabled="{Binding IsSet}" materialDesign:HintAssist.Hint="Choose" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Area" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding Leaves}" SelectedItem="{Binding Leaf}"
                                  DisplayMemberPath="Text" IsEnabled="{Binding IsSet}" materialDesign:HintAssist.Hint="Choose" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Languages" Style="{StaticResource ProfileSection}" />
                <Grid ColumnDefinitions="*,10,*,10,*">
                    <StackPanel>
                        <TextBlock Text="First" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang0}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Second" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang1}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Third" Style="{StaticResource ProfileLabel}" />
                        <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang2}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Interests" Style="{StaticResource ProfileSection}" />
                <StackPanel>
                    <StackPanel.Resources>
                        <DataTemplate x:Key="InterestRow" DataType="{x:Type vm:CascadePick}">
                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,10,*">
                                <ComboBox Style="{StaticResource ProfileCombo}" ItemsSource="{Binding Tops}" SelectedItem="{Binding Top}" />
                                <ComboBox Grid.Column="2" Style="{StaticResource ProfileCombo}" ItemsSource="{Binding Leaves}"
                                          SelectedItem="{Binding Leaf}" DisplayMemberPath="Text" IsEnabled="{Binding IsSet}"
                                          materialDesign:HintAssist.Hint="Choose" />
                            </Grid>
                        </DataTemplate>
                    </StackPanel.Resources>
                    <TextBlock Text="Interest 1" Style="{StaticResource ProfileLabel}" />
                    <ContentControl Content="{Binding Interest1}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                    <TextBlock Text="Interest 2" Style="{StaticResource ProfileLabel}" />
                    <ContentControl Content="{Binding Interest2}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                    <TextBlock Text="Interest 3" Style="{StaticResource ProfileLabel}" />
                    <ContentControl Content="{Binding Interest3}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- over the form while POL sends the profile. The form's disabled underneath too, so Tab can't get in either -->
        <Grid x:Name="LoadingOverlay" Grid.Row="2" Visibility="Collapsed" Opacity="0" IsHitTestVisible="{Binding LoadingProfile}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoadingProfile}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Rectangle Fill="{DynamicResource Bg.Base}" Opacity="0.82" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,14,24,14" CornerRadius="{StaticResource Radius.Panel}"
                    Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20" Foreground="{DynamicResource Primary}"
                                 Style="{StaticResource Spinner}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Loading your profile..." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource FooterBar}">
            <Grid ColumnDefinitions="*,Auto">
                <!-- the overlay has its own spinner while the profile loads -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding LoadingProfile, Converter={StaticResource InvertBoolToVis}}">
                    <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                                 Style="{StaticResource Spinner}"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"
                               Text="{Binding FooterText}" behaviours:State.IsError="{Binding FooterIsError}"
                               Style="{StaticResource StatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource PolButton}" Content="TRY AGAIN" Margin="0,0,8,0"
                            Command="{Binding RetryLoadCommand}" Visibility="{Binding CanRetryLoad, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PolButton}" Content="CLOSE" Click="OnClose" IsCancel="True" />
                    <Button Content="SAVE" Command="{Binding SaveCommand}" IsDefault="True" Margin="{StaticResource Footer.Gap}"
                            Style="{StaticResource PolButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</controls:AppWindow>
