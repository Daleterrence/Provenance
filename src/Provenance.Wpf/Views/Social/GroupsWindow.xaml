<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}"
        Title="Groups" Icon="/Assets/provenance.ico"
        Width="440" Height="600" MinWidth="360" MinHeight="360" WindowStartupLocation="CenterScreen"
        Style="{StaticResource AppWindow}">

    <Window.Resources>
        <Style x:Key="ClickRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Panel}" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.3}" />
                            </Trigger>
                            <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.3}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Focus.Ring}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press.Fill}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="16,12,0,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
        </Style>

        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Margin" Value="10,0,10,6" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
            <Setter Property="Background" Value="{DynamicResource Surface.2}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Hair}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid RowDefinitions="40,*">
        <controls:TitleBar x:Name="Bar" ShowMaximise="True">
            <Button Height="28" Margin="0,0,8,0" Padding="6,0,10,0" HorizontalAlignment="Right" Style="{StaticResource PolButton}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" FontSize="12"
                    IsEnabled="{Binding CanEditGroups}" Click="OnCreateGroup" AutomationProperties.Name="Create group">
                <StackPanel Orientation="Horizontal">
                    <controls:SvgIcon Glyph="groupchat2" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="CREATE GROUP" />
                </StackPanel>
            </Button>
        </controls:TitleBar>

        <Grid Grid.Row="1" Background="{DynamicResource Surface.1}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,56">
                    <StackPanel Visibility="{Binding Groups.HasInvites, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionHeader}">
                            <Run Text="GROUP INVITATIONS (" /><Run Text="{Binding Groups.Invites.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Groups.Invites}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource GroupCard}" Padding="12,10">
                                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                                            <controls:ProfilePictureCircle Diameter="36" Margin="0,0,12,0" VerticalAlignment="Top"
                                                                           Source="{Binding Avatar}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource Text.1}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Comment}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Text.3}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Style="{StaticResource PolButton}" FontSize="11" Height="26" Padding="10,0" Content="ACCEPT"
                                                        Click="OnAcceptInvite" AutomationProperties.Name="Accept group invitation"
                                                        IsEnabled="{Binding DataContext.CanEditGroups, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                <Button Style="{StaticResource PolButton}" FontSize="11" Height="26" Padding="10,0" Margin="8,0,0,0" Content="DECLINE"
                                                        Click="OnDeclineInvite" AutomationProperties.Name="Decline group invitation"
                                                        IsEnabled="{Binding DataContext.CanEditGroups, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionHeader}" Visibility="{Binding Groups.HasGroups, Converter={StaticResource BoolToVis}}">
                        <Run Text="GROUPS (" /><Run Text="{Binding Groups.Items.Count, Mode=OneWay}" /><Run Text=")" />
                    </TextBlock>

                    <TextBlock Margin="16,12" FontSize="12" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap"
                               Text="You're not in any friend groups yet. A group lets up to 64 friends see each other."
                               Visibility="{Binding Groups.NoGroups, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Groups.Items}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GroupCard}">
                                    <StackPanel>
                                        <Grid Background="Transparent" ContextMenuOpening="OnRowMenu">
                                            <Grid.ContextMenu>
                                                <ContextMenu />
                                            </Grid.ContextMenu>
                                            <Button Padding="0" Command="{Binding DataContext.OpenGroupChatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="Open this group's chat" AutomationProperties.Name="{Binding OpenText}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ClickRow}">
                                                        <Setter Property="IsEnabled" Value="{Binding DataContext.CanGroupChat, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanChat}" Value="False">
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid Margin="40,9,44,9" ColumnDefinitions="Auto,*,Auto">
                                                    <controls:SvgIcon Glyph="groupchat2" Flat="True" Width="22" Height="22" Margin="0,0,10,0"
                                                                      Foreground="{DynamicResource Text.3}" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text.1}" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding RoleText, Mode=OneWay}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Text.3}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource Text.3}" />
                                                        <TextBlock Text="{Binding MyComment}" FontSize="12" FontStyle="Italic" Margin="0,1,0,0"
                                                                   Foreground="{DynamicResource Text.2}" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="Your comment in this group"
                                                                   Visibility="{Binding HasMyComment, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="2" Style="{StaticResource CountBadge}" Margin="8,0,0,0"
                                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Unread}" Style="{StaticResource CountBadgeText}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <Button HorizontalAlignment="Left" VerticalAlignment="Center" Width="28" Height="28" Padding="0" Margin="8,0,0,0"
                                                    Foreground="{DynamicResource Text.3}"
                                                    Command="{Binding DataContext.Groups.ToggleMembersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Setter Property="AutomationProperties.Name" Value="Show members" />
                                                        <Setter Property="ToolTip" Value="Show members" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                <Setter Property="AutomationProperties.Name" Value="Hide members" />
                                                                <Setter Property="ToolTip" Value="Hide members" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <controls:SvgIcon Flat="True" Width="12" Height="12">
                                                    <controls:SvgIcon.Style>
                                                        <Style TargetType="controls:SvgIcon">
                                                            <Setter Property="Glyph" Value="right" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Expanded}" Value="True">
                                                                    <Setter Property="Glyph" Value="down" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </controls:SvgIcon.Style>
                                                </controls:SvgIcon>
                                            </Button>
                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                                    Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.3}"
                                                    AutomationProperties.Name="Group actions" Click="OnRowMenuButton">
                                                <controls:SvgIcon Glyph="more" Width="20" Height="20" />
                                            </Button>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Members}" Margin="0,0,0,6" IsTabStop="False"
                                                      Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="44,3,16,3" Background="Transparent"
                                                          ColumnDefinitions="Auto,*,Auto"
                                                          ContextMenuOpening="OnRowMenu">
                                                        <Grid.ContextMenu>
                                                            <ContextMenu />
                                                        </Grid.ContextMenu>
                                                        <controls:ProfilePictureCircle Diameter="30" Margin="0,0,10,0"
                                                                                       Source="{Binding Avatar}" />
                                                        <Button Grid.Column="2" Width="28" Height="28" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Foreground="{DynamicResource Text.3}" AutomationProperties.Name="Member actions" Click="OnRowMenuButton">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Me}" Value="True">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <controls:SvgIcon Glyph="more" Width="20" Height="20" />
                                                        </Button>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="13" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding RoleText, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Text.3}" />
                                                            </TextBlock>
                                                            <DockPanel>
                                                                <controls:StatusMark DockPanel.Dock="Left" Status="{Binding Status}" Online="{Binding ShowsStatus}" Margin="0,0,6,0" />
                                                                <TextBlock FontSize="11" Foreground="{DynamicResource Text.3}" TextTrimming="CharacterEllipsis">
                                                                    <Run Text="{Binding StatusLabel, Mode=OneWay}" /><Run Text="{Binding Comment, Mode=OneWay, StringFormat={}   {0}}" />
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <Border VerticalAlignment="Bottom" Margin="10" Padding="12,8" CornerRadius="{StaticResource Radius.Panel}"
                    Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1"
                    Visibility="{Binding EditStatusShown, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="14" Height="14" Margin="0,0,8,0"
                                 Style="{StaticResource Spinner}"
                                 Visibility="{Binding Saving, Converter={StaticResource BoolToVis}}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="300" Text="{Binding EditStatus}" />
                    <Button Width="22" Height="22" Padding="0" Margin="8,0,0,0" VerticalAlignment="Top"
                            Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.3}"
                            Command="{Binding DismissEditNoteCommand}" AutomationProperties.Name="Dismiss"
                            Visibility="{Binding EditNoteShown, Converter={StaticResource BoolToVis}}">
                        <controls:SvgIcon Glyph="dismiss" Width="12" Height="12" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</controls:AppWindow>
