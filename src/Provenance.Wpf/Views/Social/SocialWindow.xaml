<controls:AppWindow x:Class="Provenance.Wpf.Views.Social.SocialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:social="clr-namespace:Provenance.Common.Social;assembly=Provenance.Common"
        xmlns:local="clr-namespace:Provenance.Wpf.Views.Social"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Social"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}"
        Title="Friends" Icon="/Assets/provenance.ico"
        Width="400" Height="640" MinWidth="360" MinHeight="480" WindowStartupLocation="CenterOwner"
        Style="{StaticResource AppWindow}">

    <Grid RowDefinitions="40,*">
        <controls:TitleBar x:Name="Bar" ShowMaximise="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddFriendButton" Height="28" Margin="0,0,8,0" Padding="6,0,10,0" Style="{StaticResource PolButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        IsEnabled="{Binding CanEdit}" Click="OnAddFriend" AutomationProperties.Name="Search PlayOnline and send a friend request">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Glyph="search" />
                        <TextBlock Text="ADD A FRIEND" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MessagesToggle" Width="44" Height="40" Padding="0" Foreground="{DynamicResource Text.2}"
                        Style="{StaticResource IconButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnToggleMessages"
                        IsEnabled="{Binding CanToggleMessages}" ToolTip="{Binding MessagesToggleText}"
                        AutomationProperties.Name="{Binding MessagesToggleText}">
                    <materialDesign:PackIcon Kind="DockRight" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </controls:TitleBar>

        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FriendsColumn" Width="*" MinWidth="360" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition x:Name="MessagesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="FriendsPart" Background="{DynamicResource Surface.1}" RowDefinitions="Auto,Auto,*,Auto">
                <Expander Grid.Row="3" Background="{DynamicResource Surface.1}" BorderBrush="{DynamicResource Border.Pane}"
                          BorderThickness="0,1,0,0" Padding="8,0,8,8"
                          Visibility="{Binding HasBlocked, Converter={StaticResource BoolToVis}}">
                    <Expander.Header>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}"
                                   ToolTip="You don't get messages from anyone on this list.">
                            <Run Text="Ignored (" /><Run Text="{Binding Blocked.Count, Mode=OneWay}" /><Run Text=")" />
                        </TextBlock>
                    </Expander.Header>
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Blocked}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,2" ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="all their handles" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text.3}"
                                                       ToolTip="Every handle on this person's PlayOnline ID is ignored, not just this one."
                                                       Visibility="{Binding AllHandles, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PolButton}" FontSize="11" Height="26"
                                                Padding="8,0" Content="STOP IGNORING" Click="OnUnignore"
                                                IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Expander>

                <StackPanel Margin="14,12,14,8">
                    <Grid ColumnDefinitions="Auto,*">
                        <Grid>
                            <local:MyProfilePicture Diameter="52" />
                            <ProgressBar Width="52" Height="52" IsHitTestVisible="False"
                                         Style="{StaticResource Spinner}"
                                         Visibility="{Binding ProfilePictureSaving, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="{Binding AccountName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <local:EditProfileButton Grid.Column="1" HorizontalAlignment="Left" Margin="6,0,0,0" IsEnabled="{Binding LoggedIn}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <ComboBox AutomationProperties.Name="Status" Style="{StaticResource StatusPicker}" VerticalAlignment="Center"
                                          IsEnabled="{Binding StatusEditable}"
                                          ItemsSource="{Binding StatusItems}" SelectedIndex="{Binding MyStatusIndex}" />
                                <ProgressBar Width="12" Height="12" Margin="6,0,0,0"
                                             Style="{StaticResource Spinner}"
                                             ToolTip="{Binding StatusPendingText}" AutomationProperties.Name="{Binding StatusPendingText}"
                                             Visibility="{Binding StatusPending, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text.3}" />
                            </StackPanel>
                            <Border Margin="0,1,0,0" BorderThickness="0,0,0,1" IsEnabled="{Binding CanEdit}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Text.3}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="BorderBrush" Value="Transparent" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox AutomationProperties.Name="Comment" x:Name="CommentBox" Padding="0,2" FontSize="12" FontStyle="Italic" MaxLength="{x:Static social:PolLimits.Comment}"
                                             Style="{StaticResource PlainField}" BorderThickness="0"
                                             Foreground="{DynamicResource Text.2}"
                                             materialDesign:HintAssist.Hint="Add a comment" materialDesign:HintAssist.IsFloating="False"
                                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                             Text="{Binding MyComment, Mode=OneWay}"
                                             ToolTip="Your friends see this comment. Press Enter to save it, or press Esc or click away to cancel."
                                             KeyDown="OnCommentKey" GotKeyboardFocus="OnCommentFocus" LostKeyboardFocus="OnCommentLostFocus" />
                                    <controls:SvgIcon Grid.Column="1" Glyph="edit" Flat="True" Width="12" Height="12" Margin="4,0,2,0"
                                                      VerticalAlignment="Center" Foreground="{DynamicResource Text.3}" Cursor="Hand"
                                                      Background="Transparent" MouseLeftButtonUp="OnCommentPencil">
                                        <controls:SvgIcon.Style>
                                            <Style TargetType="controls:SvgIcon">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=CommentBox}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </controls:SvgIcon.Style>
                                    </controls:SvgIcon>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <local:ZoneTroubleBanner Margin="0,10,0,0" Active="{Binding ZoneTrouble}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="14,0,14,0" ColumnDefinitions="Auto,Auto,*">
                    <Button x:Name="FriendsTab" Style="{StaticResource UnderlineTab}" Content="Friends" Click="OnFriendsTab"
                            behaviours:State.IsCurrent="{Binding RequestsTab, Converter={StaticResource InvertBool}}" />
                    <Button x:Name="RequestsTabButton" Grid.Column="1" Style="{StaticResource UnderlineTab}" Click="OnRequestsTab"
                            behaviours:State.IsCurrent="{Binding RequestsTab}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Requests" VerticalAlignment="Center" />
                            <Border Style="{StaticResource CountBadge}" Margin="6,0,0,0" Height="16" MinWidth="16"
                                    Visibility="{Binding HasPendingAnswers, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PendingAnswers}" Style="{StaticResource CountBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Grid.ColumnSpan="3" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Border.Pane}" Panel.ZIndex="-1" />
                </Grid>
                <Grid Grid.Row="2">
                    <local:FriendsList x:Name="FriendList"
                                       Visibility="{Binding RequestsTab, Converter={StaticResource InvertBoolToVis}}" />
                    <local:RequestsList x:Name="RequestList"
                                        Visibility="{Binding RequestsTab, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <GridSplitter x:Name="PartSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" AutomationProperties.HelpText="Drag to resize"
                          Visibility="Collapsed" DragCompleted="OnPaneDragged" />

            <local:ConversationView x:Name="Conversation" Grid.Column="2" Background="{DynamicResource Bg.Base}" DataContext="{Binding Messages}"
                                    Visibility="Collapsed" />
        </Grid>
    </Grid>
</controls:AppWindow>
