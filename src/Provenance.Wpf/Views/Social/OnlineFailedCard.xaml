<UserControl x:Class="Provenance.Wpf.Views.Social.OnlineFailedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Border Padding="14,10" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Pop.Info.Fill}"
            BorderBrush="{DynamicResource Pop.Info.Border}" BorderThickness="1">
        <Grid ColumnDefinitions="Auto,*">
            <materialDesign:PackIcon Kind="InformationOutline" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Top"
                                     Foreground="{DynamicResource Pop.Info.Icon}" />
            <TextBlock x:Name="Message" Grid.Column="1" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Pop.Info.Text}"
                       Text="Something went wrong getting you online. Your friends list hasn't loaded as a result, please log out and back in to try again." />
        </Grid>
    </Border>
</UserControl>
