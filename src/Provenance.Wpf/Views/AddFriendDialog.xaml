<Window x:Class="Provenance.Wpf.Views.AddFriendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        xmlns:local="clr-namespace:Provenance.Wpf.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SocialViewModel}"
        Title="Add a friend" Icon="/Assets/provenance.ico"
        Width="460" Height="520" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- what the search goes by, underlined like the profile window's tabs -->
        <Style x:Key="SearchKindTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Line" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="10,0" Height="30">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Line" Property="BorderBrush" Value="{DynamicResource Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Surface.1}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Line" Property="Background" Value="{DynamicResource Surface.1}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,*,Auto">
        <Grid Background="{DynamicResource Surface.1}">
            <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Text="Add a friend" />
            <Button HorizontalAlignment="Right" Width="44" Height="40" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="16,8,16,6">
            <StackPanel Orientation="Horizontal" Margin="-10,0,0,8" IsEnabled="{Binding SearchBusy, Converter={StaticResource InvertBool}}">
                <RadioButton Style="{StaticResource SearchKindTab}" GroupName="SearchKind" Content="Handle"
                             IsChecked="{Binding SearchByHandle}" Checked="OnKindPicked" />
                <RadioButton Style="{StaticResource SearchKindTab}" GroupName="SearchKind" Content="H-ID"
                             IsChecked="{Binding SearchByHid}" Checked="OnKindPicked" />
                <RadioButton Style="{StaticResource SearchKindTab}" GroupName="SearchKind" Content="Character"
                             IsChecked="{Binding SearchByCharacter}" Checked="OnKindPicked" />
            </StackPanel>
            <TextBlock FontSize="12" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap" Text="{Binding SearchIntro}" />
            <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <TextBox x:Name="NameBox" FontSize="13" Height="40" Padding="10,6" MaxLength="{Binding SearchMaxLength}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="{Binding SearchHint}" materialDesign:HintAssist.IsFloating="False"
                         AutomationProperties.Name="{Binding SearchHint}" KeyDown="OnNameKey" />
                <Button Grid.Column="1" Margin="10,0,0,0" Height="40" Content="SEARCH" Click="OnSearch"
                        Style="{StaticResource AccentRaisedButton}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                <ProgressBar Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Value="0"
                             Style="{StaticResource MaterialDesignCircularProgressBar}"
                             Visibility="{Binding SearchBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="400" Text="{Binding SearchNote}"
                           Tag="{Binding SearchNoteIsError}" Style="{StaticResource DimStatusText}" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="Hits" Grid.Row="2" Margin="10,4" ItemsSource="{Binding SearchHits}"
                 HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,3" ColumnDefinitions="Auto,*">
                        <local:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" Source="{Binding Avatar}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource Text.3}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3" Padding="16,10" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CLOSE" Margin="0,0,8,0" Click="OnClose" />
                <Button x:Name="SendButton" Content="SEND FRIEND REQUEST" Click="OnSend"
                        Style="{StaticResource AccentRaisedButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
