<controls:AppWindow x:Class="Provenance.Wpf.Views.Main.AccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Accounts" Icon="/Assets/provenance.ico"
        Width="460" Height="520" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow.Fixed}">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*,Auto">
        <controls:TitleBar />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,6">
                <TextBlock Text="You haven't added any accounts yet."
                           Style="{StaticResource ShowWhenZero}" behaviours:State.Count="{Binding Rows.Count}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <controls:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                   Source="{Binding Picture}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="2" Content="EDIT" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource PolButton}"
                                            Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Account}" AutomationProperties.Name="{Binding Name, StringFormat=Edit {0}}" />
                                    <Button Grid.Column="3" Content="REMOVE" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource PolButton}"
                                            Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Account}" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource PolButton}" Content="ADD ACCOUNT" Command="{Binding AddAccountCommand}" />
                    <Button Margin="{StaticResource Footer.Gap}" Style="{StaticResource PolButton}" Content="ORDER"
                            IsEnabled="{Binding CanOrder}" Click="OnOrder" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource PolButton}" Content="CLOSE" Click="OnClose" />
            </Grid>
        </Border>
    </Grid>
</controls:AppWindow>
