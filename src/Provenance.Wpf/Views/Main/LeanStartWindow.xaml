<controls:AppWindow x:Class="Provenance.Wpf.Views.Main.LeanStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="380" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        CloseOnEscape="False"
        Style="{StaticResource DialogCard}">

    <StackPanel Margin="22,20,22,18">
        <Grid ColumnDefinitions="Auto,*">
            <Image Source="/Assets/provenance-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding ProgressTitle}" Margin="12,0,0,0" VerticalAlignment="Center"
                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Grid>

        <TextBlock x:Name="StepText" Margin="0,16,0,8" FontSize="13" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap"
                   Text="{Binding ProgressText}" MinHeight="36" />
        <ProgressBar x:Name="Bar" Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                     Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}"
                     materialDesign:TransitionAssist.DisableTransitions="False" />
        <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
            <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding TimeLeftText}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding ElapsedText}" />
        </Grid>
        <TextBlock x:Name="NoticeText" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Text.3}" TextWrapping="Wrap"
                   Text="{Binding Notice.Current.Text}"
                   Visibility="{Binding Notice.Current, Converter={StaticResource NullToVisibilityConverter}}" />
        <Button Margin="0,18,0,0" Height="36" FontSize="13" Command="{Binding CancelLaunchCommand}"
                Style="{StaticResource RedActionButton}" Content="CANCEL" />
    </StackPanel>
</controls:AppWindow>
