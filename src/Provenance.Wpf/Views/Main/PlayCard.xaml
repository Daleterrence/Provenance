<UserControl x:Class="Provenance.Wpf.Views.Main.PlayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:socialViews="clr-namespace:Provenance.Wpf.Views.Social">
    <Grid Margin="14,14,14,18" RowDefinitions="Auto,*,Auto">
        <socialViews:FeedFaultBanner Margin="8,0,4,10" Visibility="{Binding Social.GameFeedFault, Converter={StaticResource BoolToVis}}" />
        <DockPanel Grid.Row="1" IsEnabled="{Binding FriendsLocked, Converter={StaticResource InvertBool}}" Style="{StaticResource DimWhenOff}">
            <TextBlock DockPanel.Dock="Top" Margin="8,0,4,8" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                <Run Text="Friends" /><Run Text="   " /><Run Text="{Binding Social.Summary, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Text.3}" />
            </TextBlock>
            <socialViews:ZoneTroubleBanner DockPanel.Dock="Top" Margin="8,0,4,8"
                                           Active="{Binding Social.ZoneTrouble}" />
            <socialViews:FriendsList x:Name="FriendList" DataContext="{Binding Social}" OwnSelection="True" FriendActivated="OnFriendActivated" />
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="8,10,8,0">
            <Border Height="1" Margin="-22,0,-22,16" Background="{DynamicResource Border.Pane}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource State.Down}" Text="{Binding Social.PlayBlockedReason}"
                       Visibility="{Binding Social.PlayBlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Text.2}" Text="{Binding Social.AccountNotice}"
                       Visibility="{Binding Social.AccountNotice, Converter={StaticResource NullToVisibilityConverter}}" />
            <Border Height="52">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ActionShell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=PlayButton}" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button x:Name="PlayButton" Command="{Binding PlayCommand}" IsEnabled="{Binding PlayEnabled}" IsDefault="True"
                            Style="{StaticResource ActionSegment}" AutomationProperties.Name="{Binding PlayName}">
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding PlayPlatform.Subtitle}" FontSize="9" FontWeight="SemiBold" Opacity="0" Margin="0,0,0,-3"
                                       HorizontalAlignment="Center" AutomationProperties.Name=""
                                       Visibility="{Binding PlayPlatform.Subtitle, Converter={StaticResource NullToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:SvgIcon Glyph="sword" Width="20" Height="20" Margin="3,0,10,0" />
                                <TextBlock Text="{Binding PlayText}" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlayPlatform.Subtitle}" FontSize="9" FontWeight="SemiBold" Opacity="0.8" Margin="0,-3,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding PlayPlatform.Subtitle, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Width="1"
                            Visibility="{Binding PlayPlatform.HasChoices, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Play.Fill}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Play.Sheen}" />
                                <Setter Property="BorderThickness" Value="{DynamicResource Btn.Sheen.Width}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=PlayButton}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Btn.Disabled.Fill}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Rectangle Margin="0,9" Fill="{DynamicResource Play.Divider}" />
                    </Border>
                    <Button Grid.Column="2" Width="52" Click="OnPlayChoices" IsEnabled="{Binding PlayEnabled}"
                            Style="{StaticResource ActionSegment}"
                            ToolTip="{Binding PlayPlatform.ChoicesTitle}" AutomationProperties.Name="{Binding PlayPlatform.ChoicesTitle}"
                            Visibility="{Binding PlayPlatform.HasChoices, Converter={StaticResource BoolToVis}}">
                        <controls:SvgIcon x:Name="PlayChoicesIcon" Glyph="list" Width="20" Height="20" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
