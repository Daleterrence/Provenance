<UserControl x:Class="Provenance.Wpf.Views.Main.PlayCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:socialViews="clr-namespace:Provenance.Wpf.Views.Social">
    <Grid Margin="14,14,14,18" RowDefinitions="Auto,*,Auto">
        <TextBlock Margin="8,0,4,8" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
            <Run Text="Friends" /><Run Text="   " /><Run Text="{Binding Social.Summary, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource Text.3}" />
        </TextBlock>
        <socialViews:FriendsList Grid.Row="1" DataContext="{Binding Social}" OwnSelection="True" FriendActivated="OnFriendActivated" />
        <StackPanel Grid.Row="2" Margin="8,10,8,0">
            <!-- edge to edge of the card, so Play reads as its own thing and not part of the list -->
            <Border Height="1" Margin="-22,0,-22,16" Background="{DynamicResource Border.Pane}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource State.Down}" Text="{Binding Social.PlayBlockedReason}"
                       Visibility="{Binding Social.PlayBlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" TextAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource Text.2}" Text="{Binding Social.AccountNotice}"
                       Visibility="{Binding Social.AccountNotice, Converter={StaticResource NullToVisibilityConverter}}" />
            <Border Height="52">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource ActionShell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled, ElementName=PlayButton}" Value="False">
                                <Setter Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Effect" Value="{x:Null}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid ColumnDefinitions="*,Auto,Auto">
                    <Button x:Name="PlayButton" Command="{Binding PlayCommand}" IsEnabled="{Binding Social.CanPlay}" IsDefault="True"
                            Style="{StaticResource ActionSegment}" AutomationProperties.Name="Play">
                        <!-- an invisible copy of the line above Play keeps Play in the middle, nudged up a touch -->
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding PlaySubtitle}" FontSize="9" FontWeight="SemiBold" Opacity="0" Margin="0,0,0,-4"
                                       HorizontalAlignment="Center" AutomationProperties.Name=""
                                       Visibility="{Binding PlaySubtitle, Converter={StaticResource NullToVisibilityConverter}}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:SvgIcon Glyph="sword" Width="18" Height="18" Margin="3,0,10,0" />
                                <TextBlock Text="PLAY" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding PlaySubtitle}" FontSize="9" FontWeight="SemiBold" Opacity="0.8" Margin="0,-4,0,0"
                                       HorizontalAlignment="Center"
                                       Visibility="{Binding PlaySubtitle, Converter={StaticResource NullToVisibilityConverter}}" />
                        </StackPanel>
                    </Button>
                    <Border Grid.Column="1" Width="1"
                            Visibility="{Binding HasPlayChoices, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Play.Fill}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Play.Sheen}" />
                                <Setter Property="BorderThickness" Value="{DynamicResource Btn.Sheen.Width}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnabled, ElementName=PlayButton}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Btn.Disabled.Fill}" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Rectangle Margin="0,9" Fill="{DynamicResource Play.Divider}" />
                    </Border>
                    <Button Grid.Column="2" Width="52" Click="OnPlayChoices" IsEnabled="{Binding Social.CanPlay}"
                            Style="{StaticResource ActionSegment}"
                            ToolTip="{Binding PlayChoicesTitle}" AutomationProperties.Name="{Binding PlayChoicesTitle}"
                            Visibility="{Binding HasPlayChoices, Converter={StaticResource BoolToVis}}">
                        <controls:SvgIcon x:Name="PlayChoicesIcon" Glyph="list" Width="22" Height="22" />
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
