<UserControl x:Class="Provenance.Wpf.Views.Main.LaunchCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="MainResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="28,24" VerticalAlignment="Center">
        <StackPanel>
            <Image Source="{StaticResource BgLogo}" OpacityMask="{DynamicResource Logo.Mask}" Height="120" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Margin="0,10,0,0" FontSize="17" FontWeight="SemiBold" Text="{Binding ProgressTitle}"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
            <TextBlock Margin="0,18,0,8" FontSize="14" Foreground="{DynamicResource Text.2}" TextWrapping="Wrap"
                       TextAlignment="Center" Text="{Binding ProgressText}" MinHeight="40" />
            <ProgressBar Height="6" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                         Foreground="{DynamicResource Primary}" Background="{DynamicResource Surface.1}"
                         materialDesign:TransitionAssist.DisableTransitions="False" />
            <Grid Margin="0,6,0,0" ColumnDefinitions="*,Auto">
                <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding TimeLeftText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource Text.3}" Text="{Binding ElapsedText}" />
            </Grid>
            <Button Margin="0,22,0,0" Height="40" FontSize="14" Command="{Binding CancelLaunchCommand}"
                    Style="{StaticResource RedActionButton}" Content="CANCEL" />
        </StackPanel>
    </Grid>
</UserControl>
