<controls:AppWindow x:Class="Provenance.Wpf.Views.Main.AccountOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Account order" Icon="/Assets/provenance.ico"
        Width="400" Height="460" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource AppWindow.Fixed}">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*,Auto">
        <controls:TitleBar />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="16,16,16,6">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16,8" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <controls:ProfilePictureCircle Diameter="32" Margin="0,0,12,0" VerticalAlignment="Center"
                                                               Source="{Binding Picture}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Button Width="30" Height="30" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                            IsEnabled="{Binding CanMoveUp}" ToolTip="Move up"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Move {0} up}">
                                        <controls:SvgIcon Glyph="up" Width="20" Height="20" />
                                    </Button>
                                    <Button Width="30" Height="30" Padding="0" Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                            IsEnabled="{Binding CanMoveDown}" ToolTip="Move down"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding Name, StringFormat=Move {0} down}">
                                        <controls:SvgIcon Glyph="down" Width="20" Height="20" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2" Style="{StaticResource FooterBar}">
            <Button HorizontalAlignment="Right" Style="{StaticResource PolButton}" Content="CLOSE" Click="OnClose" />
        </Border>
    </Grid>
</controls:AppWindow>
