<controls:AppWindow x:Class="Provenance.Wpf.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        xmlns:local="clr-namespace:Provenance.Wpf.Views.Main"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels.Main"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="1000" Height="640" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Style="{StaticResource AppWindow.Fixed}"
        CloseOnEscape="False">

    <Window.Resources>
        <!-- decoded once near the size shown, the source is 256x256 -->
        <BitmapImage x:Key="TitleIcon" UriSource="/Assets/provenance-256.png" DecodePixelWidth="64" />
    </Window.Resources>

    <Grid RowDefinitions="40,Auto,*,Auto">
        <Border Grid.Row="2" VerticalAlignment="Top" Height="160" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="{DynamicResource Bg.Glow}" Offset="0" />
                    <GradientStop Color="{DynamicResource Bg.Glow}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="Transparent" Offset="1" />
                </LinearGradientBrush>
            </Border.OpacityMask>
        </Border>

        <controls:TitleBar Title="PROVENANCE" Icon="{StaticResource TitleIcon}" TitleSize="13" DimTitle="True" GlyphSize="17"
                           CloseToolTip="{Binding CloseTooltip}" CloseName="{Binding CloseName}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="WorldsChip" Style="{x:Null}" VerticalAlignment="Center"
                        Margin="0,0,6,0" Cursor="Hand" Padding="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnWorldsChip"
                        AutomationProperties.Name="FINAL FANTASY XI world status (PlayOnline Server Status)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="11" Padding="10,3" Background="{DynamicResource Surface.2}"
                                    BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                 Style="{StaticResource WorldDot}" behaviours:State.Status="{Binding News.WorldsState}" />
                        <TextBlock Text="{Binding News.WorldsSummary}" FontSize="12" Foreground="{DynamicResource Text.2}" VerticalAlignment="Center" />
                        <controls:SvgIcon Glyph="down" Flat="True" Width="14" Height="14" Margin="6,0,0,0"
                                          VerticalAlignment="Center" Foreground="{DynamicResource Text.3}" />
                    </StackPanel>
                </Button>
                <Button Width="44" Height="40" Padding="0"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Settings" AutomationProperties.Name="Settings">
                    <controls:SvgIcon Glyph="settings" Flat="True" Width="17" Height="17" />
                </Button>
                <Button Width="44" Height="40" Padding="0"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimize" AutomationProperties.Name="Minimise">
                    <materialDesign:PackIcon Kind="WindowMinimize" Width="17" Height="17" />
                </Button>
            </StackPanel>
        </controls:TitleBar>

        <!-- out of the title bar, which has its own colours for what sits on it -->
        <Popup x:Name="WorldsPopup" StaysOpen="False" PlacementTarget="{Binding ElementName=WorldsChip}"
               Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" PopupAnimation="Fade">
            <Border CornerRadius="{StaticResource Radius.Panel}" Padding="14,10" Background="{DynamicResource Surface.2}" MinWidth="240"
                    BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="World status" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding News.Worlds}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,16,2" ToolTip="{Binding Label}">
                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                             Style="{StaticResource WorldDot}" behaviours:State.Status="{Binding Status}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource Text.2}" />
                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource Text.3}" Text="{Binding OnlineText}"
                                               Visibility="{Binding OnlineText, Converter={StaticResource NullToVisibilityConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding News.WorldsCheckedText}"
                               Visibility="{Binding News.WorldsCheckedText, Converter={StaticResource NullToVisibilityConverter}}" />
                    <Button Margin="0,6,0,0" FontSize="12" Style="{StaticResource LinkButton}"
                            Command="{Binding News.OpenServerStatusCommand}" AutomationProperties.Name="Open PlayOnline Server Status">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open PlayOnline Server Status" VerticalAlignment="Center" />
                            <controls:SvgIcon Glyph="right" Flat="True" Width="14" Height="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <Border Grid.Row="1" Padding="24,9" Background="{DynamicResource Surface.2}"
                BorderBrush="{DynamicResource Border.Pane}" BorderThickness="0,0,0,1"
                Visibility="{Binding GameOpen, Converter={StaticResource BoolToVis}}">
            <Grid ColumnDefinitions="Auto,*">
                <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                         Foreground="{DynamicResource State.Warn}" />
                <TextBlock Grid.Column="1" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource Text.1}"
                           Text="You cannot use any PlayOnline or social features of Provenance whilst logged into the game." />
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="1.5*,400">
            <local:NewsCard />

            <Grid Grid.Column="1" Margin="0,24,24,24">
                <!-- the shadow's on its own empty Border, so the blur isn't redrawn every frame of the spinner -->
                <Border CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.2}" IsHitTestVisible="False"
                        Effect="{DynamicResource Shadow.Panel}" />
                <Border CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.2}"
                        BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                    <Grid>
                        <local:InstallCard Visibility="{Binding ShowInstallCard, Converter={StaticResource BoolToVis}}" />
                        <local:AccountCard Visibility="{Binding ShowLogInCard, Converter={StaticResource BoolToVis}}" />
                        <local:SetupCard Visibility="{Binding ShowSetupCard, Converter={StaticResource BoolToVis}}" />
                        <local:PlayCard Visibility="{Binding ShowFriendsCard, Converter={StaticResource BoolToVis}}" />
                        <local:LaunchCard Visibility="{Binding ShowLaunchCard, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Panel.ZIndex="10" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="24,0,0,18"
                MaxWidth="560" Padding="14,10" CornerRadius="{StaticResource Radius.Panel}"
                Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Primary}" BorderThickness="1"
                Visibility="{Binding Notice.Current, Converter={StaticResource NullToVisibilityConverter}}"
                MouseLeftButtonUp="OnOpenNotice" MouseEnter="OnNoticeHover" MouseLeave="OnNoticeLeave"
                Effect="{DynamicResource Shadow.Notice}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Cursor" Value="Hand" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Notice.Current.Opens}" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <controls:SvgIcon Glyph="mail" Flat="True" Width="20" Height="20" Margin="0,0,10,0"
                                  VerticalAlignment="Center" Foreground="{DynamicResource Primary}">
                    <controls:SvgIcon.Style>
                        <Style TargetType="controls:SvgIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice.Current.Icon}" Value="mail">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </controls:SvgIcon.Style>
                </controls:SvgIcon>
                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource Primary}">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="{Binding Notice.Current.Icon}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Notice.Current.Icon}" Value="mail">
                                    <Setter Property="Kind" Value="BellOutline" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <!-- the text's a button too, so Tab and Enter can open the notice -->
                <Button Grid.Column="1" Style="{x:Null}" Click="OnOpenNotice" VerticalAlignment="Center"
                        Cursor="{Binding Cursor, RelativeSource={RelativeSource AncestorType=Border}}"
                        KeyboardNavigation.AcceptsReturn="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <TextBlock x:Name="Label" Text="{Binding Notice.Current.Text}" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.1}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Width="26" Height="26" Padding="0" Margin="10,0,0,0"
                        Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.3}"
                        Command="{Binding Notice.DismissCommand}" AutomationProperties.Name="Dismiss">
                    <controls:SvgIcon Glyph="dismiss" Width="14" Height="14" />
                </Button>
            </Grid>
        </Border>

        <local:SocialFooter Grid.Row="3" Visibility="{Binding LoggedIn, Converter={StaticResource BoolToVis}}" />
    </Grid>
</controls:AppWindow>
