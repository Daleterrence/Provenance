<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <!-- Enter opens the link instead of falling through to sign in or play -->
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- only on the signed-out cards, a signed-in pol.exe keeps the files a repair replaces open -->
    <Style x:Key="RepairButton" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="5,0,10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Command" Value="{Binding Repair.StartCommand}" />
        <Setter Property="Visibility" Value="{Binding Repair.Available, Converter={StaticResource BoolToVis}}" />
        <Setter Property="ToolTip" Value="{Binding Repair.Tooltip}" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="Repair game files" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Glyph="ring" Width="20" Height="20"
                                          IsOpen="{Binding DataContext.Repair.Repairing, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="REPAIR GAME FILES" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RepairReason" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Text" Value="{Binding Repair.BlockedReason}" />
        <Setter Property="Visibility" Value="{Binding Repair.BlockedReason, Converter={StaticResource NullToVisibilityConverter}}" />
    </Style>
</ResourceDictionary>
