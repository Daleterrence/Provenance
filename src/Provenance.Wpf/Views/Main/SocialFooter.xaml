<UserControl x:Class="Provenance.Wpf.Views.Main.SocialFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:social="clr-namespace:Provenance.Wpf.Views.Social">
    <Border Height="44" Style="{StaticResource FooterBar}" Padding="16,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding GameOpen, Converter={StaticResource InvertBool}}">
                <!-- the button and the picker after these grey themselves, so only the picture and the name are dimmed here -->
                <StackPanel Orientation="Horizontal" Style="{StaticResource DimWhenOff}">
                    <social:MyProfilePicture x:Name="MyPicture" Diameter="32" Margin="0,0,10,0" DataContext="{Binding Social}"
                                             ToolTip="Change your profile picture. Right-click to switch handle."
                                             ContextMenuOpening="OnHandleMenu">
                        <social:MyProfilePicture.ContextMenu>
                            <ContextMenu />
                        </social:MyProfilePicture.ContextMenu>
                    </social:MyProfilePicture>
                    <TextBlock Text="{Binding Social.AccountName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <social:EditProfileButton Margin="4,0,0,0" VerticalAlignment="Center" DataContext="{Binding Social}" />
                <!-- locked with a spinner until POL confirms -->
                <ComboBox Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPicker}"
                          IsEnabled="{Binding Social.StatusEditable}"
                          ItemsSource="{Binding Social.StatusItems}" SelectedIndex="{Binding Social.MyStatusIndex}" />
            </StackPanel>
            <!-- left aligned, so the spinner sits right after the note and the note trims before it reaches the buttons -->
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Visibility="{Binding GameOpen, Converter={StaticResource InvertBoolToVis}}">
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource State.Warn}"
                           Text="{Binding Social.StatusNote}" ToolTip="{Binding Social.StatusNote}"
                           Visibility="{Binding Social.StatusNote, Converter={StaticResource NullToVisibilityConverter}}" />
                <ProgressBar Grid.Column="1" Width="14" Height="14" Margin="8,0,0,0"
                             Style="{StaticResource Spinner}"
                             ToolTip="Waiting for PlayOnline to confirm"
                             Visibility="{Binding Social.StatusPending, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <StackPanel x:Name="SocialButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- one row of equal cells, so all four are as wide as the widest -->
                <UniformGrid x:Name="SocialSet" Rows="1" Margin="6,0,0,0" PreviewMouseLeftButtonDown="OnPress"
                             IsEnabled="{Binding GameOpen, Converter={StaticResource InvertBool}}">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource PolButton}">
                            <Setter Property="Padding" Value="5,0,8,0" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </UniformGrid.Resources>
                    <Button Command="{Binding ToggleChatRoomsCommand}" ToolTip="Open chat rooms" AutomationProperties.Name="Open chat rooms">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="bubble" IsOpen="{Binding ChatRoomsOpen}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="CHAT ROOMS" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleGroupsCommand}" ToolTip="Open your friend groups" AutomationProperties.Name="Open your friend groups">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="groupchat2" IsOpen="{Binding Social.GroupsTabVisible}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="GROUP CHAT" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleMessagesCommand}" ToolTip="Open messages" AutomationProperties.Name="Open messages">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="chat" IsOpen="{Binding Social.Messages.ConversationVisible}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="MESSAGES" />
                            <Border Style="{StaticResource ButtonBadge}"
                                    Visibility="{Binding Social.HasUnread, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Unread messages">
                                <TextBlock Text="{Binding Social.UnreadCount}" Style="{StaticResource ButtonBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFriendsCommand}" ToolTip="Open friends" AutomationProperties.Name="Open friends">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="smiley" IsOpen="{Binding Social.FriendsTabVisible}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="FRIENDS" />
                            <Border Style="{StaticResource ButtonBadge}"
                                    Visibility="{Binding Social.HasPendingAnswers, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Friend requests and group invitations waiting for an answer">
                                <TextBlock Text="{Binding Social.PendingAnswers}" Style="{StaticResource ButtonBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <Border x:Name="LogOutDivider" Width="1" Height="20" Margin="12,0" Background="{DynamicResource Border.Pane}" />
                <Button Style="{StaticResource RedButton}" Padding="6,0,8,0" Height="30" FontSize="12"
                        Command="{Binding SignOutCommand}" AutomationProperties.Name="Log out">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Glyph="wave" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="LOG OUT" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
