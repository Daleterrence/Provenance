<UserControl x:Class="Provenance.Wpf.Views.Main.SocialFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
             xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
             xmlns:social="clr-namespace:Provenance.Wpf.Views.Social">
    <Border Height="44" Style="{StaticResource FooterBar}" Padding="16,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding GameOpen, Converter={StaticResource InvertBool}}">
                <StackPanel Orientation="Horizontal" Style="{StaticResource DimWhenOff}">
                    <social:MyProfilePicture x:Name="MyPicture" Diameter="32" Margin="0,0,10,0" DataContext="{Binding Social}"
                                             ToolTip="Change your profile picture. Right-click to switch handle."
                                             ContextMenuOpening="OnHandleMenu">
                        <social:MyProfilePicture.ContextMenu>
                            <ContextMenu />
                        </social:MyProfilePicture.ContextMenu>
                    </social:MyProfilePicture>
                    <TextBlock Text="{Binding Social.AccountName}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <social:EditProfileButton Margin="4,0,0,0" VerticalAlignment="Center" DataContext="{Binding Social}" />
                <ComboBox AutomationProperties.Name="Status" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusPicker}"
                          IsEnabled="{Binding Social.StatusEditable}"
                          ItemsSource="{Binding Social.StatusItems}" SelectedIndex="{Binding Social.MyStatusIndex}" />
            </StackPanel>
            <Grid Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                  Visibility="{Binding GameOpen, Converter={StaticResource InvertBoolToVis}}">
                <ProgressBar Width="14" Height="14" Margin="18,0,0,0"
                             Style="{StaticResource Spinner}"
                             ToolTip="{Binding Social.StatusPendingText}" AutomationProperties.Name="{Binding Social.StatusPendingText}"
                             Visibility="{Binding Social.StatusPending, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <StackPanel x:Name="SocialButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <UniformGrid x:Name="SocialSet" Rows="1" Margin="6,0,0,0">
                    <UniformGrid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource PolButton}">
                            <Setter Property="Padding" Value="5,0,8,0" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="FontSize" Value="12" />
                        </Style>
                    </UniformGrid.Resources>
                    <Button Command="{Binding ToggleChatRoomsCommand}" ToolTip="{Binding ChatRoomsTip}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Chat rooms"
                            IsEnabled="{Binding GameOpen, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="bubble" IsOpen="{Binding ChatRoomsOpen}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="CHAT ROOMS" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleGroupsCommand}" ToolTip="{Binding GroupsTip}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Groups"
                            IsEnabled="{Binding GameOpen, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="groupchat2" IsOpen="{Binding Social.GroupsWindowVisible}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="GROUPS" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleFriendsCommand}" ToolTip="Displays your PlayOnline friends list" AutomationProperties.Name="Friends"
                            IsEnabled="{Binding FriendsWaiting, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <controls:SvgIcon Glyph="chat" IsOpen="{Binding Social.FriendsTabVisible}" />
                            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="FRIENDS" />
                            <Border Style="{StaticResource ButtonBadge}"
                                    Visibility="{Binding Social.HasPendingAnswers, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Friend requests and group invitations waiting for an answer">
                                <TextBlock Text="{Binding Social.PendingAnswers}" Style="{StaticResource ButtonBadgeText}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </UniformGrid>
                <Border x:Name="LogOutDivider" Width="1" Height="20" Margin="12,0" Background="{DynamicResource Border.Pane}" />
                <Button Style="{StaticResource RedButton}" Padding="6,0,8,0" Height="30" FontSize="12"
                        Command="{Binding SignOutCommand}" AutomationProperties.Name="Log out">
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Glyph="wave" />
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="LOG OUT" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
