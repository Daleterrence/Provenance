<Window x:Class="Provenance.Wpf.Views.ChatRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:ChatRoomsViewModel}"
        Title="Chat rooms" Icon="/Assets/provenance.ico"
        Width="900" Height="620" MinWidth="720" MinHeight="460" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- the tooltip and icon (Tag) follow the window's state -->
        <Style x:Key="MaxButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="ToolTip" Value="Maximise" />
            <Setter Property="Tag" Value="{x:Static materialDesign:PackIconKind.WindowMaximize}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                    <Setter Property="ToolTip" Value="Restore down" />
                    <Setter Property="Tag" Value="{x:Static materialDesign:PackIconKind.WindowRestore}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <!-- read-only so a line can be copied, arrivals and the like in the accent colour -->
        <DataTemplate x:Key="RoomLine" DataType="{x:Type vm:ChatLineItem}">
            <!-- the face sits after the text so every line's text starts in the same place, like the viewer's log -->
            <Grid Margin="0,1" ColumnDefinitions="Auto,*,Auto">
                <TextBlock Margin="0,1,10,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding TimeText}" />
                <Image Grid.Column="2" Source="{Binding Emote}" Width="24" Height="24" Margin="6,-3,0,0" VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="{Binding HasEmote, Converter={StaticResource BoolToVis}}" />
                <TextBox x:Name="Body" Grid.Column="1" Style="{x:Null}" Text="{Binding Text, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"
                         IsReadOnly="True" IsTabStop="False" BorderThickness="0" Background="Transparent" Padding="0"
                         Foreground="{DynamicResource Text.1}" CaretBrush="Transparent" Cursor="IBeam"
                         SelectionBrush="{DynamicResource Primary}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Style}" Value="notice">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Style}" Value="status">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Text.3}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Style}" Value="whisper">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Accent.Gold}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Style}" Value="mine">
                    <Setter TargetName="Body" Property="Foreground" Value="{DynamicResource Text.2}" />
                </DataTrigger>
                <!-- after the styles, so a line's own colour wins -->
                <DataTrigger Binding="{Binding HasColour}" Value="True">
                    <Setter TargetName="Body" Property="Foreground" Value="{Binding Colour}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="40,*">
        <Grid Background="{DynamicResource Surface.1}">
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="Forum" Width="18" Height="18" Foreground="{DynamicResource Primary}" />
                <TextBlock Text="Chat rooms" FontSize="14" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MaximizeButton" Width="44" Height="40" Padding="0" Foreground="{DynamicResource Text.2}"
                        Style="{StaticResource MaxButton}" Click="OnMaximize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Width="18" Height="18" Kind="{Binding Tag, ElementName=MaximizeButton}" />
                </Button>
                <Button Width="44" Height="40" Padding="0" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                    <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- not available: logged out, the game's running, or POL's chat isn't answering -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                    Visibility="{Binding Unavailable, Converter={StaticResource NullToVisibilityConverter}}">
            <materialDesign:PackIcon Kind="ForumOutline" Width="44" Height="44" HorizontalAlignment="Center" Foreground="{DynamicResource Text.3}" />
            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"
                       Text="{Binding Unavailable}" />
            <Button Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource AccentFlatButton}"
                    FontSize="12" Content="TRY AGAIN" Command="{Binding StartCommand}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- the zone picker and the room list -->
        <Grid x:Name="LobbyPart" Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Available}" Value="True" />
                                <Condition Binding="{Binding InLobby}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <Grid Background="{DynamicResource Surface.1}" RowDefinitions="Auto,*">
                <StackPanel Margin="14,12,14,6">
                    <TextBlock Text="Zones" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding ZonesNote}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding ZonesView}" SelectedItem="{Binding SelectedZone}"
                         ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="14,10,14,2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}"
                                               Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatZoneItem}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Counts}" FontSize="11" Foreground="{DynamicResource Text.3}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Surface.2}" Cursor="SizeWE" />

            <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
                <Border Padding="16,10" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface.1}">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedZone.Name, FallbackValue=Rooms, TargetNullValue=Rooms}" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource Text.3}" Text="{Binding RoomsNote}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource AccentFlatButton}" FontSize="12" Content="CREATE ROOM"
                                    Command="{Binding CreateRoomCommand}" ToolTip="Create a new chat room." />
                            <Button Style="{StaticResource AccentFlatButton}" FontSize="12" Content="UPDATE LIST"
                                    Command="{Binding UpdateListCommand}" ToolTip="Update room list for selected zone." />
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Margin="16,8,16,4" ColumnDefinitions="22,*,Auto,Auto">
                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}" Text="Room Name" />
                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}" Text="Language"
                               Margin="0,0,12,0" />
                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}" Text="Occupancy" />
                </Grid>
                <ListBox x:Name="RoomList" Grid.Row="2" ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}"
                         ItemContainerStyle="{StaticResource ListRow}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnRoomDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatRoomItem}">
                            <Grid ColumnDefinitions="22,*,Auto,Auto">
                                <materialDesign:PackIcon Kind="Lock" Width="14" Height="14" VerticalAlignment="Center" Foreground="{DynamicResource Text.3}"
                                                         ToolTip="Password" Visibility="{Binding Locked, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Categories}" FontSize="11" Foreground="{DynamicResource Text.3}" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- the viewer's JP/EN/FR/GE badge, from the room's language category -->
                                <Border Grid.Column="2" MinWidth="52" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Center" Padding="6,1" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource Border.Hair}" Background="{DynamicResource Surface.2}"
                                            Visibility="{Binding HasLanguage, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Language}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Text.2}" />
                                    </Border>
                                </Border>
                                <TextBlock Grid.Column="3" Text="{Binding People}" FontSize="13" VerticalAlignment="Center" MinWidth="56" TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" Padding="12,8" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface.1}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Button Style="{StaticResource MaterialDesignFlatButton}" FontSize="12" Padding="8,0" Content="PREVIOUS 100"
                                Command="{Binding PreviousPageCommand}" />
                        <Button Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" FontSize="12" Padding="8,0" Content="NEXT 100"
                                Command="{Binding NextPageCommand}" />
                        <TextBlock Grid.Column="2" Margin="10,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Text.3}"
                                   Text="{Binding PageText}" />
                        <Button Grid.Column="3" Style="{StaticResource AccentRaisedButton}" Height="36" Content="ENTER"
                                Command="{Binding EnterCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- in a room: the log on the left, who's there on the right -->
        <Grid x:Name="RoomPart" Grid.Row="1" RowDefinitions="Auto,*,Auto">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Available}" Value="True" />
                                <Condition Binding="{Binding InRoom}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Padding="16,10" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,0,0,1" Background="{DynamicResource Surface.1}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" FontSize="15" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding RoomName, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding RoomCount, Mode=OneWay}" FontSize="13" Foreground="{DynamicResource Text.3}" />
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource AccentFlatButton}" FontSize="12" Content="ROOM PASSWORD" Click="OnPasswordMenu"
                                IsEnabled="{Binding MasterIdle}"
                                Visibility="{Binding IsMaster, Converter={StaticResource BoolToVis}}" ToolTip="Set or remove the room's password." />
                        <Button Style="{StaticResource AccentFlatButton}" FontSize="12" Content="EXIT"
                                Command="{Binding ExitCommand}" ToolTip="Exit chat room and return to the room list." />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="220" MinWidth="160" />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="LineScroll" VerticalScrollBarVisibility="Auto" Padding="14,8">
                    <ItemsControl ItemsSource="{Binding Lines}" ItemTemplate="{StaticResource RoomLine}" />
                </ScrollViewer>
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Surface.2}" Cursor="SizeWE" />
                <Grid Grid.Column="2" Background="{DynamicResource Surface.1}" RowDefinitions="Auto,*">
                    <TextBlock Margin="14,10,14,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.3}" Text="Members" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ChatMemberItem}">
                                    <!-- the master's Kick and Designate, filled as the menu opens -->
                                    <Grid Margin="14,3" ColumnDefinitions="18,*,Auto" Background="Transparent" ContextMenuOpening="OnMemberMenu">
                                        <Grid.ContextMenu>
                                            <ContextMenu />
                                        </Grid.ContextMenu>
                                        <materialDesign:PackIcon Kind="Star" Width="14" Height="14" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Accent.Gold}" ToolTip="Room master"
                                                                 Visibility="{Binding Master, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Text.3}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Padding="12,10" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface.1}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*,Auto">
                    <!-- the viewer's Text Color and Emoticon, both back to none after each line -->
                    <Button Height="40" Width="40" Padding="0" VerticalAlignment="Bottom" Style="{StaticResource MaterialDesignFlatButton}"
                            x:Name="ColourButton" Click="OnColourMenu" ToolTip="Text Color" AutomationProperties.Name="Text Color">
                        <Grid>
                            <materialDesign:PackIcon Kind="FormatColorText" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                            <Rectangle Width="20" Height="4" RadiusX="2" RadiusY="2" VerticalAlignment="Bottom" Margin="0,0,0,-4"
                                       Fill="{Binding PickedColour}" />
                        </Grid>
                    </Button>
                    <Button Grid.Column="1" Height="40" Width="40" Padding="0" Margin="0,0,6,0" VerticalAlignment="Bottom"
                            x:Name="EmoteButton" Style="{StaticResource MaterialDesignFlatButton}" Click="OnEmoteMenu" ToolTip="Emoticon" AutomationProperties.Name="Emoticon"
                            Visibility="{Binding HasEmotes, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <materialDesign:PackIcon Kind="EmoticonOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}"
                                                     Visibility="{Binding PickedEmote, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=invert}" />
                            <Image Source="{Binding PickedEmote}" Width="26" Height="26" />
                        </Grid>
                    </Button>
                    <TextBox x:Name="ComposeBox" Grid.Column="2" MinHeight="40" FontSize="13" Text="{Binding Compose, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" MaxLength="300" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="10,8"
                             materialDesign:HintAssist.Hint="Say something to the room (Enter sends)" materialDesign:HintAssist.IsFloating="False"
                             materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                             PreviewKeyDown="OnComposeKey" PreviewTextInput="OnComposeInput" DataObject.Pasting="OnComposePaste" />
                    <Button Grid.Column="3" Margin="10,0,0,0" Height="40" VerticalAlignment="Bottom" Style="{StaticResource AccentRaisedButton}"
                            Command="{Binding SendCommand}" Content="SEND" />
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Margin="2,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource State.Warn}"
                               Text="{Binding SendNote}" Visibility="{Binding SendNote, Converter={StaticResource NullToVisibilityConverter}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- entering: the viewer's own words while the steps run -->
        <Border Grid.Row="1" Background="{DynamicResource Bg.Base}" Opacity="0.94"
                Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Width="28" Height="28" IsIndeterminate="True" Value="0" Style="{StaticResource MaterialDesignCircularProgressBar}" />
                <TextBlock Margin="0,12,0,0" FontSize="14" HorizontalAlignment="Center" Text="{Binding BusyText}" />
                <Button Margin="0,14,0,0" HorizontalAlignment="Center" Style="{StaticResource AccentFlatButton}" FontSize="12"
                        Content="CANCEL" Command="{Binding CancelEnterCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
