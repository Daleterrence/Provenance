<controls:AppWindow x:Class="Provenance.Wpf.Views.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        CloseOnEscape="False"
        Style="{StaticResource DialogCard}">

    <StackPanel Margin="22,20,22,16">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Image Source="/Assets/provenance-256.png" Width="22" Height="22" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxWidth="340"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
        </StackPanel>

        <TextBlock x:Name="PromptText" FontSize="13" LineHeight="19" Foreground="{DynamicResource Text.2}"
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBox x:Name="InputBox" Style="{StaticResource OutlinedField}" materialDesign:HintAssist.IsFloating="False"
                 FontSize="13" Padding="12,8" MinHeight="42" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown" />
        <!-- a password: dots, with the same show button as the account's -->
        <PasswordBox x:Name="SecretBox" Style="{DynamicResource DialogRevealPasswordBox}" Visibility="Collapsed"
                     materialDesign:TextFieldAssist.CharacterCounterVisibility="Collapsed"
                     FontSize="13" Padding="12,8" MinHeight="42" VerticalContentAlignment="Center" KeyDown="OnInputKeyDown" />

        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource State.Down}"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource RedButton}" Content="CANCEL" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
            <Button Content="OK" MinWidth="72" IsDefault="True" Click="OnOk"
                    Style="{StaticResource PolButton}" />
        </StackPanel>
    </StackPanel>
</controls:AppWindow>
