<controls:AppWindow x:Class="Provenance.Wpf.Views.Dialogs.ReadmeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
        Title="Documentation" Icon="/Assets/provenance.ico"
        Width="720" Height="620" ResizeMode="CanResize" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=BodyText}"
        Style="{StaticResource AppWindow}">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*">
        <controls:TitleBar x:Name="Bar" />

        <Border Grid.Row="1" Margin="18,14,18,18" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
            <Grid>
                <TextBox x:Name="BodyText" Style="{StaticResource SelectableText}" FontFamily="{DynamicResource Font.Mono}" FontSize="12.5" Padding="14,10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviours:KeyScroll.Enabled="True" />
                <!-- read-only with the document switched on, which is what lets a link be pressed without Ctrl -->
                <RichTextBox x:Name="Page" Visibility="Collapsed" IsReadOnly="True" IsDocumentEnabled="True" IsUndoEnabled="False" AllowDrop="False"
                             BorderThickness="0" Background="Transparent" Padding="0" Foreground="{DynamicResource Text.1}"
                             CaretBrush="Transparent" SelectionBrush="{DynamicResource Primary}"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" behaviours:KeyScroll.Enabled="True" />
                <TextBlock x:Name="LoadingText" Text="Loading..." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="16" Foreground="{DynamicResource Text.2}" />
            </Grid>
        </Border>
    </Grid>
</controls:AppWindow>
