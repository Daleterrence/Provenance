<controls:AppWindow x:Class="Provenance.Wpf.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="Provenance" Icon="/Assets/provenance.ico" Width="440" SizeToContent="Height" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        CloseOnEscape="False"
        Style="{StaticResource DialogCard}">

    <StackPanel Margin="22,20,22,16">
        <Grid ColumnDefinitions="Auto,*">
            <Image x:Name="AssetNotice" Height="42" Margin="0,1,14,0" VerticalAlignment="Top" Stretch="Uniform" Visibility="Collapsed" />
            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <controls:SvgIcon x:Name="KindIcon" Glyph="help" Flat="True" Width="24" Height="24"
                                      Foreground="{DynamicResource Primary}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                               FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="340" />
                </StackPanel>

                <TextBox x:Name="BodyText" Style="{StaticResource SelectableText}" FontSize="13" TextBlock.LineHeight="19"
                         Foreground="{DynamicResource Text.2}" />
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Choices" Margin="0,14,0,0" Visibility="Collapsed">
            <RadioButton x:Name="ChoiceA" GroupName="Choice" IsChecked="True" Margin="0,0,0,8"
                         Foreground="{DynamicResource Text.1}" />
            <RadioButton x:Name="ChoiceB" GroupName="Choice" Foreground="{DynamicResource Text.1}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LogsButton" Style="{StaticResource PolButton}"
                    Content="OPEN LOGS" Margin="0,0,8,0" Click="OnOpenLogs" />
            <Button x:Name="CancelButton" Style="{StaticResource RedButton}"
                    Content="CANCEL" Margin="0,0,8,0" Visibility="Collapsed" Click="OnCancel" />
            <Button x:Name="OkButton" Content="OK" MinWidth="72" IsDefault="True" IsCancel="True" Click="OnOk"
                    Style="{StaticResource PolButton}" />
        </StackPanel>
    </StackPanel>
</controls:AppWindow>
