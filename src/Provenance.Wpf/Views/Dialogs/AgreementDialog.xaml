<controls:AppWindow x:Class="Provenance.Wpf.Views.Dialogs.AgreementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
        Title="PlayOnline Member Agreement" Icon="/Assets/provenance.ico"
        Width="720" Height="620" ResizeMode="CanResize" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=BodyText}"
        Style="{StaticResource AppWindow}"
        CloseOnEscape="False">

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,Auto,*,Auto">
        <controls:TitleBar x:Name="Bar" ShowClose="False" />

        <TextBlock x:Name="IntroText" Grid.Row="1" Margin="18,14,18,8" FontSize="13" TextWrapping="Wrap"
                   Foreground="{DynamicResource Text.2}" />

        <Border Grid.Row="2" Margin="18,0,18,0" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
            <!-- read-only so it can be copied, and it scrolls itself, an outer ScrollViewer fights it for the wheel -->
            <TextBox x:Name="BodyText" Style="{StaticResource SelectableText}" FontSize="12.5" TextBlock.LineHeight="18" Padding="14,10"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="OnBodyKey" />
        </Border>

        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource FooterBar}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource RedButton}" Content="I DO NOT ACCEPT"
                        IsCancel="True" Click="OnDecline" />
                <Button Style="{StaticResource PolButton}" Content="I ACCEPT" Click="OnAccept" Margin="{StaticResource Footer.Gap}" />
            </StackPanel>
        </Border>
    </Grid>
</controls:AppWindow>
