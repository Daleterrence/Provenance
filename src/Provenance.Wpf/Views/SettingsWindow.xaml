<Window x:Class="Provenance.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:Provenance.Wpf.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Provenance settings" Icon="/Assets/provenance.ico"
        Width="760" Height="600" MinWidth="720" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- labels go beside or above, never a floating hint (it draws a dark chip on this background, and I've lost
             that fight before) -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="12,8,8,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        </Style>
        <!-- the other controls fill the row's column, so this puts a switch against the card's edge like them -->
        <Style x:Key="Switch" TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignSwitchToggleButton}">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="DimWhenOff" TargetType="FrameworkElement">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileTool" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="TitleCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="10,5,6,5" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style x:Key="ProfileStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface.1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Hair}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>
        <!-- label and optional help (Tag) on the left, the control in a fixed column so they all line up -->
        <Style TargetType="HeaderedContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="96" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="Text" VerticalAlignment="Center">
                                <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource Text.1}"
                                           Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                <!-- usually plain text, the odd one with a bold bit is a TextBlock of its own -->
                                <ContentPresenter x:Name="HelpText" Margin="0,2,0,0" Content="{TemplateBinding Tag}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type sys:String}">
                                            <TextBlock Style="{StaticResource Help}" Text="{Binding}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="HelpText" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Text" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HandleCharacter">
            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="32">
                <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" Content="LINK TO..." FontSize="12" Height="30" Padding="10,0" Margin="8,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}" IsEnabled="{Binding CanLink}" Click="OnLinkCharacter"
                        AutomationProperties.Name="{Binding Label, StringFormat=Link {0} to a handle}" />
                <Button Grid.Column="2" Content="UNLINK" FontSize="12" Height="30" Padding="10,0" Margin="4,0,0,0"
                        Style="{StaticResource MaterialDesignFlatButton}" IsEnabled="{Binding CanUnlink}" Click="OnUnlinkCharacter"
                        Visibility="{Binding Handle, Converter={StaticResource NullToVisibilityConverter}}"
                        AutomationProperties.Name="{Binding Label, StringFormat=Unlink {0}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="40,*">
        <!-- only the switcher's controls take clicks, the rest of the bar still drags the window. The dropdown gives up
             its width before the title does -->
        <Grid Background="{DynamicResource Surface.1}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="104" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" MaxWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                <Image Source="/Assets/provenance-256.png" Width="20" Height="20" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="Settings" FontSize="14" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding ProfileSwitcherLabel}" FontSize="13" VerticalAlignment="Center" Margin="16,0,10,0"
                       Foreground="{DynamicResource Text.2}" Visibility="{Binding ShowProfileSwitcher, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding ShowProfileSwitcher, Converter={StaticResource BoolToVis}}">
                <ComboBox Style="{StaticResource TitleCombo}" ItemsSource="{Binding WindowerProfiles}" SelectedItem="{Binding WindowerProfile}" DisplayMemberPath="Display"
                          Visibility="{Binding IsWindower, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Windower profile" />
                <ComboBox Style="{StaticResource TitleCombo}" ItemsSource="{Binding AshitaBootConfigs}" SelectedItem="{Binding AshitaBootConfig}" DisplayMemberPath="Display"
                          Visibility="{Binding IsAshita, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Ashita boot configuration" />
            </Grid>
            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="6,0,2,0" VerticalAlignment="Center"
                        Visibility="{Binding ShowProfileTools, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsWindower, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding AddProfileCommand}" IsEnabled="{Binding CanManageProfiles}"
                            ToolTip="Add a profile" AutomationProperties.Name="Add a profile">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding DuplicateProfileCommand}" IsEnabled="{Binding CanCopyProfile}"
                            ToolTip="Duplicate this profile" AutomationProperties.Name="Duplicate this profile">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding CanChangeProfile}"
                            ToolTip="Rename this profile" AutomationProperties.Name="Rename this profile">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanChangeProfile}"
                            ToolTip="Delete this profile" AutomationProperties.Name="Delete this profile">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsAshita, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding AddProfileCommand}" IsEnabled="{Binding CanManageProfiles}"
                            ToolTip="Add a boot configuration" AutomationProperties.Name="Add a boot configuration">
                        <materialDesign:PackIcon Kind="Plus" Width="20" Height="20" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding DuplicateProfileCommand}" IsEnabled="{Binding CanCopyProfile}"
                            ToolTip="Duplicate this boot configuration" AutomationProperties.Name="Duplicate this boot configuration">
                        <materialDesign:PackIcon Kind="ContentCopy" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding RenameProfileCommand}" IsEnabled="{Binding CanChangeProfile}"
                            ToolTip="Rename this boot configuration" AutomationProperties.Name="Rename this boot configuration">
                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource ProfileTool}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanChangeProfile}"
                            ToolTip="Delete this boot configuration" AutomationProperties.Name="Delete this boot configuration">
                        <materialDesign:PackIcon Kind="DeleteOutline" Width="20" Height="20" />
                    </Button>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="4" Width="44" Height="40" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="210,*">
            <ListBox x:Name="Tabs" Background="{DynamicResource Surface.1}" BorderThickness="0"
                     Padding="0,10" SelectedIndex="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- a ring for keyboard focus only, a click shows none -->
                        <Setter Property="FocusVisualStyle">
                            <Setter.Value>
                                <Style>
                                    <Setter Property="Control.Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Rectangle Margin="8,0" RadiusX="9" RadiusY="9" StrokeThickness="2" Stroke="{DynamicResource Primary}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Margin="10,2" Padding="14,10" CornerRadius="8" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.3}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary.Muted}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="General" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PuzzleOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="Windower/Ashita" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="GamepadVariantOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="Game" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PowerPlugOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="Addons and plugins" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountMultiplePlusOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="Multi-account" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CardAccountDetailsOutline" Width="20" Height="20" Foreground="{DynamicResource Text.2}" />
                    <TextBlock Text="Handles" Margin="12,0,0,0" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
            </ListBox>

            <Grid Grid.Column="1" Background="{DynamicResource Bg.Base}">
                <ScrollViewer x:Name="Panel0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22">
                        <TextBlock Text="Installation" Style="{StaticResource Section}" />
                        <TextBlock Text="Region" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding RegionText}" Margin="0,0,0,10" />
                        <TextBlock Text="PlayOnline Viewer folder" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding ViewerFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" Margin="0,0,0,10" />
                        <TextBlock Text="FINAL FANTASY XI folder" Style="{StaticResource Label}" />
                        <TextBlock Text="{Binding FfxiFolder}" TextWrapping="Wrap" Foreground="{DynamicResource Text.2}" Margin="0,0,0,18" />

                        <TextBlock Text="Game memory" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <HeaderedContentControl Header="Large Address Aware" IsEnabled="{Binding LargeAddressAwareEnabled}"
                                                        Tag="When this is on, the game can use up to 4&#160;GB of memory instead of 2&#160;GB, which helps with HD texture mods. Provenance applies it every time the game starts, and it's the same setting as Windower's Large Address Aware.">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LargeAddressAwareOn}"
                                                  AutomationProperties.Name="Large Address Aware" />
                                </HeaderedContentControl>
                                <TextBlock Text="{Binding LargeAddressAwareStatus}"
                                           TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Global Settings" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <HeaderedContentControl Header="Chat language filter"
                                                        Tag="When this is on, offensive words are hidden in messages, comments and profiles from other PlayOnline members, and in FINAL FANTASY XI.">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding ChatLanguageFilter}"
                                                  AutomationProperties.Name="Chat language filter" />
                                </HeaderedContentControl>
                                <HeaderedContentControl Header="Auto-disconnect"
                                                        Tag="PlayOnline disconnects you after you've been idle this long in FINAL FANTASY XI.">
                                    <ComboBox ItemsSource="{Binding AutoDisconnectChoices}" SelectedIndex="{Binding AutoDisconnectIndex}"
                                              AutomationProperties.Name="Auto-disconnect" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Backups" Style="{StaticResource Section}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <HeaderedContentControl Header="Automatic backups"
                                                        Tag="When this is on, Provenance backs up your characters' in-game settings and macros before the game starts, if they've changed. It keeps the newest 5.">
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BackupGameSettings}"
                                                  AutomationProperties.Name="Automatic backups" />
                                </HeaderedContentControl>
                                <StackPanel Margin="0,8,0,10">
                                    <TextBlock Text="Backups folder" FontSize="13" Foreground="{DynamicResource Text.1}" />
                                    <Border Height="8" />
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Text="{Binding BackupFolder, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldText}"
                                                 materialDesign:HintAssist.Hint="{Binding DefaultBackupFolder}" AutomationProperties.Name="Backups folder" />
                                        <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                Command="{Binding BrowseBackupFolderCommand}" />
                                        <Button Grid.Column="2" Margin="6,0,0,0" Width="32" Height="32" Padding="0" VerticalAlignment="Center"
                                                Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                                                Command="{Binding OpenBackupFolderCommand}" ToolTip="Open folder" AutomationProperties.Name="Open folder">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{Binding BackupStatus}" Tag="{Binding BackupStatusIsError}" Style="{StaticResource ProfileStatusText}" Margin="0,8,0,0" />
                                </StackPanel>
                                <HeaderedContentControl Header="Restore a backup" Tag="Puts your game settings back from one of your backups.">
                                    <Button Content="RESTORE" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="12"
                                            Command="{Binding RestoreBackupCommand}" />
                                </HeaderedContentControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="News and status" Style="{StaticResource Section}" />
                        <TextBlock Text="News region" Style="{StaticResource Label}" />
                        <ComboBox Width="260" HorizontalAlignment="Left"
                                  ItemsSource="{Binding FeedRegionChoices}" SelectedIndex="{Binding FeedRegionIndex}" />
                        <TextBlock Style="{StaticResource Help}" Margin="0,6,0,18"
                                   Text="This is the PlayOnline site the news and server status come from." />

                        <TextBlock Text="Behaviour" Style="{StaticResource Section}" />
                        <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding ExitAfterGameExits}" Margin="0,0,0,8">
                            <TextBlock Text="Close Provenance when the game exits" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,8">
                            <TextBlock Text="Minimise Provenance to the tray instead of the taskbar" TextWrapping="Wrap" />
                        </CheckBox>
                        <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding KeepSignedInInTray}" Margin="0,0,0,4">
                            <TextBlock Text="Keep me logged in to PlayOnline in the tray when I close the window" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource Text.3}" Margin="26,0,0,8"
                                   Text="Your friends and messages stay up to date, and you won't need to log in again when you open Provenance. To log out, right-click the tray icon." />
                        <StackPanel Orientation="Horizontal" Margin="26,0,0,8" IsEnabled="{Binding KeepSignedInInTray}">
                            <TextBlock Text="Log out and close after this long in the tray:" VerticalAlignment="Center" Foreground="{DynamicResource Text.2}"
                                       Style="{StaticResource DimWhenOff}" />
                            <ComboBox Width="140" Margin="10,0,0,0" Padding="10,5,6,5"
                                      ItemsSource="{Binding TraySignOutChoices}" SelectedIndex="{Binding TraySignOutIndex}" />
                        </StackPanel>
                        <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding NotifyFriendsOnline}" Margin="0,4,0,8">
                            <TextBlock Text="Tell me when a friend comes online" TextWrapping="Wrap" />
                        </CheckBox>

                        <TextBlock Margin="0,26,0,0" FontSize="11" Foreground="{DynamicResource Text.3}" Text="{Binding VersionText}" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Panel1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,22">
                        <TextBlock Text="Windower/Ashita" Style="{StaticResource Section}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.2}" Margin="0,0,0,14"
                                   Text="Start the game through Windower 4 or Ashita v4, so everything you've set up in them loads as usual. Provenance still logs you in." />
                        <TextBlock Text="Platform" Style="{StaticResource Label}" />
                        <ComboBox Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Platform"
                                  ItemsSource="{Binding ThirdPartyHookChoices}" SelectedIndex="{Binding ThirdPartyHookIndex}" />
                        <TextBlock Text="{Binding ThirdPartyHookStatus}" Tag="{Binding ThirdPartyHookStatusIsError}"
                                   Style="{StaticResource StatusText}" TextWrapping="Wrap" FontSize="12"
                                   Margin="0,10,0,16" />

                        <StackPanel Visibility="{Binding IsAshita, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Ashita folder" Style="{StaticResource Label}" />
                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding AshitaPath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldText}"
                                         AutomationProperties.Name="Ashita folder" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding BrowseAshitaCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ProfileStatus}" Tag="{Binding ProfileStatusIsError}" Style="{StaticResource ProfileStatusText}" />
                            <TextBlock Text="{Binding AshitaCardNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14" Foreground="{DynamicResource State.Warn}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="Boot configuration settings" Style="{StaticResource Section}" Margin="0,8,0,10" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding AshitaCardEnabled}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Name" Tag="The name Ashita's launcher shows for this boot configuration instead of its file name.">
                                        <TextBox Text="{Binding AshitaName, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldText}"
                                                 AutomationProperties.Name="Name" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Script" Tag="The script Ashita runs when the game starts, from its scripts folder.">
                                        <ComboBox ItemsSource="{Binding AshitaScripts}" SelectedItem="{Binding AshitaScript}" AutomationProperties.Name="Script" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Script arguments" Tag="Passed to the script when Ashita runs it, if it takes any.">
                                        <TextBox Text="{Binding AshitaScriptArgs, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldText}"
                                                 AutomationProperties.Name="Script arguments" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsWindower, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Windower folder" Style="{StaticResource Label}" />
                            <Grid Margin="0,0,0,14" ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding WindowerPath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource FieldText}"
                                         AutomationProperties.Name="Windower folder" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding BrowseWindowerCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding ProfileStatus}" Tag="{Binding ProfileStatusIsError}" Style="{StaticResource ProfileStatusText}" />
                            <Border Margin="0,0,0,14" Padding="14,10" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource State.Warn}"
                                    Visibility="{Binding WindowerSettingsProblem, Converter={StaticResource NullToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding WindowerSettingsProblem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource State.Warn}" />
                                    <Button Content="START A NEW SETTINGS FILE" HorizontalAlignment="Left" Margin="0,10,0,0" FontSize="12"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding StartNewWindowerSettingsCommand}"
                                            Visibility="{Binding CanStartNewWindowerSettings, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Profile settings" Style="{StaticResource Section}" Margin="0,8,0,10" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding WindowerCardEnabled}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Console key" Tag="The key that opens and closes the Windower console in game.">
                                        <Button x:Name="ConsoleKeyButton" Content="{Binding ConsoleKeyText}" FontSize="12" Command="{Binding EditConsoleKeyCommand}"
                                                PreviewKeyDown="OnConsoleKeyDown" PreviewKeyUp="OnConsoleKeyUp" LostKeyboardFocus="OnConsoleKeyFocusLost"
                                                AutomationProperties.Name="Console key">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding WaitingForConsoleKey}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Primary.Muted}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Allow the Windows key" Tag="Makes Windows handle keybinds before Windower. Required for normal Windows 11 Alt-Tab behaviour.">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding WindowerAllowWinKey}"
                                                      AutomationProperties.Name="Allow the Windows key" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Updates" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding WindowerBranchEnabled}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Branch">
                                        <HeaderedContentControl.Tag>
                                            <TextBlock Style="{StaticResource Help}"><Run Text="Switches Windower, its plugins and its addons between Stable and Development. The switch happens the next time you log in. " /><Bold>Leave this on Stable unless you know what you're doing.</Bold></TextBlock>
                                        </HeaderedContentControl.Tag>
                                        <Button Content="{Binding WindowerBranchName}" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="12"
                                                Command="{Binding FlipWindowerBranchCommand}" AutomationProperties.Name="Branch" />
                                    </HeaderedContentControl>
                                    <TextBlock Text="{Binding WindowerVersionText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,10"
                                               Foreground="{DynamicResource Text.2}" Visibility="{Binding WindowerVersionText, Converter={StaticResource NullToVisibilityConverter}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <views:AddonsPluginsView x:Name="Panel3" Visibility="Collapsed" DataContext="{Binding Addons}" />

                <ScrollViewer x:Name="Panel4" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,22">
                        <TextBlock Text="Multi-account mode" Style="{StaticResource Section}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.2}" Margin="0,0,0,8"
                                   Text="Press Start all accounts on the main window to log in to each account you turn on here and start FINAL FANTASY XI for it, one after another, in this order." />
                        <TextBlock Style="{StaticResource Help}" Margin="0,0,0,14"
                                   Text="Each account starts once the one before it is in the game. If an account uses a one-time password, Provenance asks for it when that account's turn comes." />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource State.Warn}"
                                   Text="You must use either Windower or Ashita with Provenance to use multi-account login."
                                   Visibility="{Binding MultiHasThirdPartyHook, Converter={StaticResource InvertBoolToVis}}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" Foreground="{DynamicResource State.Warn}"
                                   Text="Provenance is starting your accounts. You can change these settings once it's finished."
                                   Visibility="{Binding MultiRunGoing, Converter={StaticResource BoolToVis}}" />
                        <StackPanel IsEnabled="{Binding MultiEditable}">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="0.5" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding MultiContinueOnError}" Margin="0,0,0,4">
                                <TextBlock Text="Continue multi-login process on error" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Help}" Margin="26,0,0,10"
                                       Text="If one of the accounts fails to log in due to an incorrect password, no subscription, or other problem, continue logging on the other accounts. Disabling this option will make Provenance stop upon an error logging in an account. Some problems, like a failed game update, always stop the run." />
                            <CheckBox Foreground="{DynamicResource Text.2}" IsChecked="{Binding MultiCloseWhenFinished}" Margin="0,0,0,4">
                                <TextBlock Text="Close Provenance when finished" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Style="{StaticResource Help}" Margin="26,0,0,14"
                                       Text="This will exit Provenance when all of your accounts are successfully logged in. If there is an error logging any account in, it will always stay open to tell you what went wrong and let you try again." />
                            <TextBlock Text="You haven't added any accounts yet. Add one on the main window.">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Help}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MultiAccountRows.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding MultiAccountRows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="10" Background="{DynamicResource Surface.1}"
                                                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Problem, StringFormat=Turned off: {0}}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource State.Warn}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding ProfileNeeded}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource State.Warn}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ProfileNeeded}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="Edit this account's login details to turn it on again." FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource State.Warn}"
                                                               Visibility="{Binding CredentialsRefused, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                                <ComboBox Grid.Column="1" Width="200" Margin="0" Padding="10,6"
                                                          ItemsSource="{Binding DataContext.MultiProfileChoices, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding ThirdPartyHookProfile}" IsEnabled="{Binding Enabled}"
                                                          ToolTip="{Binding DataContext.MultiProfileLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          Visibility="{Binding DataContext.MultiHasThirdPartyHook, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVis}}" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                                                            Command="{Binding DataContext.MoveMultiUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Start earlier" AutomationProperties.Name="Start earlier">
                                                        <materialDesign:PackIcon Kind="ChevronUp" Width="20" Height="20" />
                                                    </Button>
                                                    <Button Width="32" Height="32" Padding="0" Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                                                            Command="{Binding DataContext.MoveMultiDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="Start later" AutomationProperties.Name="Start later">
                                                        <materialDesign:PackIcon Kind="ChevronDown" Width="20" Height="20" />
                                                    </Button>
                                                </StackPanel>
                                                <CheckBox Grid.Column="3" Margin="8,0,0,0" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                          IsEnabled="{Binding CredentialsRefused, Converter={StaticResource InvertBool}}"
                                                          ToolTip="Start this account when you press Start all accounts"
                                                          AutomationProperties.Name="{Binding Name, StringFormat=Start {0} in multi-account mode}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Panel5" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" DataContext="{Binding Handles}">
                    <StackPanel Margin="28,22">
                        <TextBlock Text="Handles" Style="{StaticResource Section}" />
                        <TextBlock Text="{Binding LoggedOutText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.2}"
                                   Visibility="{Binding LoggedIn, Converter={StaticResource InvertBoolToVis}}" />
                        <StackPanel Visibility="{Binding LoggedIn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ReadOnlyText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource State.Warn}"
                                       Visibility="{Binding ReadOnly, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{Binding Note}" Tag="{Binding NoteIsError}" Style="{StaticResource ProfileStatusText}" />
                            <TextBlock Text="{Binding NoHandlesText}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource Text.2}"
                                       Visibility="{Binding NoHandles, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <views:ProfilePictureCircle Diameter="40" Margin="0,0,12,0" VerticalAlignment="Center"
                                                                                Source="{Binding Picture}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="9" VerticalAlignment="Center"
                                                                Background="{DynamicResource Primary.Muted}"
                                                                Visibility="{Binding Active, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Active" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="SWITCH" FontSize="12" VerticalAlignment="Center"
                                                            Style="{StaticResource MaterialDesignOutlinedButton}" IsEnabled="{Binding CanSwitch}"
                                                            Click="OnSwitchHandle" AutomationProperties.Name="{Binding Name, StringFormat=Make {0} active}" />
                                                </Grid>
                                                <TextBlock Text="{Binding DataContext.NoCharactersText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           Style="{StaticResource Help}" Margin="52,8,0,0"
                                                           Visibility="{Binding NoCharacters, Converter={StaticResource BoolToVis}}" />
                                                <ItemsControl ItemsSource="{Binding Characters}" Focusable="False" Margin="52,6,0,0"
                                                              ItemTemplate="{StaticResource HandleCharacter}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12"
                                    Visibility="{Binding HasUnlinked, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Unlinked" FontSize="15" FontWeight="SemiBold" />
                                    <ItemsControl ItemsSource="{Binding Unlinked}" Focusable="False" Margin="0,6,0,0"
                                                  ItemTemplate="{StaticResource HandleCharacter}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding AutoSwitchText}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="Panel2" Visibility="Collapsed" DataContext="{Binding Game}" RowDefinitions="*,Auto">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="28,22,28,6">
                            <Border Style="{StaticResource PlatformCard}" Tag="{Binding Platform}" Margin="0,0,0,12"
                                    Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialDesign:PackIcon Kind="PuzzleOutline" Width="22" Height="22" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding ProfileHeading}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ProfileShown}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ReadOnlyNote}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource State.Warn}"
                                       Visibility="{Binding ReadOnlyNote, Converter={StaticResource NullToVisibilityConverter}}" />
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Text.2}" Margin="0,0,0,16"
                                       Text="{Binding IntroText}" />

                            <!-- only the cards need the game's saved settings, a broken install may have none -->
                            <TextBlock Text="Display" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Resolution">
                                        <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Window mode">
                                        <ComboBox ItemsSource="{Binding WindowModes}" SelectedIndex="{Binding WindowModeIndex}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="UI size" Tag="Higher values make the menus bigger.">
                                        <StackPanel>
                                            <Grid ColumnDefinitions="*,46">
                                                <Slider Minimum="1" Maximum="{Binding UiScaleMax}" Value="{Binding UiScale}"
                                                        TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.25"
                                                        VerticalAlignment="Center" AutomationProperties.Name="UI size" />
                                                <TextBlock Grid.Column="1" Text="{Binding UiScaleText}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                                            </Grid>
                                            <TextBlock Text="{Binding UiSizeText}" Style="{StaticResource Help}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Brightness">
                                        <Grid ColumnDefinitions="*,46">
                                            <Slider Minimum="-1" Maximum="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                                    Value="{Binding Brightness}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding BrightnessText}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                                        </Grid>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Graphics" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Quick preset" Tag="A preset changes the graphics settings below in one go. Press Save to keep the changes.">
                                        <UniformGrid Rows="1" Columns="3">
                                            <Button Content="ULTRA" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="2,0" FontSize="12"
                                                    Margin="0,0,4,0" Command="{Binding PresetCommand}" CommandParameter="Ultra" />
                                            <Button Content="HIGH" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="2,0" FontSize="12"
                                                    Margin="2,0" Command="{Binding PresetCommand}" CommandParameter="High" />
                                            <Button Content="STANDARD" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="2,0" FontSize="12"
                                                    Margin="4,0,0,0" Command="{Binding PresetCommand}" CommandParameter="Standard" />
                                        </UniformGrid>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="3D resolution" Tag="This is the resolution the game draws its 3D graphics at, before scaling them to the game resolution.">
                                        <ComboBox ItemsSource="{Binding RenderSizes}" SelectedItem="{Binding RenderSize}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Keep aspect ratio" Tag="When this is on, the 3D resolution list only shows sizes that are the same shape as the game resolution."
                                                            Visibility="{Binding KeepAspectShown, Converter={StaticResource BoolToVis}}">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding KeepAspect}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Textures" Tag="This only changes the quality of light flares and clouds.">
                                        <ComboBox ItemsSource="{Binding Quality3}" SelectedIndex="{Binding Textures}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Fonts">
                                        <ComboBox ItemsSource="{Binding Quality3}" SelectedIndex="{Binding Fonts}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Map quality">
                                        <ComboBox ItemsSource="{Binding Quality2}" SelectedIndex="{Binding Maps2D}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Vegetation movement">
                                        <ComboBox ItemsSource="{Binding VegetationLevels}" SelectedIndex="{Binding Vegetation}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Distant textures" Tag="When this is on, distant objects get full-size textures instead of lower-resolution ones.">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding DrawDistance}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Enhanced shading">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding EnhancedShading}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Sound" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Sound">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding Sound}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Simultaneous sound effects" IsEnabled="{Binding Sound}">
                                        <Grid ColumnDefinitions="*,46">
                                            <Slider Minimum="12" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding SoundEffects}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding SoundEffects}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource Text.2}" />
                                        </Grid>
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Sound in the background" Tag="When this is on, the sound keeps playing when you switch to another window."
                                                            IsEnabled="{Binding Sound}">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding BackgroundSound}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Gamepad" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Gamepad">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadEnabled}" />
                                    </HeaderedContentControl>
                                    <StackPanel Margin="20,0,0,0" IsEnabled="{Binding PadEnabled}">
                                        <HeaderedContentControl Header="Force feedback">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadForceFeedback}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Analogue sliders">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadSlider}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Hat switches">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadHat}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Gamepad in the background" Tag="When this is on, the gamepad keeps working when you switch to another window.">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadBackground}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="XInput controller" Tag="Turn this on if you use an Xbox controller, or one that works like it.">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding PadXInput}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                    <HeaderedContentControl Header="Buttons" Tag="This opens the FINAL FANTASY XI gamepad tool, where you can choose what each button does.">
                                        <Button Content="SET UP BUTTONS" Style="{StaticResource MaterialDesignOutlinedButton}" FontSize="12"
                                                Command="{Binding OpenPadConfigCommand}" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Other" Style="{StaticResource Section}" />
                            <Border Style="{StaticResource Card}" IsEnabled="{Binding Editable}">
                                <StackPanel>
                                    <HeaderedContentControl Header="Opening movie" Tag="When this is on, the game plays its opening movie each time it starts.">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding OpeningMovie}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Full-size screenshots" Tag="When this is on, your screenshots are saved at your screen's resolution.">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding FullResScreenshots}" />
                                    </HeaderedContentControl>
                                    <StackPanel Margin="0,8,0,10">
                                        <StackPanel Style="{StaticResource DimWhenOff}">
                                            <TextBlock Text="Screenshots and settings folder" FontSize="13" Foreground="{DynamicResource Text.1}" />
                                            <TextBlock Style="{StaticResource Help}" Margin="0,2,0,0"
                                                       Text="The game saves your screenshots and some of its settings in this folder." />
                                            <Border Height="8" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding ScreenshotFolder}" Style="{StaticResource FieldText}"
                                                     materialDesign:HintAssist.Hint="Documents\My Games\FINAL FANTASY XI" />
                                            <Button Grid.Column="1" Margin="8,0,0,0" Content="BROWSE" Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    Command="{Binding BrowseScreenshotsCommand}" />
                                        </Grid>
                                    </StackPanel>
                                    <HeaderedContentControl Header="Hardware mouse cursor">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding HardwareMouse}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Legacy settings" Tag="Turn this on to change Simple character creation and Graphics card fix. Turning it off clears them.">
                                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding LegacySettings}" />
                                    </HeaderedContentControl>
                                    <StackPanel Margin="20,0,0,0">
                                        <HeaderedContentControl Header="Simple character creation" IsEnabled="{Binding LegacySettings}" Tag="When this is on, character creation shows still pictures instead of 3D models.">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding SimpleCharSelect}" />
                                        </HeaderedContentControl>
                                        <HeaderedContentControl Header="Graphics card fix" IsEnabled="{Binding LegacySettings}" Tag="This setting is also called Graphics Stabilization. It can help the game run properly on some graphics cards.">
                                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding GraphicsFix}" />
                                        </HeaderedContentControl>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{DynamicResource Surface.1}" BorderBrush="{DynamicResource Border.Hair}"
                            BorderThickness="0,1,0,0" Padding="20,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Status}" Tag="{Binding StatusIsError}"
                                       Style="{StaticResource StatusText}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" FontSize="12" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="DEFAULTS" Style="{StaticResource MaterialDesignFlatButton}" Command="{Binding DefaultsCommand}" Margin="0,0,6,0" IsEnabled="{Binding Editable}" />
                                <Button Content="REVERT" Style="{StaticResource MaterialDesignOutlinedButton}" Command="{Binding RevertCommand}" Margin="0,0,8,0" IsEnabled="{Binding Editable}" />
                                <Button Content="SAVE" Width="100" Style="{StaticResource AccentRaisedButton}"
                                        Command="{Binding SaveCommand}" IsEnabled="{Binding Editable}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
