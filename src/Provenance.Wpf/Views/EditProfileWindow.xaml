<Window x:Class="Provenance.Wpf.Views.EditProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Provenance.Wpf.ViewModels"
        xmlns:local="clr-namespace:Provenance.Wpf.Views"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:EditProfileViewModel}"
        Title="Edit your PlayOnline profile" Icon="/Assets/provenance.ico"
        Width="560" Height="780" MinHeight="420" MinWidth="480" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg.Base}"
        TextElement.Foreground="{DynamicResource Text.1}" FontFamily="{DynamicResource Font.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,10" />
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,6,0,0" />
        </Style>
        <!-- labels above, never a floating hint (it draws an ugly chip behind itself on this background) -->
        <Style x:Key="Field" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Padding" Value="12,8,8,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="MaxDropDownHeight" Value="360" />
        </Style>
        <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource Bg.Base}" RowDefinitions="40,*,Auto">
        <Grid Background="{DynamicResource Surface.1}">
            <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="14" Text="Edit your PlayOnline profile" />
            <Button HorizontalAlignment="Right" Width="44" Height="40" Padding="0"
                    Style="{StaticResource MaterialDesignFlatButton}" Foreground="{DynamicResource Text.2}"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" AutomationProperties.Name="Close">
                <materialDesign:PackIcon Kind="WindowClose" Width="18" Height="18" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16,20,18"
                      IsEnabled="{Binding LoadingProfile, Converter={StaticResource InvertBool}}">
            <StackPanel IsEnabled="{Binding CanEditFields}">
                <Grid ColumnDefinitions="Auto,*">
                    <!-- a button so the keyboard can reach it, drawn as just the picture -->
                    <Button VerticalAlignment="Top" Cursor="Hand" ToolTip="Change your profile picture" AutomationProperties.Name="Change your profile picture"
                            Click="OnProfilePictureClick" Foreground="{DynamicResource Text.1}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <!-- a ring for keyboard focus only, a click shows none -->
                                <Setter Property="FocusVisualStyle">
                                    <Setter.Value>
                                        <Style>
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Rectangle Margin="-3" RadiusX="41" RadiusY="41" StrokeThickness="2"
                                                                   Stroke="{DynamicResource Primary}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <local:ProfilePictureCircle Diameter="76" Source="{Binding Social.Avatar}" />
                            <ProgressBar Width="76" Height="76" IsIndeterminate="True" Value="0" IsHitTestVisible="False"
                                         Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         Visibility="{Binding Social.ProfilePictureSaving, Converter={StaticResource BoolToVis}}" />
                            <Border Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{DynamicResource Surface.3}" BorderBrush="{DynamicResource Bg.Base}" BorderThickness="2">
                                <materialDesign:PackIcon Kind="Pencil" Width="12" Height="12" HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" Foreground="{DynamicResource Text.1}" />
                            </Border>
                        </Grid>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Handle name" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource FieldText}" MaxLength="15"
                                 Text="{Binding HandleName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Help}"
                                   Text="This is the name your friends see, up to 15 English letters, numbers and symbols. They'll see a new name the next time their friend list loads." />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Who can see your profile" Style="{StaticResource Section}" />
                <ListBox ItemsSource="{Binding VisibilityChoices}" SelectedValuePath="Code" SelectedValue="{Binding Level}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle">
                                <Setter.Value>
                                    <Style>
                                        <Setter Property="Control.Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <Rectangle Margin="-2,-2,6,4" RadiusX="18" RadiusY="18" StrokeThickness="2"
                                                               Stroke="{DynamicResource Primary}" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Pill" Margin="0,0,8,6" Padding="16,7" CornerRadius="16" Cursor="Hand"
                                                BorderThickness="1" BorderBrush="{DynamicResource Border.Hair}"
                                                Background="{DynamicResource Surface.1}">
                                            <TextBlock x:Name="Txt" Text="{Binding Text}" FontSize="12.5"
                                                       Foreground="{DynamicResource Text.2}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Primary.Muted}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Primary.Muted}" />
                                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Text.1}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
                <TextBlock Style="{StaticResource Help}" Margin="2,0,0,0"
                           Text="{Binding VisibilityHelp}" />

                <TextBlock Text="About you" Style="{StaticResource Section}" />
                <Grid ColumnDefinitions="*,14,*">
                    <StackPanel>
                        <TextBlock Text="Age" Style="{StaticResource Label}" />
                        <TextBox Style="{StaticResource FieldText}" MaxLength="3" materialDesign:HintAssist.Hint="{Binding NotSet}"
                                 Text="{Binding AgeText, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="OnDigitsOnly" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                        <CheckBox Content="Show an approximate age" Foreground="{DynamicResource Text.2}"
                                  IsChecked="{Binding ApproximateAge}"
                                  ToolTip="Others see your age group instead of your exact age." />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,12,0,0" ColumnDefinitions="*,14,*">
                    <StackPanel>
                        <TextBlock Text="Sex" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding SexChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Sex}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Job" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding JobChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Job1}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mail address" Style="{StaticResource Label}" Margin="2,12,0,4" />
                <TextBox Style="{StaticResource FieldText}" MaxLength="319" materialDesign:HintAssist.Hint="No mail address"
                         Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Help}" Text="Leave it empty if you don't want to show a mail address." />

                <TextBlock Text="Location" Style="{StaticResource Section}" />
                <Grid DataContext="{Binding Location}" ColumnDefinitions="*,10,*,10,*">
                    <StackPanel>
                        <TextBlock Text="Region" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding Tops}" SelectedItem="{Binding Top}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Country" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding Mids}" SelectedItem="{Binding Mid}"
                                  IsEnabled="{Binding IsSet}" materialDesign:HintAssist.Hint="Choose" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Area" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding Leaves}" SelectedItem="{Binding Leaf}"
                                  DisplayMemberPath="Text" IsEnabled="{Binding IsSet}" materialDesign:HintAssist.Hint="Choose" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Languages" Style="{StaticResource Section}" />
                <Grid ColumnDefinitions="*,10,*,10,*">
                    <StackPanel>
                        <TextBlock Text="First" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang0}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Second" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang1}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Third" Style="{StaticResource Label}" />
                        <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Text"
                                  SelectedValuePath="Code" SelectedValue="{Binding Lang2}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Interests" Style="{StaticResource Section}" />
                <StackPanel>
                    <StackPanel.Resources>
                        <DataTemplate x:Key="InterestRow" DataType="{x:Type vm:CascadePick}">
                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,10,*">
                                <ComboBox Style="{StaticResource Field}" ItemsSource="{Binding Tops}" SelectedItem="{Binding Top}" />
                                <ComboBox Grid.Column="2" Style="{StaticResource Field}" ItemsSource="{Binding Leaves}"
                                          SelectedItem="{Binding Leaf}" DisplayMemberPath="Text" IsEnabled="{Binding IsSet}"
                                          materialDesign:HintAssist.Hint="Choose" />
                            </Grid>
                        </DataTemplate>
                    </StackPanel.Resources>
                    <TextBlock Text="Interest 1" Style="{StaticResource Label}" />
                    <ContentControl Content="{Binding Interest1}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                    <TextBlock Text="Interest 2" Style="{StaticResource Label}" />
                    <ContentControl Content="{Binding Interest2}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                    <TextBlock Text="Interest 3" Style="{StaticResource Label}" />
                    <ContentControl Content="{Binding Interest3}" ContentTemplate="{StaticResource InterestRow}" Focusable="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- over the form while POL sends the profile. The form's disabled underneath too, so Tab can't get in either -->
        <Grid x:Name="LoadingOverlay" Grid.Row="1" Visibility="Collapsed" Opacity="0" IsHitTestVisible="{Binding LoadingProfile}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LoadingProfile}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.25" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Rectangle Fill="{DynamicResource Bg.Base}" Opacity="0.82" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20,14,24,14" CornerRadius="10"
                    Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Hair}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="20" Height="20" IsIndeterminate="True" Value="0" Foreground="{DynamicResource Primary}"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}" />
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" Text="Loading your profile..." />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Padding="16,10" Background="{DynamicResource Surface.1}"
                BorderBrush="{DynamicResource Border.Hair}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <!-- the overlay has its own spinner while the profile loads -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding LoadingProfile, Converter={StaticResource InvertBoolToVis}}">
                    <ProgressBar Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True" Value="0"
                                 Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"
                               Text="{Binding FooterText}" Tag="{Binding FooterIsError}"
                               Style="{StaticResource StatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="TRY AGAIN" Margin="0,0,8,0"
                            Command="{Binding RetryLoadCommand}" Visibility="{Binding CanRetryLoad, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CLOSE" Margin="0,0,8,0" Click="OnClose" IsCancel="True" />
                    <Button Content="SAVE" Command="{Binding SaveCommand}" IsDefault="True"
                            Style="{StaticResource AccentRaisedButton}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
