<Application x:Class="Provenance.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Provenance.Wpf.Converters"
             xmlns:views="clr-namespace:Provenance.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Cyan" SecondaryColor="Amber" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <!-- merged last so the palette wins any clash -->
                <ResourceDictionary Source="Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:LocalTimeConverter x:Key="LocalTimeConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:ArticleTimesConverter x:Key="ArticleTimesConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
            <conv:InvertBoolConverter x:Key="InvertBool" />

            <!-- Tag is the error flag, every window binds its own -->
            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource State.Down}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DimStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            </Style>

            <!-- the profile a Settings page is changing, in its app's colour. Tag is the platform -->
            <Style x:Key="PlatformCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{DynamicResource Surface.1}" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="windower">
                        <Setter Property="Background" Value="{DynamicResource Platform.Windower}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="ashita">
                        <Setter Property="Background" Value="{DynamicResource Platform.Ashita}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- the default wide grey scrollbar with arrows looks awful on the dark theme -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
                <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="3" />
            </Style>

            <Style x:Key="StatusPicker" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTip" Value="Change your PlayOnline status" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <views:StatusMark Status="{Binding}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- setters so the disabled trigger can swap them for grey, MaterialDesign only fades them -->
            <Style x:Key="AccentFlatButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Foreground" Value="{DynamicResource Primary}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AccentRaisedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background" Value="{DynamicResource Primary}" />
                <Setter Property="BorderBrush" Value="{x:Null}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.OnPrimary}" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource Surface.3}" />
                        <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- the big Play and LOG IN buttons: square like the rest, but shaded and outlined so they read as something to press -->
            <Style x:Key="ActionShell" TargetType="Border">
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{DynamicResource Action.Fill}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Action.Edge}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.5" Color="#000000" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ActionSegment" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="Transparent">
                                <Border x:Name="Tint" Background="White" Opacity="0"
                                        CornerRadius="{TemplateBinding materialDesign:ButtonAssist.CornerRadius}" />
                                <Border x:Name="Ring" BorderBrush="White" BorderThickness="2" Opacity="0" Margin="3"
                                        CornerRadius="1" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tint" Property="Background" Value="Black" />
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- LOG IN: one segment in its own shell -->
            <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource ActionSegment}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Shell" Style="{StaticResource ActionShell}">
                                <Grid>
                                    <Border x:Name="Tint" Background="White" Opacity="0" CornerRadius="1" />
                                    <Border x:Name="Ring" BorderBrush="White" BorderThickness="2" Opacity="0" Margin="3" CornerRadius="1" />
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Tint" Property="Background" Value="Black" />
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Surface.3}" />
                                    <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Surface.3}" />
                                    <Setter TargetName="Shell" Property="Effect" Value="{x:Null}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MaterialDesign pads a floating hint with its own grey background, which leaves a chip round the label.
                 These pad it with Surface.2, the dialogs they sit on -->
            <Style x:Key="DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
                </Style.Resources>
            </Style>
            <Style x:Key="DialogPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
                </Style.Resources>
            </Style>
            <Style x:Key="DialogRevealPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedRevealPasswordBox}">
                <Style.Resources>
                    <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
                </Style.Resources>
            </Style>

            <Style TargetType="ToolTip" BasedOn="{StaticResource MaterialDesignToolTip}">
                <Setter Property="Background" Value="{DynamicResource Surface.3}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Border.Hair}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
