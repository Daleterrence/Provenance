<Application x:Class="Provenance.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:Provenance.Wpf.Converters"
             xmlns:views="clr-namespace:Provenance.Wpf.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- AppTheme hands MaterialDesign each palette's own blue, these are just its starting point -->
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="Blue" SecondaryColor="Blue" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Themes/Shared.xaml" />
                <ResourceDictionary Source="Themes/Buttons.xaml" />
                <!-- merged last so the palette wins any clash. AppTheme swaps it for Light.xaml -->
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:LocalTimeConverter x:Key="LocalTimeConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:ArticleTimesConverter x:Key="ArticleTimesConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
            <conv:InvertBoolConverter x:Key="InvertBool" />
            <conv:UpperCaseConverter x:Key="UpperCase" />

            <!-- Tag is the error flag, every window binds its own -->
            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource State.Down}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DimStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
                <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
            </Style>

            <!-- the profile a Settings page is changing, in its app's colour. Tag is the platform -->
            <Style x:Key="PlatformCard" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{DynamicResource Surface.1}" />
                <Setter Property="TextElement.Foreground" Value="White" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="windower">
                        <Setter Property="Background" Value="{DynamicResource Platform.Windower}" />
                    </Trigger>
                    <Trigger Property="Tag" Value="ashita">
                        <Setter Property="Background" Value="{DynamicResource Platform.Ashita}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- the default wide grey scrollbar with arrows looks awful on the dark theme -->
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
                <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="3" />
            </Style>

            <Style x:Key="StatusPicker" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
                <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="ToolTip" Value="Change your PlayOnline status" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- in the list only the status you're on keeps its fill, the box itself isn't in a ComboBoxItem -->
                                <views:StatusMark Status="{Binding}" Margin="0,0,6,0"
                                                  Filled="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=True}" />
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- icons with no text: no fill till they're hovered -->
            <Style x:Key="IconButton" TargetType="ButtonBase">
                <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="views:FocusCue.Track" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ButtonBase">
                            <Grid>
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                                <Border x:Name="Ring" BorderBrush="{DynamicResource Focus.Ring}" BorderThickness="1" Opacity="0" />
                                <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.Fill}" />
                                </Trigger>
                                <Trigger Property="views:FocusCue.Shown" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.Fill}" />
                                    <Setter TargetName="Ring" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press.Fill}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- MaterialDesign's fields, with a placeholder strength each theme picks -->
            <Style x:Key="OutlinedField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
            </Style>
            <Style x:Key="PlainField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
            </Style>
            <Style x:Key="OutlinedCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
            </Style>

            <!-- labels go beside or above, never a floating hint -->
            <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource OutlinedField}">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
            </Style>

            <!-- a row that can be picked, the same hover and selection in every list -->
            <Style x:Key="RowItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" CornerRadius="{StaticResource Radius.Panel}" Background="Transparent">
                                <Grid>
                                    <!-- a pale fill alone barely shows on the panel, so the picked row gets a bar too -->
                                    <Border x:Name="Mark" Width="3" Margin="0,4" HorizontalAlignment="Left" CornerRadius="1.5"
                                            Background="{DynamicResource Primary}" Visibility="Collapsed" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.3}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Selected}" />
                                    <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                <Setter Property="Margin" Value="10,2" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource Radius.Panel}" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface.3}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Primary.Muted}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!-- a ring for keyboard focus only, a click shows none -->
                <Setter Property="FocusVisualStyle">
                    <Setter.Value>
                        <Style>
                            <Setter Property="Control.Template">
                                <Setter.Value>
                                    <ControlTemplate>
                                        <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="{DynamicResource Primary}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- keys of their own, so a tooltip on a title bar doesn't take the bar's light text -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource MaterialDesignToolTip}">
                <Setter Property="Background" Value="{DynamicResource Tip.Bg}" />
                <Setter Property="Foreground" Value="{DynamicResource Tip.Text}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Tip.Edge}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
