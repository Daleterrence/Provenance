<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <Style x:Key="StatusPicker" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
        <Setter Property="materialDesign:TextFieldAssist.DecorationVisibility" Value="Collapsed" />
        <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Change your PlayOnline status" />
        <Setter Property="TextSearch.TextPath" Value="Label" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <!-- in the list only the status you're on keeps its fill, the box itself isn't in a ComboBoxItem -->
                        <controls:StatusMark Status="{Binding Status}" Margin="0,0,6,0"
                                             Filled="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ComboBoxItem}, FallbackValue=True}" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OutlinedField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
    </Style>
    <Style x:Key="PlainField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
    </Style>
    <Style x:Key="OutlinedCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{DynamicResource Field.HintOpacity}" />
    </Style>

    <Style x:Key="FieldText" TargetType="TextBox" BasedOn="{StaticResource OutlinedField}">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
        <Setter Property="materialDesign:TextFieldAssist.CharacterCounterVisibility" Value="Collapsed" />
    </Style>
    <Style x:Key="FieldCombo" TargetType="ComboBox" BasedOn="{StaticResource OutlinedCombo}">
        <Setter Property="Padding" Value="12,8,8,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
    </Style>
    <Style x:Key="Search" TargetType="TextBox" BasedOn="{StaticResource FieldText}">
        <Setter Property="materialDesign:TextFieldAssist.HasLeadingIcon" Value="True" />
        <Setter Property="materialDesign:TextFieldAssist.LeadingIcon" Value="Magnify" />
        <Setter Property="materialDesign:TextFieldAssist.HasClearButton" Value="True" />
    </Style>

</ResourceDictionary>
