<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:Provenance.Wpf.Views">
    <!-- every text button, the same in both themes: a soft gradient either side of POL's base blue, a faint light line
         along the top. The greyed-out and focus colours are in each palette -->
    <LinearGradientBrush x:Key="Btn.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F4F87" Offset="0" />
        <GradientStop Color="#133C69" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A5D97" Offset="0" />
        <GradientStop Color="#1A487B" Offset="1" />
    </LinearGradientBrush>
    <!-- turned over, so it looks pushed in -->
    <LinearGradientBrush x:Key="Btn.Fill.Press" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F335B" Offset="0" />
        <GradientStop Color="#164070" Offset="1" />
    </LinearGradientBrush>
    <!-- an icon's disc while its button's in use (its window's open, or it's held down), near POL's own green -->
    <LinearGradientBrush x:Key="Btn.Icon.Active" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7FCA94" Offset="0" />
        <GradientStop Color="#5DAA74" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Btn.Sheen" Color="White" Opacity="0.16" />
    <SolidColorBrush x:Key="Btn.Rim" Color="#0C2D52" />
    <SolidColorBrush x:Key="Btn.Text" Color="#FFFFFF" />
    <!-- inside the Play segments, so it sits on the button's own blue -->
    <SolidColorBrush x:Key="Btn.Focus.Inset" Color="#FFFFFF" />
    <DropShadowEffect x:Key="Btn.Shadow" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />

    <!-- Play gets a brighter blue, a lighter edge and a soft blue glow so it's the first thing you see -->
    <LinearGradientBrush x:Key="Play.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B67B5" Offset="0" />
        <GradientStop Color="#1A4F8F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Play.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3574C4" Offset="0" />
        <GradientStop Color="#215A9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Play.Fill.Press" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#164576" Offset="0" />
        <GradientStop Color="#1F5590" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Play.Sheen" Color="White" Opacity="0.3" />
    <Thickness x:Key="Play.Sheen.Width">0,1,0,0</Thickness>
    <SolidColorBrush x:Key="Play.Rim" Color="#3B78C8" />
    <SolidColorBrush x:Key="Play.Divider" Color="White" Opacity="0.22" />
    <DropShadowEffect x:Key="Play.Shadow" BlurRadius="22" ShadowDepth="0" Opacity="0.7" Color="#3F86E0" />

    <ControlTemplate x:Key="Btn.Template" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Sheen" Margin="1" BorderBrush="{DynamicResource Btn.Sheen}" BorderThickness="0,1,0,0" />
            <!-- outside the button, so keyboard focus never looks like a hover -->
            <Border x:Name="Ring" Margin="-4" BorderThickness="2" BorderBrush="{DynamicResource Btn.Focus}" Visibility="Collapsed" />
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Fill.Hover}" />
            </Trigger>
            <Trigger Property="views:FocusCue.Shown" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Fill.Press}" />
                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Content" Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Disabled.Fill}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PolButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Btn.Text}" />
        <Setter Property="Background" Value="{DynamicResource Btn.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Btn.Rim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:FocusCue.Track" Value="True" />
        <Setter Property="Template" Value="{StaticResource Btn.Template}" />
        <!-- on the button, not the template, as content that's its own element (icon and label) takes the button's colour -->
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Btn.Disabled.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- cancel, log out and the rest of the back-out buttons, plus the OK on a confirm that deletes something. The
         template looks its colours up by name, so these stand in for the blue ones -->
    <Style x:Key="RedButton" TargetType="ButtonBase" BasedOn="{StaticResource PolButton}">
        <Style.Resources>
            <LinearGradientBrush x:Key="Btn.Fill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8E2A2E" Offset="0" />
                <GradientStop Color="#6E1E22" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Btn.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A0353A" Offset="0" />
                <GradientStop Color="#7E262B" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Btn.Fill.Press" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#5E191C" Offset="0" />
                <GradientStop Color="#782428" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Btn.Rim" Color="#4A1013" />
            <SolidColorBrush x:Key="Btn.Disabled.Fill" Color="#8E2A2E" Opacity="0.3" />
        </Style.Resources>
    </Style>

    <!-- the big log in and cancel buttons -->
    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="Effect" Value="{DynamicResource Btn.Shadow}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RedActionButton" TargetType="Button" BasedOn="{StaticResource RedButton}">
        <Setter Property="Effect" Value="{DynamicResource Btn.Shadow}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the play button: play and the cog sit in one shell, each with its own fill, so each lights up and greys out
         on its own -->
    <Style x:Key="ActionShell" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Play.Rim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{DynamicResource Play.Shadow}" />
    </Style>

    <Style x:Key="ActionSegment" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Btn.Text}" />
        <Setter Property="Background" Value="{DynamicResource Play.Fill}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="views:FocusCue.Track" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" />
                        <Border x:Name="Sheen" BorderBrush="{DynamicResource Play.Sheen}" BorderThickness="{DynamicResource Play.Sheen.Width}" />
                        <Border x:Name="Ring" Margin="3" BorderThickness="2" BorderBrush="{DynamicResource Btn.Focus.Inset}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Play.Fill.Hover}" />
                        </Trigger>
                        <Trigger Property="views:FocusCue.Shown" Value="True">
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Play.Fill.Press}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Content" Property="RenderTransform">
                                <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Disabled.Fill}" />
                            <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Btn.Disabled.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
