<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
                    xmlns:controls="clr-namespace:Provenance.Wpf.Controls">
    <LinearGradientBrush x:Key="Btn.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F4F87" Offset="0" />
        <GradientStop Color="#133C69" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A5D97" Offset="0" />
        <GradientStop Color="#1A487B" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn.Fill.Press" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0F335B" Offset="0" />
        <GradientStop Color="#164070" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Btn.Icon.Active" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7FCA94" Offset="0" />
        <GradientStop Color="#5DAA74" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Btn.Sheen" Color="White" Opacity="0.16" />
    <SolidColorBrush x:Key="Btn.Rim" Color="#0C2D52" />
    <SolidColorBrush x:Key="Btn.Text" Color="#FFFFFF" />
    <Thickness x:Key="Btn.Sheen.Inset">1</Thickness>
    <Thickness x:Key="Btn.Sheen.Width">0,1,0,0</Thickness>
    <Thickness x:Key="Btn.Ring.Inset">-4</Thickness>
    <DropShadowEffect x:Key="Btn.Shadow" BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.35" Color="Black" />

    <LinearGradientBrush x:Key="Play.Fill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2B67B5" Offset="0" />
        <GradientStop Color="#1A4F8F" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Play.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#3574C4" Offset="0" />
        <GradientStop Color="#215A9E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Play.Fill.Press" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#164576" Offset="0" />
        <GradientStop Color="#1F5590" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Play.Sheen" Color="White" Opacity="0.3" />
    <SolidColorBrush x:Key="Play.Rim" Color="#3B78C8" />
    <SolidColorBrush x:Key="Play.Divider" Color="White" Opacity="0.22" />
    <DropShadowEffect x:Key="Play.Shadow" BlurRadius="22" ShadowDepth="0" Opacity="0.7" Color="#3F86E0" />

    <ControlTemplate x:Key="Btn.Template" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Sheen" Margin="{DynamicResource Btn.Sheen.Inset}" BorderBrush="{DynamicResource Btn.Sheen}"
                    BorderThickness="{DynamicResource Btn.Sheen.Width}" />
            <Border x:Name="Ring" Margin="{DynamicResource Btn.Ring.Inset}" BorderThickness="2" BorderBrush="{DynamicResource Focus.Ring}"
                    Visibility="Collapsed" />
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Content" Property="RenderTransform">
                    <Setter.Value><TranslateTransform Y="1" /></Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Btn.Disabled.Fill}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Sheen" Property="Visibility" Value="Collapsed" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PolButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Btn.Text}" />
        <Setter Property="Background" Value="{DynamicResource Btn.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Btn.Rim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Btn.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Btn.Fill.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Btn.Fill.Press}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Btn.Disabled.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RedButton" TargetType="ButtonBase" BasedOn="{StaticResource PolButton}">
        <Style.Resources>
            <LinearGradientBrush x:Key="Btn.Fill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#8E2A2E" Offset="0" />
                <GradientStop Color="#6E1E22" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Btn.Fill.Hover" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#A0353A" Offset="0" />
                <GradientStop Color="#7E262B" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Btn.Fill.Press" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#5E191C" Offset="0" />
                <GradientStop Color="#782428" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="Btn.Rim" Color="#4A1013" />
            <SolidColorBrush x:Key="Btn.Disabled.Fill" Color="#8E2A2E" Opacity="0.3" />
        </Style.Resources>
    </Style>

    <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="Effect" Value="{DynamicResource Btn.Shadow}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="RedActionButton" TargetType="Button" BasedOn="{StaticResource RedButton}">
        <Setter Property="Effect" Value="{DynamicResource Btn.Shadow}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Effect" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="Grid.Column" Value="1" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Content" Value="BROWSE" />
    </Style>

    <Style x:Key="ActionShell" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Play.Rim}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Effect" Value="{DynamicResource Play.Shadow}" />
    </Style>

    <!-- hover and press are triggers, not swapped Btn.Fill keys, as an icon on it reads those for its disc -->
    <Style x:Key="ActionSegment" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="Background" Value="{DynamicResource Play.Fill}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="NaN" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="12" />
        <Style.Resources>
            <SolidColorBrush x:Key="Btn.Sheen" Color="White" Opacity="0.3" />
            <SolidColorBrush x:Key="Focus.Ring" Color="#FFFFFF" />
            <Thickness x:Key="Btn.Sheen.Inset">0</Thickness>
            <Thickness x:Key="Btn.Ring.Inset">3</Thickness>
        </Style.Resources>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Play.Fill.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Play.Fill.Press}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Hl" Margin="2" RadiusX="999" RadiusY="999" Fill="Transparent" IsHitTestVisible="False"
                                   Visibility="{Binding Content.Flat, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVis}, FallbackValue=Visible}" />
                        <Rectangle x:Name="Ring" Margin="2" RadiusX="999" RadiusY="999" Stroke="{DynamicResource Focus.Ring}" StrokeThickness="1"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hl" Property="Fill" Value="{DynamicResource Hover.Fill}" />
                        </Trigger>
                        <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                            <Setter TargetName="Hl" Property="Fill" Value="{DynamicResource Hover.Fill}" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hl" Property="Fill" Value="{DynamicResource Press.Fill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ArrowButton" TargetType="ButtonBase" BasedOn="{StaticResource IconButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Ring" Margin="2" RadiusX="4" RadiusY="4" Stroke="{DynamicResource Focus.Ring}" StrokeThickness="1"
                                   Visibility="Collapsed" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Arrow.Hover}" />
                        </Trigger>
                        <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Arrow.Hover}" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Arrow.Press}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" />
                        <Border x:Name="Ring" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Focus.Ring}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.Fill}" />
                        </Trigger>
                        <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Hover.Fill}" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Press.Fill}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Small.Template" TargetType="ButtonBase">
        <Grid>
            <Border x:Name="Bd" CornerRadius="13" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Ring" Margin="-3" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Focus.Ring}" Visibility="Collapsed" />
            <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="behaviours:FocusCue.Shown" Value="True">
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="SmallButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Small.Text}" />
        <Setter Property="Background" Value="{DynamicResource Small.Fill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Small.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
        <Setter Property="Template" Value="{StaticResource Small.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Small.Fill.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Small.Line.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Small.Fill.Press}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Small.Line.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Btn.Disabled.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="KeyboardNavigation.AcceptsReturn" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RepairButton" TargetType="Button" BasedOn="{StaticResource PolButton}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="5,0,10,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Command" Value="{Binding Repair.StartCommand}" />
        <Setter Property="Visibility" Value="{Binding Repair.Available, Converter={StaticResource BoolToVis}}" />
        <Setter Property="ToolTip" Value="Checks every game file and replaces any that are damaged. It'll ask you before it replaces anything." />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="Repair game files" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <controls:SvgIcon Glyph="ring" Width="20" Height="20"
                                          IsOpen="{Binding DataContext.Repair.Repairing, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="REPAIR GAME FILES" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
