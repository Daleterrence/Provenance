<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Color x:Key="Theme.MaterialPrimary">#0B53A0</Color>

    <SolidColorBrush x:Key="Bg.Base"        Color="#E0E0E0" />
    <Color x:Key="Bg.Glow">#8CA9C9</Color>
    <SolidColorBrush x:Key="Surface.1"      Color="#D7D7D7" />
    <Color x:Key="Surface.2.Color">#E6E6E6</Color>
    <SolidColorBrush x:Key="Surface.2"      Color="{StaticResource Surface.2.Color}" />
    <SolidColorBrush x:Key="Surface.3"      Color="#C8CFD7" />
    <RadialGradientBrush x:Key="Logo.Mask" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.1" RadiusY="0.27">
        <GradientStop Color="Black" Offset="0.7" />
        <GradientStop Color="Transparent" Offset="1" />
    </RadialGradientBrush>
    <!-- MaterialDesign's 0.56 leaves placeholders under 4.5:1 on these greys -->
    <sys:Double x:Key="Field.HintOpacity">0.68</sys:Double>
    <SolidColorBrush x:Key="Title.Bg"       Color="#333333" />
    <SolidColorBrush x:Key="Title.Edge"     Color="#0B53A0" />
    <SolidColorBrush x:Key="Title.FieldText" Color="#101010" />
    <SolidColorBrush x:Key="Title.Field"    Color="#E6E6E6" />

    <SolidColorBrush x:Key="Primary"        Color="#0B53A0" />
    <SolidColorBrush x:Key="Row.Selected"   Color="#BFCCDA" />
    <SolidColorBrush x:Key="Banner.Bg"      Color="#2E0B53A0" />
    <SolidColorBrush x:Key="Banner.Line"    Color="#4D0B53A0" />
    <SolidColorBrush x:Key="Banner.Text"    Color="#0A2F5C" />
    <SolidColorBrush x:Key="Banner.Icon"    Color="#0B53A0" />
    <SolidColorBrush x:Key="Primary.Muted"  Color="#8CA2BB" />

    <SolidColorBrush x:Key="Accent.Gold"    Color="#6E5408" />

    <SolidColorBrush x:Key="Text.1"         Color="#101010" />
    <SolidColorBrush x:Key="Text.2"         Color="#333333" />
    <SolidColorBrush x:Key="Text.3"         Color="#505050" />
    <SolidColorBrush x:Key="Text.OnPrimary" Color="#FFFFFF" />

    <SolidColorBrush x:Key="State.Online"   Color="#17733A" />
    <SolidColorBrush x:Key="State.Warn"     Color="#7A4E00" />
    <SolidColorBrush x:Key="State.Down"     Color="#901810" />

    <SolidColorBrush x:Key="Badge.Neutral"     Color="#CBD2DA" />
    <SolidColorBrush x:Key="Badge.Maintenance" Color="#E8DAB2" />

    <SolidColorBrush x:Key="Chip.Neutral"     Color="#5B6877" />
    <SolidColorBrush x:Key="Chip.Alert"       Color="#C62828" />
    <SolidColorBrush x:Key="Chip.Maintenance" Color="#F2B01E" />
    <SolidColorBrush x:Key="Chip.Event"       Color="#1E66D0" />
    <SolidColorBrush x:Key="Chip.Update"      Color="#1E7F43" />
    <SolidColorBrush x:Key="Chip.Text"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="Chip.Text.Dark"   Color="#1A1A1A" />

    <SolidColorBrush x:Key="Arrow.Hover"    Color="#0B53A0" />
    <SolidColorBrush x:Key="Arrow.Press"    Color="#073A72" />
    <SolidColorBrush x:Key="Small.Fill"       Color="#FFFFFF" />
    <SolidColorBrush x:Key="Small.Fill.Hover" Color="#E6EEF8" />
    <SolidColorBrush x:Key="Small.Fill.Press" Color="#C6D6EA" />
    <SolidColorBrush x:Key="Small.Line"       Color="#4F6F98" />
    <SolidColorBrush x:Key="Small.Line.Hover" Color="#0B53A0" />
    <SolidColorBrush x:Key="Small.Text"       Color="#0B3E78" />

    <SolidColorBrush x:Key="Hover.Fill"     Color="#386497" Opacity="0.18" />
    <SolidColorBrush x:Key="Press.Fill"     Color="#386497" Opacity="0.32" />
    <SolidColorBrush x:Key="Focus.Ring"     Color="#0B53A0" />

    <SolidColorBrush x:Key="Btn.Disabled.Fill" Color="#174271" Opacity="0.2" />
    <SolidColorBrush x:Key="Btn.Disabled.Text" Color="#404A57" />

    <SolidColorBrush x:Key="Tip.Bg"         Color="#C8CFD7" />
    <SolidColorBrush x:Key="Tip.Text"       Color="#101010" />
    <SolidColorBrush x:Key="Tip.Edge"       Color="Black" Opacity="0.14" />

    <SolidColorBrush x:Key="Border.Hair"    Color="Black" Opacity="0.14" />
    <SolidColorBrush x:Key="Border.Pane"    Color="#A9B0B9" />
    <SolidColorBrush x:Key="Border.Window"  Color="#012854" />

    <DropShadowEffect x:Key="Shadow.Dialog" BlurRadius="18" ShadowDepth="4" Opacity="0.3" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Window" BlurRadius="30" ShadowDepth="8" Opacity="0.32" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Card"   BlurRadius="10" ShadowDepth="2" Opacity="0.16" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Panel"  BlurRadius="40" ShadowDepth="10" Opacity="0.2" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Notice" BlurRadius="24" ShadowDepth="6" Opacity="0.25" Color="Black" />

    <SolidColorBrush x:Key="Pop.Info.Fill"    Color="#DCEBFA" />
    <SolidColorBrush x:Key="Pop.Info.Border"  Color="#7FB2E5" />
    <SolidColorBrush x:Key="Pop.Info.Text"    Color="#0F2D4A" />
    <SolidColorBrush x:Key="Pop.Info.Icon"    Color="#195FA8" />
    <SolidColorBrush x:Key="Pop.Error.Fill"   Color="#FBE0E0" />
    <SolidColorBrush x:Key="Pop.Error.Border" Color="#E08A8A" />
    <SolidColorBrush x:Key="Pop.Error.Text"   Color="#5A0F0F" />
    <SolidColorBrush x:Key="Pop.Error.Icon"   Color="#B3261E" />

    <Style x:Key="DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
    <Style x:Key="DialogPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
    <Style x:Key="DialogRevealPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedRevealPasswordBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>
