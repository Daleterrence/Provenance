<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- title bars are dark in both themes (slate or POL's charcoal), so what's on them gets light colours. Merged into
         each title bar, so it only reaches what's on it -->
    <SolidColorBrush x:Key="Text.1"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.2"      Color="#D8DEE6" />
    <SolidColorBrush x:Key="Text.3"      Color="#B4BCC8" />
    <SolidColorBrush x:Key="Primary"     Color="#9CC3F2" />
    <SolidColorBrush x:Key="Surface.2"   Color="White" Opacity="0.1" />
    <SolidColorBrush x:Key="Border.Hair" Color="White" Opacity="0.18" />
    <SolidColorBrush x:Key="Hover.Fill"  Color="White" Opacity="0.14" />
    <SolidColorBrush x:Key="Press.Fill"  Color="White" Opacity="0.24" />
    <SolidColorBrush x:Key="Focus.Ring"  Color="#9CC3F2" />
    <SolidColorBrush x:Key="Btn.Disabled.Text" Color="#A0A0A0" />
    <!-- the worlds dot, light theme's darker ones vanish on the bar -->
    <SolidColorBrush x:Key="State.Online" Color="#3FD07F" />
    <SolidColorBrush x:Key="State.Warn"   Color="#E6B13E" />
    <SolidColorBrush x:Key="State.Down"   Color="#FF5C64" />
    <SolidColorBrush x:Key="Accent.Gold"  Color="#C9A227" />
</ResourceDictionary>
