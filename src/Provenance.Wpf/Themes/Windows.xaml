<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Provenance.Wpf.Controls"
                    xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- the frame every full window shares: our own 40 high title bar, so the system's buttons stay off -->
    <Style x:Key="AppWindow" TargetType="controls:AppWindow">
        <Setter Property="WindowStyle" Value="None" />
        <!-- an icon that lands between two pixels gets smeared over both -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Bg.Base}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AppWindow.Fixed" TargetType="controls:AppWindow" BasedOn="{StaticResource AppWindow}">
        <Setter Property="shell:WindowChrome.WindowChrome">
            <Setter.Value>
                <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0"
                                    UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a dialog floats as a rounded card in a see-through window, its shadow falling in the margin -->
    <Style x:Key="DialogCard" TargetType="controls:AppWindow">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="behaviours:DragAnywhere.Enabled" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:AppWindow">
                    <Border x:Name="Card" Margin="{TemplateBinding CardMargin}" CornerRadius="{StaticResource Radius.Dialog}"
                            Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Window}" BorderThickness="1">
                        <Border.Effect>
                            <DynamicResource ResourceKey="Shadow.Dialog" />
                        </Border.Effect>
                        <AdornerDecorator>
                            <ContentPresenter />
                        </AdornerDecorator>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WideShadow" Value="True">
                            <Setter TargetName="Card" Property="Effect">
                                <Setter.Value>
                                    <DynamicResource ResourceKey="Shadow.Window" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the heading of the install and repair windows: the crystal and a title, with a small close in the corner -->
    <Style TargetType="controls:DialogHeader">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:DialogHeader">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Assets/provenance-256.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{TemplateBinding Title}" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="PART_Close" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0"
                                Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}" ToolTip="Close" AutomationProperties.Name="Close">
                            <controls:SvgIcon Glyph="close" Flat="True" Width="16" Height="16" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the bar across the top of a window: icon and title, then whatever the window puts in it, then maximise and close.
         Only the buttons take clicks, the rest of the bar drags the window -->
    <Style TargetType="controls:TitleBar">
        <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TitleBar">
                    <Grid Background="{DynamicResource Title.Bg}">
                        <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Image x:Name="Crystal" Source="{TemplateBinding Icon}" Width="20" Height="20" Margin="0,0,8,0"
                                   Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                            <ContentPresenter Content="{TemplateBinding IconContent}" />
                            <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="{TemplateBinding TitleSize}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <DockPanel>
                            <Button x:Name="PART_Close" DockPanel.Dock="Right" Width="44" Height="40" Padding="0"
                                    Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}"
                                    ToolTip="{TemplateBinding CloseToolTip}" AutomationProperties.Name="{TemplateBinding CloseName}"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <controls:SvgIcon Glyph="close" Flat="True" Width="{TemplateBinding GlyphSize}" Height="{TemplateBinding GlyphSize}" />
                            </Button>
                            <Button x:Name="PART_Maximise" DockPanel.Dock="Right" Width="44" Height="40" Padding="0" Visibility="Collapsed"
                                    Style="{StaticResource IconButton}" Foreground="{DynamicResource Text.2}" ToolTip="Maximise"
                                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
                                <materialDesign:PackIcon x:Name="MaximiseIcon" Kind="WindowMaximize"
                                                         Width="{TemplateBinding GlyphSize}" Height="{TemplateBinding GlyphSize}" />
                            </Button>
                            <ContentPresenter />
                        </DockPanel>
                        <Border Style="{StaticResource TitleEdge}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconContent" Value="{x:Null}">
                            <Setter TargetName="Crystal" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="DimTitle" Value="True">
                            <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Text.2}" />
                        </Trigger>
                        <Trigger Property="ShowMaximise" Value="True">
                            <Setter TargetName="PART_Maximise" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowClose" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMaximised" Value="True">
                            <Setter TargetName="PART_Maximise" Property="ToolTip" Value="Restore down" />
                            <Setter TargetName="MaximiseIcon" Property="Kind" Value="WindowRestore" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
