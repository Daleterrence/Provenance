<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <!-- Light.xaml has the same keys, AppTheme swaps one for the other -->
    <Color x:Key="Theme.MaterialPrimary">#6A9BD8</Color>

    <SolidColorBrush x:Key="Bg.Base"        Color="#0A0E14" />
    <Color x:Key="Bg.Glow">#2F5ACF</Color>
    <SolidColorBrush x:Key="Surface.1"      Color="#121824" />
    <Color x:Key="Surface.2.Color">#18202E</Color>
    <SolidColorBrush x:Key="Surface.2"      Color="{StaticResource Surface.2.Color}" />
    <SolidColorBrush x:Key="Surface.3"      Color="#222C3D" />
    <!-- the crystal shows whole on dark, Light.xaml fades its glow -->
    <RadialGradientBrush x:Key="Logo.Mask">
        <GradientStop Color="Black" Offset="0" />
        <GradientStop Color="Black" Offset="1" />
    </RadialGradientBrush>
    <sys:Double x:Key="Field.HintOpacity">0.56</sys:Double>
    <!-- TitleBar.xaml has the colours for what's on the title strips -->
    <SolidColorBrush x:Key="Title.Bg"       Color="#121824" />
    <SolidColorBrush x:Key="Title.Edge"     Color="#263041" />
    <SolidColorBrush x:Key="Title.FieldText" Color="#ECF1F7" />
    <SolidColorBrush x:Key="Title.Field"    Color="#18202E" />

    <!-- links, ticks, switches, focus and picked rows. A lighter take on the buttons' blue so it reads on the dark -->
    <SolidColorBrush x:Key="Primary"        Color="#6A9BD8" />
    <!-- a picked row in a list, toned so the row's grey and blue text still reads on it -->
    <SolidColorBrush x:Key="Row.Selected"   Color="#182F50" />
    <!-- the nav pills and my own messages -->
    <SolidColorBrush x:Key="Primary.Muted"  Color="#24497A" />

    <SolidColorBrush x:Key="Accent.Gold"    Color="#C9A227" />

    <SolidColorBrush x:Key="Text.1"         Color="#ECF1F7" />
    <SolidColorBrush x:Key="Text.2"         Color="#A7B2C2" />
    <SolidColorBrush x:Key="Text.3"         Color="#929DAE" />
    <SolidColorBrush x:Key="Text.OnPrimary" Color="#0A0E14" />

    <SolidColorBrush x:Key="State.Online"   Color="#3FD07F" />
    <SolidColorBrush x:Key="State.Warn"     Color="#E6B13E" />
    <SolidColorBrush x:Key="State.Down"     Color="#FF5C64" />

    <SolidColorBrush x:Key="Badge.Neutral"     Color="#2A3A4A" />
    <SolidColorBrush x:Key="Badge.Alert"       Color="#5A2A2E" />
    <SolidColorBrush x:Key="Badge.Maintenance" Color="#4E4120" />
    <SolidColorBrush x:Key="Badge.Event"       Color="#1E3D66" />
    <SolidColorBrush x:Key="Badge.Update"      Color="#24452E" />

    <SolidColorBrush x:Key="Hover.Fill"     Color="#A7B2C2" Opacity="0.12" />
    <SolidColorBrush x:Key="Press.Fill"     Color="#A7B2C2" Opacity="0.22" />
    <SolidColorBrush x:Key="Focus.Ring"     Color="#8DB8EE" />

    <SolidColorBrush x:Key="Btn.Disabled.Fill" Color="#3A5A85" Opacity="0.35" />
    <SolidColorBrush x:Key="Btn.Disabled.Text" Color="#8994A6" />

    <SolidColorBrush x:Key="Tip.Bg"         Color="#222C3D" />
    <SolidColorBrush x:Key="Tip.Text"       Color="#ECF1F7" />
    <SolidColorBrush x:Key="Tip.Edge"       Color="White" Opacity="0.08" />

    <SolidColorBrush x:Key="Border.Hair"    Color="White" Opacity="0.08" />
    <!-- between panes that sit side by side or stacked, so they're not told apart by colour alone -->
    <SolidColorBrush x:Key="Border.Pane"    Color="#2B3547" />
    <!-- every window's edge. DWM draws it from 24H2 on, so it has to be solid -->
    <SolidColorBrush x:Key="Border.Window"  Color="#263041" />

    <DropShadowEffect x:Key="Shadow.Dialog" BlurRadius="18" ShadowDepth="4" Opacity="0.55" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Window" BlurRadius="30" ShadowDepth="8" Opacity="0.6" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Card"   BlurRadius="10" ShadowDepth="2" Opacity="0.4" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Panel"  BlurRadius="48" ShadowDepth="16" Opacity="0.6" Color="Black" />
    <DropShadowEffect x:Key="Shadow.Notice" BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />

    <!-- MaterialDesign pads a floating hint with its own background brush, which leaves a chip round the label on the
         dialogs. These hand it Surface.2, and live here so each theme has its own -->
    <Style x:Key="DialogTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
    <Style x:Key="DialogPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
    <Style x:Key="DialogRevealPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedRevealPasswordBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="{StaticResource Field.HintOpacity}" />
        <Style.Resources>
            <SolidColorBrush x:Key="MaterialDesign.Brush.Background" Color="{StaticResource Surface.2.Color}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>
