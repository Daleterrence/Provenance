<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviours="clr-namespace:Provenance.Wpf.Controls.Behaviours"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:conv="clr-namespace:Provenance.Wpf.Converters"
                    xmlns:hook="clr-namespace:Provenance.Common.Game.ThirdParty;assembly=Provenance.Common">
    <!-- Settings' profile cards, white text on these in both themes -->
    <SolidColorBrush x:Key="Platform.Windower" Color="#339933" />
    <SolidColorBrush x:Key="Platform.Ashita"   Color="#D45447" />

    <FontFamily x:Key="Font.Body">Segoe UI</FontFamily>

    <!-- cards, panels and popups, then the floating dialogs (Windows' own window corner). Buttons stay square -->
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="Radius.Dialog">8</CornerRadius>

    <!-- the bar along the bottom of a window, and the gap between the buttons on it -->
    <Style x:Key="FooterBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Surface.1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Pane}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
    </Style>
    <Thickness x:Key="Footer.Gap">8,0,0,0</Thickness>

    <!-- the line under a title bar. Last in the bar, so it draws over the buttons' hover -->
    <Style x:Key="TitleEdge" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Grid.ColumnSpan" Value="99" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Title.Edge}" />
    </Style>

    <!-- a splitter between two panes: a 1 px line on the side the panel's on, the rest shows the window behind -->
    <Style x:Key="PaneSplitter" TargetType="GridSplitter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Border Width="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Background="{DynamicResource Border.Pane}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- every right-click, dots and Play menu. The margin's room for the shadow, the popup's see-through -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Surface.2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Pane}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- the shadow's on its own Border, an effect on the text's one loses ClearType -->
                    <Grid Margin="0,0,8,8">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Effect="{DynamicResource Shadow.Card}" />
                        <Border x:Name="Panel" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource Border.Pane}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a column for the tick (or an icon) that only takes room when something in the menu has one -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="10,6,14,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuCheck" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGesture" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="CheckCol" Width="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <ContentPresenter x:Name="IconBox" ContentSource="Icon" Width="16" Height="16" />
                                <Path x:Name="Tick" Data="M2.5,8.5 L6.5,12.5 L13.5,4" Stroke="{DynamicResource Primary}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Hidden"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ContentPresenter x:Name="Head" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Margin="24,0,0,0" Text="{TemplateBinding InputGestureText}"
                                       Foreground="{DynamicResource Text.3}" VerticalAlignment="Center" />
                            <Path x:Name="Arrow" Grid.Column="3" Margin="12,0,-6,0" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource Text.2}"
                                  StrokeThickness="1.5" VerticalAlignment="Center" Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="2" VerticalOffset="-5" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Fade" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid Margin="0,0,8,8" Grid.IsSharedSizeScope="True">
                                    <Border Background="{DynamicResource Surface.2}" CornerRadius="4" Effect="{DynamicResource Shadow.Card}" />
                                    <Border Background="{DynamicResource Surface.2}" BorderBrush="{DynamicResource Border.Pane}"
                                            BorderThickness="1" CornerRadius="4" Padding="4" MinWidth="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Icon" Value="{x:Null}" />
                                <Condition Property="IsCheckable" Value="False" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="CheckCol" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Selected}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Selected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
                            <Setter TargetName="Head" Property="Opacity" Value="0.75" />
                            <Setter TargetName="Tick" Property="Opacity" Value="0.6" />
                            <Setter TargetName="Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <conv:LocalTimeConverter x:Key="LocalTimeConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:ArticleTimesConverter x:Key="ArticleTimesConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis" />
    <conv:InvertBoolConverter x:Key="InvertBool" />
    <conv:UpperCaseConverter x:Key="UpperCase" />

    <!-- State.IsError is the error flag, every window binds its own -->
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.2}" />
        <Style.Triggers>
            <Trigger Property="behaviours:State.IsError" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource State.Down}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DimStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
        <Setter Property="Foreground" Value="{DynamicResource Text.3}" />
    </Style>

    <!-- the profile a Settings page is changing, in its app's colour. Tag is the platform -->
    <Style x:Key="PlatformCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Panel}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{DynamicResource Surface.1}" />
        <Setter Property="TextElement.Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static hook:ThirdPartyHook.Windower}">
                <Setter Property="Background" Value="{DynamicResource Platform.Windower}" />
            </Trigger>
            <Trigger Property="Tag" Value="{x:Static hook:ThirdPartyHook.Ashita}">
                <Setter Property="Background" Value="{DynamicResource Platform.Ashita}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- the default wide grey scrollbar with arrows looks awful on the dark theme -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
        <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="3" />
    </Style>

    <!-- keys of their own, so a tooltip on a title bar doesn't take the bar's light text -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource MaterialDesignToolTip}">
        <Setter Property="Background" Value="{DynamicResource Tip.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Tip.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Tip.Edge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Body}" />
    </Style>

    <!-- read-only text you can still select and copy -->
    <Style x:Key="SelectableText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Text.1}" />
        <Setter Property="CaretBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Primary}" />
    </Style>

    <Style x:Key="Spinner" TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Value" Value="0" />
    </Style>

    <!-- the strip across the top of a pane -->
    <Style x:Key="PaneHeader" TargetType="Border">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource Border.Pane}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Background" Value="{DynamicResource Surface.1}" />
    </Style>

    <!-- the pill with a count in it, and the white one that sits on a button -->
    <Style x:Key="CountBadge" TargetType="Border">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource Primary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CountBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text.OnPrimary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ButtonBadge" TargetType="Border" BasedOn="{StaticResource CountBadge}">
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource Btn.Rim}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="ButtonBadgeText" TargetType="TextBlock" BasedOn="{StaticResource CountBadgeText}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Foreground" Value="{DynamicResource Btn.Rim}" />
    </Style>

    <!-- the ring round whatever has keyboard focus (and only for the keyboard), one per shape -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle RadiusX="6" RadiusY="6" StrokeThickness="2" Stroke="{DynamicResource Primary}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingPill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2,-2,6,4" RadiusX="18" RadiusY="18" StrokeThickness="2" Stroke="{DynamicResource Primary}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusRingRound">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="41" RadiusY="41" StrokeThickness="2" Stroke="{DynamicResource Primary}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a world's dot. State.Status is its status, and one we don't know is grey on the chip and in the list -->
    <Style x:Key="WorldDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Text.3}" />
        <Style.Triggers>
            <Trigger Property="behaviours:State.Status" Value="up">
                <Setter Property="Fill" Value="{DynamicResource State.Online}" />
            </Trigger>
            <Trigger Property="behaviours:State.Status" Value="maintenance">
                <Setter Property="Fill" Value="{DynamicResource Accent.Gold}" />
            </Trigger>
            <Trigger Property="behaviours:State.Status" Value="partial-maintenance">
                <Setter Property="Fill" Value="{DynamicResource Accent.Gold}" />
            </Trigger>
            <Trigger Property="behaviours:State.Status" Value="down">
                <Setter Property="Fill" Value="{DynamicResource State.Down}" />
            </Trigger>
            <Trigger Property="behaviours:State.Status" Value="partially-down">
                <Setter Property="Fill" Value="{DynamicResource State.Down}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
