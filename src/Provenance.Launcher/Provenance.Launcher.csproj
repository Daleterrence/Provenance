<Project Sdk="Microsoft.NET.Sdk">

  <!-- Velopack's main exe. The shortcuts and the install hooks start this without admin, and it starts Provenance.exe,
       which asks for admin itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Provenance.Launcher</RootNamespace>
    <AssemblyName>ProvenanceLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(ProvenanceAssetsDir)\app\provenance.ico</ApplicationIcon>
    <Product>Provenance</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- same version as vpk, tools/pack-release.ps1 checks -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
