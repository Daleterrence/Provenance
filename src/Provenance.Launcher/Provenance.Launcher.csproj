<Project Sdk="Microsoft.NET.Sdk">

  <!-- Velopack's main exe. The shortcuts and the install hooks start this without admin, and it starts Provenance.exe,
       which asks for admin itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Provenance.Launcher</RootNamespace>
    <AssemblyName>ProvenanceLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>$(ProvenanceAssetsDir)\app\provenance.ico</ApplicationIcon>
    <Product>Provenance</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
