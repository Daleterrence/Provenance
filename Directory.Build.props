<Project>
  <!-- SemVer 2, bumped and committed before each release (tools/pack-release.ps1 refuses any other -Version). The
       exe's file version keeps just the numbers (1.0.0.0) -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>beta.5</VersionSuffix>
  </PropertyGroup>

  <!-- polcore.dll and FFXi.dll are 32-bit in-process COM servers, a 64-bit host only gets a flaky DCOM surrogate. The
       RID gets the exes a 32-bit apphost, a library blanks it -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup>
    <ProvenanceGlobalConfig>$(MSBuildThisFileDirectory)Provenance.globalconfig</ProvenanceGlobalConfig>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(ProvenanceGlobalConfig)" />
  </ItemGroup>
  <!-- without it everything still builds, just with none of the C# rules checked -->
  <Target Name="RequireStyleRules" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(ProvenanceGlobalConfig)')" Text="$(ProvenanceGlobalConfig) is missing, so none of the C# rules would be checked." />
  </Target>

  <!-- the images aren't in this repo. They come from PROVENANCE_ASSETS as given, or the assets folder with the icon in it next
       to the repo or one folder up -->
  <PropertyGroup>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == ''">$(PROVENANCE_ASSETS)</ProvenanceAssetsDir>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\assets\app\provenance.ico')">$(MSBuildThisFileDirectory)..\assets</ProvenanceAssetsDir>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\assets\app\provenance.ico')">$(MSBuildThisFileDirectory)..\..\assets</ProvenanceAssetsDir>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' != ''">$([System.IO.Path]::GetFullPath('$(ProvenanceAssetsDir)'))</ProvenanceAssetsDir>
  </PropertyGroup>

  <!-- the SDK tacks the full 40-character commit onto the product version, 7 is plenty to find it again -->
  <Target Name="ShortSourceRevision" BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="$(SourceRevisionId.Length) &gt; 7">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
