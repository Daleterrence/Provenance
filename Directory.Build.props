<Project>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>pb.2.1</VersionSuffix>
  </PropertyGroup>

  <!-- polcore.dll and FFXi.dll are 32-bit in-process COM servers, a 64-bit host only gets a flaky DCOM surrogate -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup>
    <ProvenanceGlobalConfig>$(MSBuildThisFileDirectory)Provenance.globalconfig</ProvenanceGlobalConfig>
  </PropertyGroup>
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(ProvenanceGlobalConfig)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ProvenanceCI)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <EnableHouseRules Condition="'$(EnableHouseRules)' == ''">true</EnableHouseRules>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableHouseRules)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>
  <Target Name="RequireStyleRules" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(ProvenanceGlobalConfig)')" Text="$(ProvenanceGlobalConfig) is missing, so none of the C# rules would be checked." />
  </Target>

  <PropertyGroup>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == ''">$(PROVENANCE_ASSETS)</ProvenanceAssetsDir>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\assets\app\provenance.ico')">$(MSBuildThisFileDirectory)..\assets</ProvenanceAssetsDir>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\assets\app\provenance.ico')">$(MSBuildThisFileDirectory)..\..\assets</ProvenanceAssetsDir>
    <!-- where tools\get-assets.ps1 puts them -->
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' == '' and Exists('$(MSBuildThisFileDirectory)assets\app\provenance.ico')">$(MSBuildThisFileDirectory)assets</ProvenanceAssetsDir>
    <ProvenanceAssetsPin>$(MSBuildThisFileDirectory)tools\assets.json</ProvenanceAssetsPin>
    <ProvenanceAssetsDir Condition="'$(ProvenanceAssetsDir)' != ''">$([System.IO.Path]::GetFullPath('$(ProvenanceAssetsDir)'))</ProvenanceAssetsDir>
  </PropertyGroup>

  <Target Name="ShortSourceRevision" BeforeTargets="AddSourceRevisionToInformationalVersion"
          Condition="$(SourceRevisionId.Length) &gt; 7">
    <PropertyGroup>
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>
</Project>
